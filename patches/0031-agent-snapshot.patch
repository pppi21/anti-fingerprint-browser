+blink::mojom::AgentOffscreenMode AgentOffscreenModeFromString(
+    const std::optional<std::string>& mode) {
+  if (mode == Page::CaptureAgentSnapshot::OffscreenModeEnum::None) {
+    return blink::mojom::AgentOffscreenMode::kNone;
+  }
+  if (mode == Page::CaptureAgentSnapshot::OffscreenModeEnum::Full) {
+    return blink::mojom::AgentOffscreenMode::kFull;
+  }
+  return blink::mojom::AgentOffscreenMode::kSummary;
+}
