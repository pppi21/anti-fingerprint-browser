+          "Ampere": ["0x97000000"],
+          "Volta": ["0xa5000000"]
+        }
+      }]
+    },
+
+    "QualcommPCI": {
+      "name_override": "Qualcomm",
+      "id": "0x5143",
+
+      "devices": [{
+        "mask": "0xFF000000",
+        "architecture": {
