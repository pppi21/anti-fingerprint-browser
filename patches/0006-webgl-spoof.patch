 #include "third_party/blink/renderer/modules/webgl/webgl_uniform_location.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_vertex_array_object.h"
@@ -169,7 +171,6 @@
 #include "third_party/skia/include/gpu/ganesh/GrTypes.h"
 #include "ui/gfx/geometry/size.h"
 
-
 // Populates parameters from texImage2D except for border, width, height, and
 // depth (which are not present for all texImage2D functions).
 #define POPULATE_TEX_IMAGE_2D_PARAMS(params, src_type) \
@@ -4087,8 +4088,17 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return GetIntParameter(script_state, pname);
     case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
       return GetIntParameter(script_state, pname);
-    case GL_MAX_VERTEX_UNIFORM_VECTORS:
-      return GetIntParameter(script_state, pname);
+    case GL_MAX_VERTEX_UNIFORM_VECTORS: {
+      // browser: issue the underlying GetIntegerv IPC even when spoofing so
+      // the per-call timing matches stock chromium; fingerprint scripts that
+      // time getParameter() must not see a fast-path on spoofed builds.
+      ScriptValue real = GetIntParameter(script_state, pname);
+      const int spoofed_vectors = browser::SpoofedMaxVertexUniformVectors();
+      if (spoofed_vectors != 0) {
+        return WebGLAny(script_state, spoofed_vectors);
+      }
+      return real;
+    }
     case GL_MAX_VIEWPORT_DIMS:
       return GetWebGLIntArrayParameter(script_state, pname);
     case GL_PACK_ALIGNMENT:
@@ -4200,8 +4210,14 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case WebGLDebugRendererInfo::kUnmaskedRendererWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
-        return WebGLAny(script_state,
-                        String(ContextGL()->GetString(GL_RENDERER)));
+        // browser: always perform the underlying GetString IPC so per-call
+        // timing matches stock even when a spoof switch is active.
+        String real = String(ContextGL()->GetString(GL_RENDERER));
+        const std::string& spoof = browser::SpoofedGpuRenderer();
+        if (!spoof.empty()) {
+          return WebGLAny(script_state, String(spoof));
+        }
+        return WebGLAny(script_state, real);
       }
       SynthesizeGLError(
           GL_INVALID_ENUM, "getParameter",
@@ -4209,8 +4225,14 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case WebGLDebugRendererInfo::kUnmaskedVendorWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
-        return WebGLAny(script_state,
-                        String(ContextGL()->GetString(GL_VENDOR)));
+        // browser: always perform the underlying GetString IPC so per-call
+        // timing matches stock even when a spoof switch is active.
+        String real = String(ContextGL()->GetString(GL_VENDOR));
+        const std::string& spoof = browser::SpoofedGpuVendor();
+        if (!spoof.empty()) {
+          return WebGLAny(script_state, String(spoof));
+        }
+        return WebGLAny(script_state, real);
       }
       SynthesizeGLError(
           GL_INVALID_ENUM, "getParameter",
@@ -5466,6 +5488,13 @@ void WebGLRenderingContextBase::shaderSource(WebGLShader* shader,
     return;
   String ascii_string = ReplaceNonASCII(string).Result();
   shader->SetSource(string);
+  // browser: per-profile fragment shader source rewriting for WebGL
+  // pixel-data variance spoofing. Operates on the GPU-bound copy only -
+  // shader->Source() (returned by gl.getShaderSource()) keeps the original
+  // unmodified source.
+  if (shader->GetType() == GL_FRAGMENT_SHADER) {
+    ascii_string = RewriteFragmentShaderForNoise(ascii_string);
+  }
   DCHECK(ascii_string.Is8Bit() && ascii_string.ContainsOnlyAsciiOrEmpty());
   const GLchar* shader_data = base::as_chars(ascii_string.Span8()).data();
   const GLint shader_length = ascii_string.length();
