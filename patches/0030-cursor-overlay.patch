+
+#ifndef CONTENT_BROWSER_DEVTOOLS_CDP_CURSOR_OVERLAY_H_
+#define CONTENT_BROWSER_DEVTOOLS_CDP_CURSOR_OVERLAY_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "components/input/render_widget_host_input_event_router.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/aura/window_observer.h"
+#include "ui/compositor/layer_delegate.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace aura {
+class Window;
+}
+
+namespace ui {
+class Layer;
+}
+
+namespace content {
+
+class RenderWidgetHostImpl;
+
+// Draws a visible cursor on a ui::Layer above the page while --show-cdp-cursor
+// is set, so an observer can follow synthetic input. Mouse positions come
+// from the RenderWidgetHostInputEventRouter (dispatchMousePath, including
+// events routed into OOPIFs) and from InputHandler directly for the
+// dispatchMouseEvent path, which bypasses the router.
+class CdpCursorOverlay
+    : public aura::WindowObserver,
+      public input::RenderWidgetHostInputEventRouter::MouseEventRouteObserver {
+ public:
+  CdpCursorOverlay();
+  ~CdpCursorOverlay() override;
+
+  CdpCursorOverlay(const CdpCursorOverlay&) = delete;
+  CdpCursorOverlay& operator=(const CdpCursorOverlay&) = delete;
+
+  void AttachToHost(RenderWidgetHostImpl* widget_host);
+  void Detach();
+
+  // For events that bypass the router.
+  void UpdatePosition(float dip_x, float dip_y, bool is_click);
+
+  // Draws the cursor onto a screencast frame. The scale factors convert the
+  // DIP cursor position to bitmap pixels.
+  void CompositeCursorOnto(SkBitmap& bitmap, float scale_x, float scale_y);
+
+  // input::RenderWidgetHostInputEventRouter::MouseEventRouteObserver:
+  void OnMouseEventRouted(const blink::WebMouseEvent& event) override;
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  class CursorLayerDelegate;
+  class ClickLayerDelegate;
+
+  void MoveCursorTo(float dip_x, float dip_y);
+  void PaintCursor(const ui::PaintContext& context);
+  void PaintClickRipple(const ui::PaintContext& context);
+  void StartClickAnimation();
+  void OnClickAnimationEnd();
+
+  std::unique_ptr<CursorLayerDelegate> cursor_delegate_;
+  std::unique_ptr<ClickLayerDelegate> click_delegate_;
+  std::unique_ptr<ui::Layer> cursor_layer_;
+  std::unique_ptr<ui::Layer> click_layer_;
+  base::OneShotTimer click_timer_;
+
+  raw_ptr<input::RenderWidgetHostInputEventRouter> router_ = nullptr;
+  raw_ptr<aura::Window> attached_window_ = nullptr;
+
+  gfx::PointF current_pos_;
+  bool is_clicking_ = false;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_CDP_CURSOR_OVERLAY_H_
