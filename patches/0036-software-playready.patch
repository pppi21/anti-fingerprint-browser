     EmeMediaType media_type,
@@ -106,6 +114,25 @@ EmeConfig::Rule PlayReadyKeySystemInfo::GetRobustnessConfigRule(
     return EmeConfig{.hw_secure_codecs = EmeConfigRuleState::kRequired};
   }
 
+  // browser: with the recommendation key system, an unspecified robustness
+  // or "2000" selects the software secure (SL2000) OS CDM when this document
+  // can see it. Without software codecs the answer is the same as stock
+  // Chrome: unsupported.
+  if (key_system == kPlayReadyKeySystemRecommendationDefault &&
+      codecs_ != media::EME_CODEC_NONE &&
+      (requested_robustness.empty() || requested_robustness == "2000")) {
+    if (hw_secure_requirement && *hw_secure_requirement) {
+      // Another capability already committed this configuration to hardware
+      // secure codecs. An unspecified robustness is compatible with that; an
+      // explicit "2000" is not.
+      if (requested_robustness.empty()) {
+        return EmeConfig{.hw_secure_codecs = EmeConfigRuleState::kRequired};
+      }
+      return EmeConfig::UnsupportedRule();
+    }
+    return EmeConfig{.hw_secure_codecs = EmeConfigRuleState::kNotAllowed};
