+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+
+namespace browser {
+namespace {
+
+constexpr char kMainHtml[] = R"HTML(<!doctype html>
+<html dir="ltr" lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Anti-Fingerprint Settings</title>
+  <base href="chrome://browser-settings/">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults.css">
+  <link rel="stylesheet" href="seed.css">
+  <script type="module" src="seed.js"></script>
+</head>
+<body>
+  <div id="outer">
+    <h1>Anti-Fingerprint settings</h1>
+    <section>
+      <h2>Fingerprint seed</h2>
+      <p class="desc">
+        Sets the fingerprint identity applied on every launch, no matter how the
+        browser is opened (a clicked link, a shortcut, or as your default
+        browser). Changes take effect the next time you start the browser.
+      </p>
+      <div class="option">
+        <label><input type="radio" name="mode" value="off">
+          <b>Off</b> &mdash; no spoofing (standard Chromium fingerprint)</label>
+      </div>
+      <div class="option">
+        <label><input type="radio" name="mode" value="auto">
+          <b>Auto</b> &mdash; a fresh random identity each launch</label>
+      </div>
+      <div class="option">
+        <label><input type="radio" name="mode" value="seed">
+          <b>Fixed seed</b> &mdash; a stable identity from a number you choose</label>
+        <input type="number" id="seedValue" min="0" step="1"
+               placeholder="e.g. 12345" disabled>
+      </div>
+      <div class="actions">
+        <button id="save">Save</button>
+        <span id="status" role="status" aria-live="polite"></span>
+      </div>
+    </section>
+  </div>
+</body>
+</html>
+)HTML";
+
+constexpr char kMainCss[] = R"CSS(
+html {
+  --google-grey-200-rgb: 232, 234, 237;
+  --google-grey-200: rgb(var(--google-grey-200-rgb));
+  --google-grey-700: rgb(95, 99, 104);
+  --google-grey-900-rgb: 32, 33, 36;
+  --google-grey-900: rgb(var(--google-grey-900-rgb));
+  --google-blue-300: rgb(138, 180, 248);
+  --google-blue-600: rgb(26, 115, 232);
+  --primary-color: var(--google-grey-900);
+  --secondary-color: var(--google-grey-700);
+  --accent-color: var(--google-blue-600);
+  --background-color: white;
+  background: var(--background-color);
+}
+@media (prefers-color-scheme: dark) {
+  html {
+    --primary-color: var(--google-grey-200);
+    --secondary-color: rgba(var(--google-grey-200-rgb), .7);
+    --accent-color: var(--google-blue-300);
+    --background-color: var(--google-grey-900);
+    background: var(--background-color);
+  }
+}
+body { color: var(--primary-color); font-size: 100%; margin: 0; }
+#outer {
+  margin-inline: auto;
+  margin-top: 16px;
+  min-width: 480px;
+  width: 60%;
+  max-width: 760px;
+}
+h1 { font-size: 1.5em; font-weight: 500; }
+h2 { font-size: 1.1em; font-weight: 500; margin-top: 1.5em; }
+.desc { color: var(--secondary-color); font-size: .9em; max-width: 62ch; }
+.option { margin: .55em 0; }
+.option label { cursor: pointer; }
+#seedValue {
+  color: var(--primary-color);
+  background: transparent;
+  border: 1px solid var(--secondary-color);
+  border-radius: 4px;
+  display: block;
+  font: inherit;
+  margin-top: .35em;
+  margin-inline-start: 1.9em;
+  padding: 4px 6px;
+}
+#seedValue:disabled { opacity: .45; }
+.actions { align-items: center; display: flex; gap: 12px; margin-top: 1.6em; }
+button {
+  background: var(--accent-color);
+  border: none;
+  border-radius: 4px;
+  color: white;
+  cursor: pointer;
+  font: inherit;
+  font-weight: 500;
+  padding: 8px 18px;
+}
+button:hover { filter: brightness(1.05); }
+#status { color: var(--secondary-color); font-size: .9em; }
+)CSS";
+
+constexpr char kMainJs[] = R"JS(
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+const modeRadios = () =>
+    Array.from(document.querySelectorAll('input[name="mode"]'));
+const seedInput = document.getElementById('seedValue');
+const statusEl = document.getElementById('status');
+
+function selectedMode() {
+  const sel = modeRadios().find(r => r.checked);
+  return sel ? sel.value : 'off';
+}
+
+function applyMode(mode) {
+  for (const r of modeRadios()) {
+    r.checked = (r.value === mode);
+  }
+  seedInput.disabled = (mode !== 'seed');
+}
+
+function render(seed) {
+  if (seed === 'auto') {
+    applyMode('auto');
+    seedInput.value = '';
+  } else if (seed && /^[0-9]+$/.test(seed)) {
+    applyMode('seed');
+    seedInput.value = seed;
+  } else {
+    applyMode('off');
+    seedInput.value = '';
+  }
+  statusEl.textContent = '';
+}
+
+for (const r of modeRadios()) {
+  r.addEventListener('change', () => {
+    seedInput.disabled = (selectedMode() !== 'seed');
+    statusEl.textContent = '';
+  });
+}
+
+document.getElementById('save').addEventListener('click', async () => {
+  const mode = selectedMode();
+  let value = '';
+  if (mode === 'auto') {
+    value = 'auto';
+  } else if (mode === 'seed') {
+    value = seedInput.value.trim();
+  }
+  const saved = await sendWithPromise('setSeed', value);
+  render(saved);
+  statusEl.textContent = 'Saved. Restart the browser to apply.';
+});
+
+sendWithPromise('getSeed').then(render);
+)JS";
+
+bool ShouldHandleRequest(const std::string& path) {
+  return path.empty() || path == "seed.css" || path == "seed.js";
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  std::string_view body = kMainHtml;
+  if (path == "seed.css") {
+    body = kMainCss;
+  } else if (path == "seed.js") {
+    body = kMainJs;
+  }
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::string(body)));
+}
+
+class BrowserSettingsHandler : public content::WebUIMessageHandler {
+ public:
+  BrowserSettingsHandler() = default;
+  BrowserSettingsHandler(const BrowserSettingsHandler&) = delete;
+  BrowserSettingsHandler& operator=(const BrowserSettingsHandler&) = delete;
+  ~BrowserSettingsHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getSeed", base::BindRepeating(&BrowserSettingsHandler::HandleGetSeed,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "setSeed", base::BindRepeating(&BrowserSettingsHandler::HandleSetSeed,
+                                       base::Unretained(this)));
+  }
+
+ private:
+  void HandleGetSeed(const base::ListValue& args) {
+    AllowJavascript();
+    ResolveJavascriptCallback(
+        args[0], base::Value(g_browser_process->local_state()->GetString(
+                     prefs::kFingerprintSeed)));
+  }
+
+  void HandleSetSeed(const base::ListValue& args) {
+    AllowJavascript();
+    const std::string& requested = args[1].GetString();
+    // Normalize to "auto", a non-negative base-10 integer, or "" (off).
+    std::string normalized;
+    if (requested == "auto") {
+      normalized = "auto";
+    } else if (!requested.empty()) {
+      int64_t parsed = 0;
+      if (base::StringToInt64(requested, &parsed) && parsed >= 0) {
+        normalized = base::NumberToString(parsed);
+      }
+    }
+    g_browser_process->local_state()->SetString(prefs::kFingerprintSeed,
+                                                normalized);
+    ResolveJavascriptCallback(args[0], base::Value(normalized));
+  }
+};
+
+}  // namespace
+
+BrowserSettingsUI::BrowserSettingsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kChromeUIBrowserSettingsHost);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src chrome://resources 'self';");
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+  web_ui->AddMessageHandler(std::make_unique<BrowserSettingsHandler>());
+}
+
+BrowserSettingsUI::~BrowserSettingsUI() = default;
+
+}  // namespace browser
