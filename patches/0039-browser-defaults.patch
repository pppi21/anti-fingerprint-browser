+namespace {
+
+// browser: chrome://browser-settings stores the fingerprint seed in Local
+// State. It is applied here, before anything reads the command line, so it
+// works however the browser was started. The pref service does not exist
+// this early, so the file is read directly. An explicit --fingerprint-seed
+// wins.
+void ApplyPersistedFingerprintSeed(base::CommandLine* command_line) {
+  if (command_line->HasSwitch(switches::kFingerprintSeed)) {
+    return;
+  }
+  base::FilePath user_data_dir =
+      command_line->GetSwitchValuePath(switches::kUserDataDir)
+          .StripTrailingSeparators();
+  if (user_data_dir.empty()) {
+    chrome::GetDefaultUserDataDirectory(&user_data_dir);
+  }
+  std::string json;
+  if (user_data_dir.empty() ||
+      !base::ReadFileToString(user_data_dir.Append(chrome::kLocalStateFilename),
+                              &json)) {
+    return;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  const base::DictValue* dict = parsed ? parsed->GetIfDict() : nullptr;
+  const std::string* seed =
+      dict ? dict->FindStringByDottedPath(browser::prefs::kFingerprintSeed)
+           : nullptr;
+  if (seed && !seed->empty()) {
+    command_line->AppendSwitchASCII(switches::kFingerprintSeed, *seed);
+  }
+}
+
+// browser: child processes receive --fingerprint-seed verbatim, and a value
+// such as "auto" would make each of them draw its own random seed, giving
+// every site its own identity under site isolation. Resolving the seed once
+// in the browser process and writing the integer back gives every process
+// the same identity for the session. Runs after the persisted seed is
+// applied so a persisted "auto" is pinned too.
+void PinFingerprintSeed(base::CommandLine* command_line) {
+  if (!command_line->HasSwitch(switches::kFingerprintSeed)) {
+    return;
+  }
+  int seed = 0;
+  if (!base::StringToInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintSeed),
+          &seed)) {
+    command_line->AppendSwitchASCII(
+        switches::kFingerprintSeed,
+        base::NumberToString(browser::MasterSeed()));
+  }
+}
+
+}  // namespace
+
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+  // browser: expand the browser-defaults preset (opt out with
+  // --use-chromium-defaults) before anything reads the command line, then
+  // settle the fingerprint seed. Both are browser-process only.
+  browser::MaybeExpandBrowserDefaults();
+  base::CommandLine* startup_command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!startup_command_line->HasSwitch(switches::kProcessType)) {
+    ApplyPersistedFingerprintSeed(startup_command_line);
+    PinFingerprintSeed(startup_command_line);
+  }
+
