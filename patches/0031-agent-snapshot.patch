index 0000000000..85234024b0
--- /dev/null
+++ b/third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom
@@ -0,0 +1,93 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Per-frame interactive-element collection for Page.captureAgentSnapshot.
+//
+// Implemented in the renderer and bound per local root frame. The browser
+// calls it once per local root (main frame and every OOPIF) while assembling
+// one snapshot. Each frame reports its elements in its own local CSS-pixel
+// space, as getBoundingClientRect() would; the browser composes those boxes
+// into the root viewport and runs the cross-context occlusion test.
+
+module blink.mojom;
+
+// How elements outside the frame's own layout viewport are reported.
+enum AgentOffscreenMode {
+  kNone,     // drop off-viewport elements
+  kSummary,  // include, but the caller may cap the count
+  kFull,     // include all
+};
+
+struct AgentSnapshotOptions {
+  AgentOffscreenMode offscreen_mode = kSummary;
+};
+
+// Border-box in the frame's LOCAL CSS-pixel space, viewport-relative
+// (i.e. matching Element.getBoundingClientRect()).
+struct AgentElementBox {
+  double x;
+  double y;
+  double width;
+  double height;
+};
+
+struct AgentElement {
+  // DevTools backend node id (== Blink DOMNodeId), stable and browser-visible.
+  int32 backend_node_id;
+
+  // Computed accessibility role, or a tag-derived role when no ARIA role.
+  string role;
+  // Accessible name, current value and accessible description; empty when
+  // absent.
+  string name;
+  string value;
+  string description;
+  // Lowercased tag name (e.g. "div", "button", "input").
+  string tag;
+
+  // Whether the element is classified interactive/actionable.
+  bool interactive;
+  // Why: "role" | "form-control" | "listener" | "cursor" | "tabindex"
+  // (empty when not interactive).
+  string interactive_reason;
+
+  // Active state flags: visible, enabled, focusable, focused, editable,
+  // checked, expanded, selected, disabled, readonly, required.
+  array<string> states;
+
+  // Local (frame) CSS-pixel border-box.
+  AgentElementBox box;
+  // Whether the box intersects this frame's own layout viewport.
+  bool in_frame_viewport;
+
+  // Backend node id of the shadow host when this element lives inside a
+  // shadow tree (open or closed), else 0.
+  int32 shadow_host_backend_node_id;
+
+  // Where this element points, resolved against the document base URL. An
+  // agent cannot learn a link's destination from its accessible name, and
+  // clicking to find out follows redirects and destroys the page state it
+  // was inspecting. Empty when the element has no such attribute.
+  // href: <a>, <area>, <link>. src: <img>, <iframe>, <video>, <audio>,
+  // <source>, <embed>, <script>.
+  string href;
+  string src;
+};
+
+struct AgentFrameSnapshot {
+  array<AgentElement> elements;
+};
+
+interface AgentSnapshotCollector {
+  // Gathers the interactive elements of this local root and of its
+  // same-process descendant frames, open and closed shadow DOM included.
+  // Remote (OOPIF) children are left to their own call.
+  CollectFrameElements(AgentSnapshotOptions options)
+      => (AgentFrameSnapshot result);
+
+  // Resolves a process-local DOMNodeId (as returned in
+  // AgentElement.backend_node_id) to the element's current local-root-space
+  // box. found is false when the node is gone or is not a laid-out element.
+  ResolveNode(int32 local_dom_node_id) => (bool found, AgentElementBox box);
+};
