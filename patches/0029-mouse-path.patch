@@ -120,6 +120,17 @@ class COMPONENT_EXPORT(INPUT) RenderWidgetHostInputEventRouter final
     virtual void CancelAutoscroll(RenderWidgetHostViewInput* view) = 0;
   };
 
+  // browser: notified of every routed mouse event in root-view coordinates,
+  // before the event is transformed to target-frame coordinates.
+  class COMPONENT_EXPORT(INPUT) MouseEventRouteObserver {
+   public:
+    virtual ~MouseEventRouteObserver() = default;
+    virtual void OnMouseEventRouted(const blink::WebMouseEvent& event) = 0;
+  };
+
+  void AddMouseEventRouteObserver(MouseEventRouteObserver* observer);
+  void RemoveMouseEventRouteObserver(MouseEventRouteObserver* observer);
+
   explicit RenderWidgetHostInputEventRouter(viz::HitTestDataProvider* provider,
                                             Delegate* delegate);
 
@@ -544,6 +555,9 @@ class COMPONENT_EXPORT(INPUT) RenderWidgetHostInputEventRouter final
   // impact performance due to the IPC overhead.
   bool ended_delegated_ink_trail_ = false;
 
+  // browser: see MouseEventRouteObserver.
+  std::vector<raw_ptr<MouseEventRouteObserver>> mouse_event_route_observers_;
+
   base::WeakPtrFactory<RenderWidgetHostInputEventRouter> weak_ptr_factory_{
       this};
   friend class content::RenderWidgetHostInputEventRouterTest;
