+// browser: the spoofed navigator.connection values, mapped once from the
+// shared override (components/browser/connection_override.h) to the V8
+// enums and cached so the getters cost a field read, as in stock.
+struct ConnectionOverride {
+  V8ConnectionType::Enum connection_type;
+  V8EffectiveConnectionType::Enum effective_type;
+  double downlink_mbps;
+  uint32_t rtt_ms;
+  bool save_data;
+};
+
+struct EffectiveTypeName {
+  std::string_view name;
+  V8EffectiveConnectionType::Enum type;
+};
+constexpr EffectiveTypeName kEffectiveTypeNames[] = {
+    {"slow-2g", V8EffectiveConnectionType::Enum::kSlow2G},
+    {"2g", V8EffectiveConnectionType::Enum::k2G},
+    {"3g", V8EffectiveConnectionType::Enum::k3G},
+    {"4g", V8EffectiveConnectionType::Enum::k4G},
+};
+
+struct ConnectionTypeName {
+  std::string_view name;
+  V8ConnectionType::Enum type;
+};
+constexpr ConnectionTypeName kConnectionTypeNames[] = {
+    {"wifi", V8ConnectionType::Enum::kWifi},
+    {"ethernet", V8ConnectionType::Enum::kEthernet},
+    {"cellular", V8ConnectionType::Enum::kCellular},
+    {"bluetooth", V8ConnectionType::Enum::kBluetooth},
+    {"wimax", V8ConnectionType::Enum::kWimax},
+    {"none", V8ConnectionType::Enum::kNone},
+};
+
+const std::optional<ConnectionOverride>& CachedConnectionOverride() {
+  static const std::optional<ConnectionOverride> spoof =
+      []() -> std::optional<ConnectionOverride> {
+    const browser::ConnectionOverride& raw = browser::GetConnectionOverride();
+    if (!raw.active) {
+      return std::nullopt;
+    }
+    ConnectionOverride result;
+    result.effective_type = V8EffectiveConnectionType::Enum::k4G;
+    for (const EffectiveTypeName& entry : kEffectiveTypeNames) {
+      if (raw.effective_type == entry.name) {
+        result.effective_type = entry.type;
+      }
+    }
+    result.connection_type = V8ConnectionType::Enum::kUnknown;
+    for (const ConnectionTypeName& entry : kConnectionTypeNames) {
+      if (raw.connection_type == entry.name) {
+        result.connection_type = entry.type;
+      }
+    }
+    result.downlink_mbps = raw.downlink_mbps;
+    result.rtt_ms = raw.rtt_ms;
+    result.save_data = raw.save_data;
+    return result;
+  }();
+  return spoof;
+}
+
 }  // namespace
 
