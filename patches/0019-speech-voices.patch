 #include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/platform.h"
@@ -82,12 +85,25 @@ SpeechSynthesis::SpeechSynthesis(LocalDOMWindow& window)
       receiver_(this, &window),
       mojom_synthesis_(&window) {}
 
+// browser
+void SpeechSynthesis::AppendVoices(
+    base::span<const browser::DefaultVoiceEntry> entries) {
+  for (const browser::DefaultVoiceEntry& entry : entries) {
+    voice_list_.push_back(MakeGarbageCollected<SpeechSynthesisVoice>(
+        mojom::blink::SpeechSynthesisVoice::New(
+            String::FromUtf8(entry.name), String::FromUtf8(entry.name),
+            String(entry.lang), entry.is_local, entry.is_default)));
+  }
+}
+
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
   voice_list_.clear();
-  for (auto& mojom_voice : mojom_voices) {
-    voice_list_.push_back(
-        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
+  // browser: the real voices are replaced by the fixed list, plus the Google
+  // network voices while the brand spoof is active.
+  AppendVoices(browser::DefaultLocalVoices());
+  if (browser::BrandSpoofActive()) {
+    AppendVoices(browser::GoogleRemoteVoices());
   }
   VoicesDidChange();
 }
@@ -239,8 +255,34 @@ void SpeechSynthesis::StartSpeakingImmediately() {
   utterance->SetStartTime(millis / 1000.0);
   is_paused_ = false;
 
-  if (TryEnsureMojomSynthesis())
-    utterance->Start(this);
+  // browser: every listed voice is synthetic, so no utterance reaches a real
+  // engine. Start and end events are simulated, the end after a duration
+  // estimated from the text length.
+  DidStartSpeaking(utterance);
+
+  float rate = static_cast<float>(utterance->rate());
+  if (rate <= 0.0f) {
+    rate = 1.0f;
+  }
+  const float duration_seconds =
+      static_cast<float>(utterance->text().length()) /
+      (browser::kFakeSpeechCharsPerSecond * rate);
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+      ->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](WeakPersistent<SpeechSynthesis> weak_self,
+                 Persistent<SpeechSynthesisUtterance> utterance) {
+                if (weak_self &&
+                    weak_self->CurrentSpeechUtterance() == utterance.Get()) {
+                  weak_self->DidFinishSpeaking(
+                      utterance.Get(),
+                      mojom::blink::SpeechSynthesisErrorCode::kNoError);
+                }
+              },
+              WrapWeakPersistent(this), WrapPersistent(utterance)),
+          base::Seconds(duration_seconds));
 }
 
 void SpeechSynthesis::HandleSpeakingCompleted(
