+// Serves Page.captureAgentSnapshot's per-frame interactive-element
+// collection. Bound once per local root frame (the main frame and every
+// OOPIF); the browser drives one CollectFrameElements() call per local root
+// and composes the returned local-space boxes itself.
+//
+// Lives in modules/ rather than core/inspector because collecting
+// accessibility roles and names needs modules/accessibility.
+class AgentSnapshotCollectorImpl final
+    : public GarbageCollected<AgentSnapshotCollectorImpl>,
+      public mojom::blink::AgentSnapshotCollector,
+      public Supplement<Document> {
+ public:
+  static const char kSupplementName[];
+  static AgentSnapshotCollectorImpl* From(Document&);
+  static void BindReceiver(
+      LocalFrame* frame,
+      mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver);
+
+  explicit AgentSnapshotCollectorImpl(base::PassKey<AgentSnapshotCollectorImpl>,
+                                      LocalFrame&);
+  AgentSnapshotCollectorImpl(const AgentSnapshotCollectorImpl&) = delete;
+  AgentSnapshotCollectorImpl& operator=(const AgentSnapshotCollectorImpl&) =
+      delete;
+  ~AgentSnapshotCollectorImpl() override;
+
+  void Trace(Visitor* visitor) const override;
+
+  // mojom::blink::AgentSnapshotCollector:
+  void CollectFrameElements(mojom::blink::AgentSnapshotOptionsPtr options,
+                            CollectFrameElementsCallback callback) override;
+  void ResolveNode(int32_t local_dom_node_id,
+                   ResolveNodeCallback callback) override;
+
+ private:
+  void Bind(
+      mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver);
+
+  HeapMojoReceiverSet<mojom::blink::AgentSnapshotCollector,
+                      AgentSnapshotCollectorImpl>
+      receiver_set_;
+};
+
+}  // namespace blink
