From 8dcf173bd64c3346ccc981bc6344fa62e78c38bb Mon Sep 17 00:00:00 2001
From: Leo Rodarte <leorodarte07@gmail.com>
Date: Sat, 19 Sep 2026 23:45:22 -0400
Subject: [PATCH 13/41] hardware

deviceMemory + hardwareConcurrency spoof.
---
 .../approximated_device_memory.cc             | 58 +++++++++++++++++++
 .../frame/navigator_concurrent_hardware.cc    | 41 ++++++++++++-
 2 files changed, 98 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/common/device_memory/approximated_device_memory.cc b/third_party/blink/common/device_memory/approximated_device_memory.cc
index 7fd53ebba0..bb1ba50f4b 100644
--- a/third_party/blink/common/device_memory/approximated_device_memory.cc
+++ b/third_party/blink/common/device_memory/approximated_device_memory.cc
@@ -4,10 +4,20 @@
 
 #include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
 
+#include <optional>
+#include <string_view>
+
 #include "base/byte_size.h"
 #include "base/check_op.h"
+#include "base/containers/span.h"
 #include "base/feature_list.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/system/sys_info.h"
+#include "base/version_info/version_info_values.h"
+#include "components/browser/browser_runtime.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/fingerprint_pool.h"
+#include "components/browser/switch_resolver.h"
 #include "third_party/blink/public/common/features.h"
 
 namespace blink {
@@ -27,6 +37,54 @@ void ApproximatedDeviceMemory::Initialize() {
 
 // static
 float ApproximatedDeviceMemory::GetApproximatedDeviceMemory() {
+  // browser: the spoofed value is snapped to the same bucket table as the
+  // real one, chosen by the (spoofed) major version since the table changed
+  // in 147.
+  static const float spoofed = []() -> float {
+    const int raw_value =
+        browser::ResolveSwitch<int>(
+            switches::kFingerprintDeviceMemory,
+            [](const std::string& value) -> std::optional<int> {
+              int parsed = 0;
+              if (!base::StringToInt(value, &parsed) || parsed <= 0) {
+                return std::nullopt;
+              }
+              return parsed;
+            },
+            [](int32_t seed) -> int {
+              const browser::FingerprintProfile* profile =
+                  browser::ProfileForSeed(seed);
+              return profile ? profile->device_memory : 0;
+            },
+            /*fallback_when_absent=*/0)
+            .value;
+    if (raw_value <= 0) {
+      return -1.0f;
+    }
+    int major_version = 0;
+    if (!base::StringToInt(browser::SpoofedBrandVersion(), &major_version) ||
+        major_version <= 0) {
+      constexpr std::string_view kVersion = PRODUCT_VERSION;
+      base::StringToInt(kVersion.substr(0, kVersion.find('.')), &major_version);
+    }
+    static constexpr float kCurrentBuckets[] = {2.0f, 4.0f, 8.0f, 16.0f, 32.0f};
+    static constexpr float kLegacyBuckets[] = {0.25f, 0.5f, 1.0f,
+                                               2.0f,  4.0f, 8.0f};
+    const base::span<const float> buckets =
+        major_version >= 147 ? base::span<const float>(kCurrentBuckets)
+                             : base::span<const float>(kLegacyBuckets);
+    float result = buckets[0];
+    for (float bucket : buckets) {
+      if (bucket <= static_cast<float>(raw_value)) {
+        result = bucket;
+      }
+    }
+    return result;
+  }();
+  if (spoofed >= 0.0f) {
+    return spoofed;
+  }
+
   return approximated_device_memory_gb_;
 }
 
diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index f5c0db2d1b..5d13dc2b8b 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -4,12 +4,51 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
+#include <optional>
+
+#include "base/strings/string_number_conversions.h"
 #include "base/system/sys_info.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/fingerprint_pool.h"
+#include "components/browser/switch_resolver.h"
 
 namespace blink {
 
+namespace {
+
+// browser: the spoofed core count, 0 when not spoofed. Cached so the
+// per-call cost matches stock, where NumberOfProcessors() is a field read.
+unsigned CachedSpoofedConcurrency() {
+  static const unsigned value =
+      browser::ResolveSwitch<unsigned>(
+          switches::kFingerprintHardwareConcurrency,
+          [](const std::string& s) -> std::optional<unsigned> {
+            unsigned parsed = 0;
+            if (!base::StringToUint(s, &parsed) || parsed == 0) {
+              return std::nullopt;
+            }
+            return parsed;
+          },
+          [](int32_t seed) -> unsigned {
+            const browser::FingerprintProfile* profile =
+                browser::ProfileForSeed(seed);
+            return profile
+                       ? static_cast<unsigned>(profile->hardware_concurrency)
+                       : 0u;
+          },
+          /*fallback_when_absent=*/0u)
+          .value;
+  return value;
+}
+
+}  // namespace
+
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
-  return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
+  // browser: the stock value is read first so per-call timing matches stock.
+  const unsigned real =
+      static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
+  const unsigned spoof = CachedSpoofedConcurrency();
+  return spoof ? spoof : real;
 }
 
 }  // namespace blink
