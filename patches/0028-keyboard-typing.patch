+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_KEYBOARD_TYPING_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_KEYBOARD_TYPING_SESSION_H_
+
+#include <cstdint>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace content {
+
+class RenderWidgetHostImpl;
+
+// Drives the typing animation behind Input.dispatchKeystrokes. The session
+// precomputes the full event schedule from the input text, including any
+// injected typos and their corrections, then walks it on the UI thread with a
+// base::OneShotTimer, dispatching keyDown / keyUp events straight to
+// RenderWidgetHostImpl::ForwardKeyboardEventWithCommands.
+//
+// Dispatching from the browser process is the point: with one
+// Input.dispatchKeyEvent per key, every keystroke pays a serialization and
+// ack round trip, which caps the achievable typing rate.
+//
+// One session serves one CDP call. InputHandler owns it; destroying it
+// mid-stream stops the timer and runs the completion callback with
+// success=false, which fails the CDP call.
+class KeyboardTypingSession {
+ public:
+  struct Params {
+    // UTF-8 text to type. '\n' maps to Enter.
+    std::string text;
+    // Divides every time interval (delays, holds, pauses). 1.0 is the
+    // baseline; larger values type faster.
+    double speed_multiplier = 1.0;
+    // Inter-keystroke delay range in ms, before speed scaling.
+    int keystroke_delay_min_ms = 60;
+    int keystroke_delay_max_ms = 260;
+    // Key hold range in ms between keyDown and keyUp.
+    int key_hold_min_ms = 20;
+    int key_hold_max_ms = 55;
+    // Whether bigram / repeat / punctuation timing adjustments apply.
+    bool context_aware = true;
+    // Per-character probability of a "thinking pause" before the key.
+    double thinking_pause_probability = 0.0;
+    int thinking_pause_min_ms = 300;
+    int thinking_pause_max_ms = 800;
+    // Per-character probability of injecting a typo. 0 disables typos.
+    double typo_probability = 0.0;
+    // RNG seed. The same seed, params and text give the same schedule.
+    uint64_t seed = 0;
+  };
+
+  // Runs once, with success=true when the schedule completed and false when
+  // the session aborted (widget destroyed mid-stream, session cancelled).
+  using CompletionCallback = base::OnceCallback<void(bool success)>;
+
+  KeyboardTypingSession(base::WeakPtr<RenderWidgetHostImpl> widget_host,
+                        Params params,
+                        CompletionCallback callback);
+
+  KeyboardTypingSession(const KeyboardTypingSession&) = delete;
+  KeyboardTypingSession& operator=(const KeyboardTypingSession&) = delete;
+
+  // Runs the completion callback with success=false if it has not fired.
+  ~KeyboardTypingSession();
+
+  // Begins dispatching. Must be called exactly once. The session may finish
+  // synchronously inside this call if the schedule is empty.
+  void Start();
+
+ private:
+  struct ScheduledEvent {
+    base::TimeDelta time_offset;  // from session start
+    bool is_key_up = false;
+    std::string key;   // DOM 'key' string, e.g. "a", "Backspace"
+    std::string code;  // DOM 'code' string, e.g. "KeyA"
+    int windows_vkey = 0;
+    int modifiers = 0;    // CDP modifier bits: alt=1, ctrl=2, meta=4, shift=8
+    std::u16string text;  // only set for the keyDown of printable chars
+  };
+
+  // Schedule generation, run from Start().
+  void BuildSchedule();
+  void EmitChar(char32_t c);
+  void EmitBackspace();
+  void AppendKeyEvents(const std::string& key,
+                       const std::string& code,
+                       int windows_vkey,
+                       int modifiers,
+                       const std::u16string& text);
+  // Adds the inter-key delay between the previous key and the next keyDown.
+  void AdvanceInterKeyDelay(char32_t next_char);
+  void AdvanceMs(int ms);
+  // Types up to `max_chars` codepoints from `start`, each after an inter-key
+  // delay, stopping at the end of the input. Returns the position after the
+  // last typed codepoint.
+  size_t TypeChunk(size_t start, int max_chars);
+  // Emits `count` backspaces with fast inter-key gaps.
+  void EmitBackspaceBurst(int count);
+  // Re-types the codepoints in [from, to) without an inter-key delay before
+  // the first one; the caller's recovery pause covers that gap.
+  void RetypeRange(size_t from, size_t to);
+
+  // Typo injection. Each moves intended_index_ past the consumed characters.
+  // MaybeInjectTypo returns true when a typo was injected, in which case the
+  // caller skips its own emit.
+  bool MaybeInjectTypo(char32_t intended_char);
+  void InjectAdjacentTypo(char32_t wrong_char);
+  void InjectDoubledTypo(char32_t intended_char);
+  void InjectOmissionTypo(char32_t intended_char);
+  // Picks a QWERTY neighbour of `c`, keeping its shift state. Returns 0 when
+  // no adjacency is known.
+  char32_t PickAdjacent(char32_t c);
+
+  // Dispatch loop, run from the timer.
+  void DispatchPending();
+  void Finish(bool success);
+
+  int RandInt(int min_inclusive, int max_inclusive);
+  double RandDouble();  // [0.0, 1.0)
+  bool Bernoulli(double p);
+
+  base::WeakPtr<RenderWidgetHostImpl> widget_host_;
+  Params params_;
+  CompletionCallback callback_;
+
+  std::mt19937_64 rng_;
+  std::vector<ScheduledEvent> schedule_;
+  size_t next_index_ = 0;
+
+  // params_.text decoded to UTF-32, one entry per codepoint. Drives schedule
+  // generation only.
+  std::vector<char32_t> codepoints_;
+  // Position in codepoints_ currently being scheduled.
+  size_t intended_index_ = 0;
+  // The previously typed char, typos included, for the context-aware bigram
+  // timing. Zero before the first key and after a backspace burst.
+  char32_t last_typed_char_ = 0;
+  // Cursor in the schedule timeline: the next appended event fires here.
+  base::TimeDelta cursor_time_;
+  // Speed-scaled versions of the params_ time ranges.
+  int scaled_keystroke_min_ms_ = 1;
+  int scaled_keystroke_max_ms_ = 1;
+  int scaled_hold_min_ms_ = 0;
+  int scaled_hold_max_ms_ = 0;
+  int scaled_thinking_min_ms_ = 0;
+  int scaled_thinking_max_ms_ = 0;
+
+  base::TimeTicks dispatch_start_;
+  base::OneShotTimer timer_;
+  bool started_ = false;
+  base::WeakPtrFactory<KeyboardTypingSession> weak_factory_{this};
+};
+
+}  // namespace content
