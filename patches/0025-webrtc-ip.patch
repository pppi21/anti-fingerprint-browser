+
+  // browser: candidate addresses are replaced before they reach script.
+  if (browser::IsWebRtcIpSpoofActive()) {
+    if (webrtc_stat.address.has_value()) {
+      v8_stat->setAddress(String::FromUtf8(
+          browser::SpoofWebRtcIp(webrtc_stat.address.value())));
+    }
+    if (webrtc_stat.ip.has_value()) {
+      v8_stat->setIp(
+          String::FromUtf8(browser::SpoofWebRtcIp(webrtc_stat.ip.value())));
+    }
+    if (webrtc_stat.related_address.has_value()) {
+      v8_stat->setRelatedAddress(String::FromUtf8(
+          browser::SpoofWebRtcIp(webrtc_stat.related_address.value())));
+    }
+  }
+
   return v8_stat;
 }
 
