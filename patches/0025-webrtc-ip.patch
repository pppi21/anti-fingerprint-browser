--- /dev/null
+++ b/components/browser/webrtc_ip_spoofer.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Replaces the local IP addresses WebRTC exposes to pages (ICE candidates,
+// session descriptions and candidate stats) with the addresses given by
+// --webrtc-ip4 and --webrtc-ip6. Reserved addresses (unspecified, loopback,
+// link-local) and non-IP hosts such as mDNS names are left alone.
+
+#ifndef COMPONENTS_BROWSER_WEBRTC_IP_SPOOFER_H_
+#define COMPONENTS_BROWSER_WEBRTC_IP_SPOOFER_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// True when at least one replacement address is configured.
+COMPONENT_EXPORT(BROWSER) bool IsWebRtcIpSpoofActive();
+
+// The replacement for |ip|, or |ip| itself when it is reserved, not an IP
+// literal, or no replacement of its address family is configured.
+COMPONENT_EXPORT(BROWSER) std::string SpoofWebRtcIp(std::string_view ip);
+
+// Replaces the connection address and any "raddr" related address of an ICE
+// candidate line, with or without the "a=" SDP prefix.
+COMPONENT_EXPORT(BROWSER)
+std::string SpoofWebRtcCandidate(std::string_view candidate);
+
+// Replaces the addresses in the a=candidate, c= and o= lines of an SDP body.
+// Line endings are preserved.
+COMPONENT_EXPORT(BROWSER) std::string SpoofWebRtcSdp(std::string_view sdp);
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_WEBRTC_IP_SPOOFER_H_
