+// browser: Input.dispatchMousePath.
+void InputHandler::DispatchMousePath(
+    std::unique_ptr<Array<Input::MousePathPoint>> path,
+    int polling_rate_hz,
+    std::optional<std::string> button,
+    std::unique_ptr<DispatchMousePathCallback> callback) {
+  if (!path || path->empty()) {
+    callback->sendFailure(
+        Response::InvalidParams("'path' must be a non-empty array"));
+    return;
+  }
+  if (polling_rate_hz < 1 || polling_rate_hz > 10000) {
+    callback->sendFailure(
+        Response::InvalidParams("'pollingRateHz' must be between 1 and 10000"));
+    return;
+  }
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  if (!host_ || !host_->GetRenderWidgetHost() || !root_view) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+
+  // A move without a held button is a hover whatever the caller intended:
+  // no drag starts and no pointer capture is granted, so a native control
+  // such as <input type=range> stays where the press landed. A hand-written
+  // mousemove listener keeps its own is-down flag and reacts anyway, which
+  // is why a hover reads as working until it meets a real control.
+  struct ButtonName {
+    std::string_view name;
+    SyntheticPointerActionParams::Button button;
+  };
+  static constexpr ButtonName kButtons[] = {
+      {"none", SyntheticPointerActionParams::Button::NO_BUTTON},
+      {"left", SyntheticPointerActionParams::Button::LEFT},
+      {"middle", SyntheticPointerActionParams::Button::MIDDLE},
+      {"right", SyntheticPointerActionParams::Button::RIGHT},
+      {"back", SyntheticPointerActionParams::Button::BACK},
+      {"forward", SyntheticPointerActionParams::Button::FORWARD},
+  };
+  const std::string held = button.value_or("none");
+  const auto* named = std::ranges::find(kButtons, held, &ButtonName::name);
+  if (named == std::end(kButtons)) {
+    callback->sendFailure(
+        Response::InvalidParams("'button' must be one of none, left, middle, "
+                                "right, back, forward"));
+    return;
+  }
+
+  SyntheticMousePathGestureParams params;
+  params.button = named->button;
+  // Like synthesizePinch/Scroll/TapGesture, the gesture is marked as coming
+  // from the debugger so it dispatches straight to the target and skips
+  // SyntheticGestureController's visibility gate. Without that the gesture is
+  // deferred whenever the root widget reads as hidden, which is common for an
+  // automation window behind another one, and the call hangs until the
+  // client times out. The kFromDebugger modifier is browser-side only: the
+  // renderer never reads it, so isTrusted and routing are unaffected.
+  params.from_devtools_debugger = true;
+  params.gesture_source_type = content::mojom::GestureSourceType::kMouseInput;
+  params.polling_interval = base::Milliseconds(1000.0 / polling_rate_hz);
+  const float scale = ScaleFactor();
+  for (const auto& point : *path) {
+    params.positions.push_back({static_cast<float>(point->GetX() * scale),
+                                static_cast<float>(point->GetY() * scale)});
+  }
+
+  // The CDP callback resolves once the pointer-move events are dispatched,
+  // not after the WaitForTargetAck round trip the default QueueSyntheticGesture
+  // path adds. That round trip lags by seconds on busy or occluded pages,
+  // stalling every path after its motion has finished. A following click goes
+  // through Input.dispatchMouseEvent, which hit-tests afresh at the press
+  // coordinates and does not depend on this ack.
+  root_view->host()->QueueSyntheticGestureCompleteImmediately(
+      std::make_unique<SyntheticMousePathGesture>(params),
+      base::BindOnce(&InputHandler::OnMousePathFinished,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void InputHandler::OnMousePathFinished(
+    std::unique_ptr<DispatchMousePathCallback> callback,
+    SyntheticGesture::Result result) {
+  if (result == SyntheticGesture::GESTURE_FINISHED) {
+    callback->sendSuccess();
+  } else {
+    callback->sendFailure(Response::ServerError("Mouse path gesture aborted"));
+  }
+}
