diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/canvas_curve_noise.cc b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_curve_noise.cc
new file mode 100644
index 0000000000..33cc1566f1
--- /dev/null
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_curve_noise.cc
@@ -0,0 +1,227 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/canvas/canvas2d/canvas_curve_noise.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+#include "cc/paint/color_filter.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/switch_resolver.h"
+#include "third_party/blink/renderer/platform/graphics/deterministic_noise.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "third_party/skia/include/core/SkPoint.h"
+
+namespace blink {
+
+namespace {
+
+float GetCanvasCurveNoiseScalar() {
+  static const float cached = browser::ResolveLinearNoiseSwitch(
+      ::switches::kCanvasCurveNoise, browser::kSaltCanvasCurve, 0.003, 0.015);
+  return cached;
+}
+
+float GetCanvasBlurNoiseScalar() {
+  static const float cached = browser::ResolveLinearNoiseSwitch(
+      ::switches::kCanvasBlurNoise, browser::kSaltCanvasBlur, 0.005, 0.03);
+  return cached;
+}
+
+float GetCanvasGradientNoiseScalar() {
+  static const float cached = browser::ResolveLinearNoiseSwitch(
+      ::switches::kCanvasGradientNoise, browser::kSaltCanvasGradient, 0.003,
+      0.02);
+  return cached;
+}
+
+// Per-channel salts for the text/emoji color LUT. Internal to the filter
+// builder: each channel's table is independently hashed.
+constexpr uint32_t kTextColorSaltR = 0x901u;
+constexpr uint32_t kTextColorSaltG = 0x902u;
+constexpr uint32_t kTextColorSaltB = 0x903u;
+
+// Computes the perturbed uint8 value for table index `i`. `scalar` is the
+// already-multiplied amplitude (curve_noise_scalar * multiplier).
+uint8_t PerturbTableEntry(int i, uint32_t salt, float scalar) {
+  const float normalized =
+      DeterministicSignedUnitNoise(static_cast<uint32_t>(i), salt);
+  // normalized is in [-0.5, 0.5). Final delta in uint8 units.
+  const int delta = static_cast<int>(normalized * scalar * 255.0f);
+  return static_cast<uint8_t>(std::clamp(i + delta, 0, 255));
+}
+
+}  // namespace
+
+bool CanvasCurveNoiseActive() {
+  return GetCanvasCurveNoiseScalar() != 0.0f;
+}
+
+float PerturbCurveCoord(float coord,
+                        uint32_t axis_salt,
+                        float extra_multiplier) {
+  const float scalar = GetCanvasCurveNoiseScalar();
+  if (scalar == 0.0f) {
+    return coord;
+  }
+  return coord + DeterministicSignedUnitNoise(coord, axis_salt) * scalar *
+                     extra_multiplier;
+}
+
+bool CanvasBlurNoiseActive() {
+  return GetCanvasBlurNoiseScalar() != 0.0f;
+}
+
+float PerturbBlurSigma(float sigma, uint32_t axis_salt) {
+  const float scalar = GetCanvasBlurNoiseScalar();
+  if (scalar == 0.0f || sigma == 0.0f) {
+    return sigma;
+  }
+  // The noise is in [-0.5, 0.5); scaling by 2 * scalar puts the final delta
+  // in [-scalar, +scalar). Multiplicative application keeps the perturbation
+  // proportional to sigma regardless of blur magnitude.
+  return sigma * (1.0f + DeterministicSignedUnitNoise(sigma, axis_salt) * 2.0f *
+                             scalar);
+}
+
+float GetCanvasGradientNoiseAmplitude() {
+  return GetCanvasGradientNoiseScalar();
+}
+
+sk_sp<cc::ColorFilter> MakeCanvasTextColorPerturbFilter() {
+  // Built once per process: --canvas-curve-noise is fixed at startup so the
+  // LUT is invariant and can be cached for the process lifetime.
+  static const sk_sp<cc::ColorFilter> cached = []() -> sk_sp<cc::ColorFilter> {
+    const float scalar =
+        GetCanvasCurveNoiseScalar() * kCurveNoiseTextColorMultiplier;
+    if (scalar == 0.0f) {
+      return nullptr;
+    }
+
+    std::array<uint8_t, 256> a_table;
+    std::array<uint8_t, 256> r_table;
+    std::array<uint8_t, 256> g_table;
+    std::array<uint8_t, 256> b_table;
+    for (int i = 0; i < 256; i++) {
+      a_table[i] = static_cast<uint8_t>(i);  // Alpha pass-through.
+      r_table[i] = PerturbTableEntry(i, kTextColorSaltR, scalar);
+      g_table[i] = PerturbTableEntry(i, kTextColorSaltG, scalar);
+      b_table[i] = PerturbTableEntry(i, kTextColorSaltB, scalar);
+    }
+    // table[0] = 0 invariant: pure black input stays pure black so #000
+    // monochrome glyph pixels (R=G=B=0 pre-mult) pass through unchanged
+    // and the #000 probe rows stay canary.
+    r_table[0] = 0;
+    g_table[0] = 0;
+    b_table[0] = 0;
+
+    return cc::ColorFilter::MakeTableARGB(a_table.data(), r_table.data(),
+                                          g_table.data(), b_table.data());
+  }();
+  return cached;
+}
+
+SkPath PerturbSkPathCurves(const SkPath& input, bool is_fill) {
+  if (!CanvasCurveNoiseActive()) {
+    return input;
+  }
+
+  // Size guard: skip perturbation on paths smaller than the minimum bounds
+  // threshold. Protects against the CreepJS 2x2 arc canonical-match lie
+  // detector (see the kCurveNoiseMinBoundsPx comment). Cheap: getBounds() is
+  // O(1) when Skia has cached the bounds and O(n) worst case where n is verb
+  // count.
+  const SkRect bounds = input.getBounds();
+  if (bounds.width() < kCurveNoiseMinBoundsPx ||
+      bounds.height() < kCurveNoiseMinBoundsPx) {
+    return input;
+  }
+
+  // Multipliers combine via max, not product: an arcTo fill keeps the conic
+  // multiplier rather than stacking (5 * 5 = 25x would over-perturb).
+  const float fill_mult = is_fill ? kCurveNoiseFillMultiplier : 1.0f;
+  const float conic_mult = std::max(kCurveNoiseConicMultiplier, fill_mult);
+  const float line_diag_mult =
+      std::max(kCurveNoiseLineDiagMultiplier, fill_mult);
+
+  // SkPath is immutable in this Skia version; mutations go through
+  // SkPathBuilder, with .detach() yielding the finalized SkPath.
+  SkPathBuilder builder;
+  builder.setFillType(input.getFillType());
+  SkPath::Iter iter(input, /*forceClose=*/false);
+  SkPoint pts[4];
+  SkPath::Verb verb;
+  while ((verb = iter.next(pts)) != SkPath::kDone_Verb) {
+    switch (verb) {
+      case SkPath::kMove_Verb:
+        builder.moveTo(pts[0]);
+        break;
+      case SkPath::kLine_Verb: {
+        // Axis-aligned line (pure horizontal or vertical): deterministic
+        // canary geometry. fillRect, strokeRect, axis-stroke tests all go
+        // through these; perturbing would leak paint(CPU) invariance.
+        if (pts[0].fY == pts[1].fY || pts[0].fX == pts[1].fX) {
+          builder.lineTo(pts[1]);
+          break;
+        }
+        // Non-axis-aligned line: AA coverage on the edge varies cross-GPU
+        // naturally. Perturbing the endpoint shifts the AA pattern without
+        // touching any deterministic operation. Covers polygon diagonal
+        // edges (triangle fills) and round-join diagonal body here; simple
+        // diagonal strokes go through DrawPathInternal's IsLine fast path
+        // and are perturbed there.
+        SkPoint end = {PerturbCurveCoord(pts[1].fX, kCurveNoiseSaltLineDiagX,
+                                         line_diag_mult),
+                       PerturbCurveCoord(pts[1].fY, kCurveNoiseSaltLineDiagY,
+                                         line_diag_mult)};
+        builder.lineTo(end);
+        break;
+      }
+      case SkPath::kQuad_Verb: {
+        SkPoint cp = {
+            PerturbCurveCoord(pts[1].fX, kCurveNoiseSaltQuadCpX, fill_mult),
+            PerturbCurveCoord(pts[1].fY, kCurveNoiseSaltQuadCpY, fill_mult)};
+        SkPoint end = {
+            PerturbCurveCoord(pts[2].fX, kCurveNoiseSaltQuadEndX, fill_mult),
+            PerturbCurveCoord(pts[2].fY, kCurveNoiseSaltQuadEndY, fill_mult)};
+        builder.quadTo(cp, end);
+        break;
+      }
+      case SkPath::kConic_Verb: {
+        SkPoint cp = {
+            PerturbCurveCoord(pts[1].fX, kCurveNoiseSaltConicCpX, conic_mult),
+            PerturbCurveCoord(pts[1].fY, kCurveNoiseSaltConicCpY, conic_mult)};
+        SkPoint end = {
+            PerturbCurveCoord(pts[2].fX, kCurveNoiseSaltConicEndX, conic_mult),
+            PerturbCurveCoord(pts[2].fY, kCurveNoiseSaltConicEndY, conic_mult)};
+        builder.conicTo(cp, end, iter.conicWeight());
+        break;
+      }
+      case SkPath::kCubic_Verb: {
+        SkPoint cp1 = {
+            PerturbCurveCoord(pts[1].fX, kCurveNoiseSaltBezCp1X, fill_mult),
+            PerturbCurveCoord(pts[1].fY, kCurveNoiseSaltBezCp1Y, fill_mult)};
+        SkPoint cp2 = {
+            PerturbCurveCoord(pts[2].fX, kCurveNoiseSaltBezCp2X, fill_mult),
+            PerturbCurveCoord(pts[2].fY, kCurveNoiseSaltBezCp2Y, fill_mult)};
+        SkPoint end = {
+            PerturbCurveCoord(pts[3].fX, kCurveNoiseSaltBezEndX, fill_mult),
+            PerturbCurveCoord(pts[3].fY, kCurveNoiseSaltBezEndY, fill_mult)};
+        builder.cubicTo(cp1, cp2, end);
+        break;
+      }
+      case SkPath::kClose_Verb:
+        builder.close();
+        break;
+      case SkPath::kDone_Verb:
+        // Loop sentinel; unreachable since the while-condition catches it.
+        break;
+    }
+  }
+  return builder.detach();
+}
