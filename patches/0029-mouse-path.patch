+++ b/content/common/input/synthetic_mouse_path_gesture_params.cc
@@ -0,0 +1,28 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/common/input/synthetic_mouse_path_gesture_params.h"
+
+namespace content {
+
+SyntheticMousePathGestureParams::SyntheticMousePathGestureParams() = default;
+
+SyntheticMousePathGestureParams::SyntheticMousePathGestureParams(
+    const SyntheticMousePathGestureParams& other)
+    : SyntheticGestureParams(other),
+      positions(other.positions),
+      polling_interval(other.polling_interval),
+      // SyntheticGestureBase copy-constructs the params it is handed, so a
+      // member missing from this list is silently dropped between the
+      // handler that sets it and the gesture that reads it.
+      button(other.button) {}
+
+SyntheticMousePathGestureParams::~SyntheticMousePathGestureParams() = default;
+
+SyntheticGestureParams::GestureType
+SyntheticMousePathGestureParams::GetGestureType() const {
+  return MOUSE_PATH_GESTURE;
+}
+
+}  // namespace content
