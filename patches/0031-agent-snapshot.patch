+
+// browser: Page.captureAgentSnapshot. Validates, enumerates the page's local
+// roots and fans out the per-frame Mojo calls; the reply is assembled in
+// FinishAgentSnapshot once every frame, the occlusion hit-tests and the
+// screenshot have completed.
+void PageHandler::CaptureAgentSnapshot(
+    std::optional<std::string> format,
+    std::optional<int> quality,
+    std::optional<std::string> offscreen_mode,
+    std::optional<bool> include_screenshot,
+    std::unique_ptr<CaptureAgentSnapshotCallback> callback) {
+  if (!host_ || !host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+
+  auto encoder =
+      GetEncoder(format.value_or(Page::CaptureScreenshot::FormatEnum::Png),
+                 quality.value_or(kDefaultScreenshotQuality),
+                 /*optimize_for_speed=*/false);
+  if (std::holds_alternative<Response>(encoder)) {
+    callback->sendFailure(std::get<Response>(encoder));
+    return;
+  }
+
+  // Each capture mints fresh agentNodeIds; the previous capture's registry
+  // is dropped so stale ids stop resolving. The counter keeps incrementing so
+  // ids stay unique across captures.
+  agent_node_registry_.clear();
+
+  auto request = base::MakeRefCounted<AgentSnapshotRequest>();
+  request->callback = std::move(callback);
+  request->encoder = std::get<BitmapEncoder>(encoder);
+  request->include_screenshot = include_screenshot.value_or(true);
+  request->offscreen_mode = AgentOffscreenModeFromString(offscreen_mode);
+
+  // Every live local root (main frame and each OOPIF root). Same-process
+  // subframes are skipped: the renderer walks a local root's same-process
+  // descendants inside one CollectFrameElements() call and returns their
+  // boxes already in the local root's space. Calling them here too would
+  // count their elements twice and, because such a subframe shares its local
+  // root's widget view, TransformPointToRootCoordSpaceF would drop its
+  // in-root offset.
+  host_->ForEachRenderFrameHostImpl([&request](RenderFrameHostImpl* rfh) {
+    if (!rfh->IsRenderFrameLive() || !rfh->is_local_root()) {
+      return;
+    }
+    AgentSnapshotRequest::FrameEntry entry;
+    entry.rfh = rfh->GetWeakPtr();
+    entry.frame_id = rfh->GetDevToolsFrameToken().ToString();
+    entry.view = static_cast<RenderWidgetHostViewBase*>(rfh->GetView());
+    request->frames.push_back(std::move(entry));
+  });
+
+  if (request->frames.empty()) {
+    OnAllAgentFramesCollected(request);
+    return;
+  }
+
+  // Proceeds once every frame has replied or dropped its pipe.
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->frames.size(),
+      base::BindOnce(&PageHandler::OnAllAgentFramesCollected,
+                     weak_factory_.GetWeakPtr(), request));
+
+  request->collectors.reserve(request->frames.size());
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    RenderFrameHostImpl* rfh = request->frames[i].rfh.get();
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      // The frame went away between enumeration and dispatch.
+      barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    auto options = blink::mojom::AgentSnapshotOptions::New();
+    options->offscreen_mode = request->offscreen_mode;
+    // A dropped pipe still advances the barrier, with a null snapshot.
+    collector->CollectFrameElements(
+        std::move(options),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentFrameElementsCollected,
+                           weak_factory_.GetWeakPtr(), request, i, barrier),
+            nullptr));
+    request->collectors.push_back(std::move(collector));
+  }
+}
+
+void PageHandler::OnAgentFrameElementsCollected(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t frame_index,
+    base::RepeatingClosure barrier,
+    blink::mojom::AgentFrameSnapshotPtr result) {
+  if (frame_index < request->frames.size()) {
+    request->frames[frame_index].snapshot = std::move(result);
+  }
+  barrier.Run();
+}
+
+// Composes every frame's local boxes into root-viewport CSS px, then starts
+// the occlusion hit-tests and the screenshot in parallel.
+void PageHandler::OnAllAgentFramesCollected(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  if (!host_ || !host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    if (request->callback) {
+      request->callback->sendFailure(Response::InternalError());
+    }
+    return;
+  }
+
+  RenderWidgetHostImpl* widget_host = host_->GetRenderWidgetHost();
+  auto* root_view = static_cast<RenderWidgetHostViewBase*>(host_->GetView());
+
+  request->url = host_->GetLastCommittedURL().spec();
+  if (auto* wc = WebContentsImpl::FromRenderFrameHostImpl(host_)) {
+    request->title = base::UTF16ToUTF8(wc->GetTitle());
+  }
+
+  // GetVisibleViewportSize() is in DIP, which is CSS px at pinch scale 1.
+  const cc::RenderFrameMetadata& metadata =
+      widget_host->render_frame_metadata_provider()->LastRenderFrameMetadata();
+  double dsf = metadata.device_scale_factor > 0
+                   ? metadata.device_scale_factor
+                   : root_view->GetDeviceScaleFactor();
+  if (dsf <= 0) {
+    dsf = 1;
+  }
+  gfx::Size visible = root_view->GetVisibleViewportSize();
+  request->device_scale_factor = dsf;
+  request->vp_width = visible.width();
+  request->vp_height = visible.height();
+  if (metadata.root_scroll_offset) {
+    // Physical px to CSS px, as BuildScreencastFrameMetadata does.
+    request->scroll_x = metadata.root_scroll_offset->x() / dsf;
+    request->scroll_y = metadata.root_scroll_offset->y() / dsf;
+  }
+  // TODO: take the scrollable content size from
+  // blink::mojom::LocalMainFrame::GetFullPageSize as CaptureScreenshot does;
+  // until then this is a lower bound from the viewport and scroll offset.
+  request->scroll_width = std::max<double>(
+      request->vp_width, request->scroll_x + request->vp_width);
+  request->scroll_height = std::max<double>(
+      request->vp_height, request->scroll_y + request->vp_height);
+
+  const gfx::RectF root_viewport_rect(0, 0, request->vp_width,
+                                      request->vp_height);
+
+  for (auto& frame : request->frames) {
+    if (!frame.snapshot || !frame.view) {
+      continue;
+    }
+    RenderWidgetHostViewBase* frame_view = frame.view;
+    const GlobalRenderFrameHostId frame_rfh_id =
+        frame.rfh ? frame.rfh->GetGlobalId() : GlobalRenderFrameHostId();
+    for (const auto& el : frame.snapshot->elements) {
+      AgentSnapshotRequest::ComposedElement ce;
+      ce.backend_node_id = el->backend_node_id;
+      ce.local_root_rfh_id = frame_rfh_id;
+      ce.frame_id = frame.frame_id;
+      ce.role = el->role;
+      if (!el->name.empty()) {
+        ce.name = el->name;
+      }
+      if (!el->value.empty()) {
+        ce.value = el->value;
+      }
+      if (!el->description.empty()) {
+        ce.description = el->description;
+      }
+      ce.tag = el->tag;
+      ce.interactive = el->interactive;
+      if (!el->interactive_reason.empty()) {
+        ce.interactive_reason = el->interactive_reason;
+      }
+      ce.states = el->states;
+      if (el->shadow_host_backend_node_id != 0) {
+        ce.shadow_host_backend_node_id = el->shadow_host_backend_node_id;
+      }
+      if (!el->href.empty()) {
+        ce.href = el->href;
+      }
+      if (!el->src.empty()) {
+        ce.src = el->src;
+      }
+      ce.element_view = frame_view;
+
+      // The renderer already expressed same-process subframe elements in
+      // their local root's space, so `frame` is always a local root: the
+      // main frame's transform is the identity, and an OOPIF root's
+      // child-frame view maps to the true root. Local CSS px equal DIP at
+      // page and pinch scale 1.
+      // TODO: divide by the page/pinch scale for zoomed pages, and map all
+      // four corners once a non-axis-aligned transform is possible.
+      const blink::mojom::AgentElementBox& box = *el->box;
+      gfx::PointF top_left = frame_view->TransformPointToRootCoordSpaceF(
+          gfx::PointF(box.x, box.y));
+      ce.x = top_left.x();
+      ce.y = top_left.y();
+      ce.width = box.width;
+      ce.height = box.height;
+
+      const gfx::RectF root_box(ce.x, ce.y, ce.width, ce.height);
+      ce.in_viewport = root_box.Intersects(root_viewport_rect);
+      ce.action_point_root =
+          gfx::PointF(ce.x + ce.width / 2, ce.y + ce.height / 2);
+
+      request->composed.push_back(std::move(ce));
+    }
+  }
+
+  const int outstanding = request->include_screenshot ? 2 : 1;
+  request->finish_barrier = base::BarrierClosure(
+      outstanding, base::BindOnce(&PageHandler::FinishAgentSnapshot,
+                                  weak_factory_.GetWeakPtr(), request));
+
+  StartAgentSnapshotOcclusion(request);
+  if (request->include_screenshot) {
+    StartAgentSnapshotScreenshot(request);
+  }
+}
+
+// Cross-context occlusion. Only interactive in-viewport elements are
+// hit-tested; everything else keeps obscured=false.
+void PageHandler::StartAgentSnapshotOcclusion(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  std::vector<size_t> to_test;
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    if (ce.interactive && ce.in_viewport) {
+      to_test.push_back(i);
+    }
+  }
+
+  RenderWidgetHostDelegate* delegate =
+      host_ && host_->GetRenderWidgetHost()
+          ? host_->GetRenderWidgetHost()->delegate()
+          : nullptr;
+  auto* root_view =
+      host_ ? static_cast<RenderWidgetHostViewBase*>(host_->GetView())
+            : nullptr;
+  if (to_test.empty() || !delegate || !delegate->GetInputEventRouter() ||
+      !root_view) {
+    request->finish_barrier.Run();
+    return;
+  }
+
+  // TODO: one async hit-test per element; a synchronous viz::HitTestQuery
+  // off the root HostFrameSinkManager could replace them.
+  base::RepeatingClosure occlusion_barrier =
+      base::BarrierClosure(to_test.size(), request->finish_barrier);
+  for (size_t index : to_test) {
+    delegate->GetRenderWidgetHostAtPointAsynchronously(
+        root_view, request->composed[index].action_point_root,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentElementOcclusionResolved,
+                           weak_factory_.GetWeakPtr(), request, index,
+                           occlusion_barrier),
+            base::WeakPtr<RenderWidgetHostViewBase>(),
+            std::optional<gfx::PointF>()));
+  }
+}
+
+void PageHandler::OnAgentElementOcclusionResolved(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t element_index,
+    base::RepeatingClosure barrier,
+    base::WeakPtr<RenderWidgetHostViewBase> target_view,
+    std::optional<gfx::PointF> transformed_point) {
+  if (element_index < request->composed.size()) {
+    auto& ce = request->composed[element_index];
+    // A failed hit-test leaves obscured=false. A topmost view other than the
+    // element's own means cross-context content covers it.
+    if (target_view && transformed_point.has_value()) {
+      ce.obscured = target_view.get() != ce.element_view;
+    }
+  }
+  barrier.Run();
+}
+
+// OOPIF-aggregated screenshot through the same surface path as
+// CaptureScreenshot.
+void PageHandler::StartAgentSnapshotScreenshot(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  if (!widget_host || !widget_host->GetView()) {
+    request->finish_barrier.Run();
+    return;
+  }
+  if (auto* wc = WebContents::FromRenderFrameHost(host_)) {
+    // Frames are produced even while the page is hidden.
+    request->capturer_handle =
+        wc->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true,
+                                   /*stay_awake=*/true, /*is_activity=*/false);
+  }
+  widget_host->GetSnapshotFromBrowser(
+      base::BindOnce(&PageHandler::OnAgentSnapshotScreenshotCaptured,
+                     weak_factory_.GetWeakPtr(), request),
+      /*from_surface=*/true);
+}
+
+void PageHandler::OnAgentSnapshotScreenshotCaptured(
+    scoped_refptr<AgentSnapshotRequest> request,
+    const gfx::Image& image) {
+  if (!image.IsEmpty()) {
+    // A writable copy: the captured bitmap shares pixels with the surface
+    // capture, and FinishAgentSnapshot draws on it.
+    const SkBitmap& src = *image.ToSkBitmap();
+    if (!src.drawsNothing() &&
+        request->screenshot_bitmap.tryAllocPixels(src.info())) {
+      src.readPixels(request->screenshot_bitmap.pixmap(), 0, 0);
+    }
+  }
+  request->capturer_handle.RunAndReset();
+  request->finish_barrier.Run();
+}
+
+// Assembles the protocol response.
+void PageHandler::FinishAgentSnapshot(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  if (!request->callback) {
+    return;
+  }
+
+  auto viewport = Page::AgentSnapshotViewport::Create()
+                      .SetWidth(base::ClampRound(request->vp_width))
+                      .SetHeight(base::ClampRound(request->vp_height))
+                      .SetDeviceScaleFactor(request->device_scale_factor)
+                      .SetScrollX(request->scroll_x)
+                      .SetScrollY(request->scroll_y)
+                      .SetScrollWidth(request->scroll_width)
+                      .SetScrollHeight(request->scroll_height)
+                      .Build();
+
+  auto elements =
+      std::make_unique<protocol::Array<Page::AgentSnapshotElement>>();
+
+  // The change-detection token covers the url, the viewport geometry and
+  // each reported element's identity and composed geometry.
+  // TODO: fold the focused element's backendNodeId into the token.
+  std::string token_src = base::StringPrintf(
+      "%s|%d|%d|%.1f|%.1f", request->url.c_str(),
+      base::ClampRound(request->vp_width), base::ClampRound(request->vp_height),
+      request->scroll_x, request->scroll_y);
+
+  // The marked set is what the user can act on right now: in the viewport,
+  // interactive and not occluded. Labels a1.. and the colors drive both the
+  // drawn overlay and the per-element label/color fields, so the screenshot
+  // and the listing always agree.
+  const double dsf = request->device_scale_factor;
+  std::vector<int> mark_slot(request->composed.size(), -1);
+  std::vector<gfx::RectF> mark_boxes;
+  std::vector<std::string> mark_labels;
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    if (ce.in_viewport && ce.interactive && !ce.obscured) {
+      mark_slot[i] = static_cast<int>(mark_boxes.size());
+      mark_boxes.emplace_back(ce.x * dsf, ce.y * dsf, ce.width * dsf,
+                              ce.height * dsf);
+      mark_labels.push_back(base::StringPrintf("a%zu", mark_boxes.size()));
+    }
+  }
+  const std::vector<int> mark_colors = AssignAgentMarkColors(mark_boxes, dsf);
+
+  if (request->include_screenshot &&
+      !request->screenshot_bitmap.drawsNothing()) {
+    if (!mark_boxes.empty()) {
+      DrawAgentMarks(request->screenshot_bitmap, mark_boxes, mark_labels,
+                     mark_colors, dsf);
+    }
+    request->screenshot_bytes =
+        request->encoder.Run(request->screenshot_bitmap);
+  }
+
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    // `none` drops elements outside the root viewport; the other modes keep
+    // them.
+    // TODO: apply a real `summary` cap on offscreen elements.
+    if (!ce.in_viewport &&
+        request->offscreen_mode == blink::mojom::AgentOffscreenMode::kNone) {
+      continue;
+    }
+
+    auto states = std::make_unique<protocol::Array<std::string>>();
+    for (const auto& state : ce.states) {
+      states->emplace_back(state);
+    }
+
+    // Only emitted elements get an agentNodeId, so the registry mirrors what
+    // the caller received.
+    const int agent_node_id = ++next_agent_node_id_;
+    agent_node_registry_[agent_node_id] = {ce.local_root_rfh_id,
+                                           ce.backend_node_id};
+
+    // Required fields go through the builder; optional ones are set after.
+    auto element = Page::AgentSnapshotElement::Create()
+                       .SetBackendNodeId(ce.backend_node_id)
+                       .SetAgentNodeId(agent_node_id)
+                       .SetFrameId(ce.frame_id)
+                       .SetRole(ce.role)
+                       .SetTag(ce.tag)
+                       .SetInteractive(ce.interactive)
+                       .SetStates(std::move(states))
+                       .SetX(ce.x)
+                       .SetY(ce.y)
+                       .SetWidth(ce.width)
+                       .SetHeight(ce.height)
+                       .SetInViewport(ce.in_viewport)
+                       .SetObscured(ce.obscured)
+                       .Build();
+    if (ce.name) {
+      element->SetName(*ce.name);
+    }
+    if (ce.value) {
+      element->SetValue(*ce.value);
+    }
+    if (ce.description) {
+      element->SetDescription(*ce.description);
+    }
+    if (ce.interactive_reason) {
+      element->SetInteractiveReason(*ce.interactive_reason);
+    }
+    if (ce.shadow_host_backend_node_id) {
+      element->SetShadowHostBackendNodeId(*ce.shadow_host_backend_node_id);
+    }
+    if (ce.href) {
+      element->SetHref(*ce.href);
+    }
+    if (ce.src) {
+      element->SetSrc(*ce.src);
+    }
+    if (mark_slot[i] >= 0) {
+      const int slot = mark_slot[i];
+      element->SetLabel(mark_labels[slot]);
+      element->SetColor(kAgentMarkPalette[mark_colors[slot]].name);
+    }
+
+    base::StringAppendF(&token_src, ";%d,%.1f,%.1f,%.1f,%.1f",
+                        ce.backend_node_id, ce.x, ce.y, ce.width, ce.height);
+    elements->emplace_back(std::move(element));
+  }
+
+  std::string snapshot_token =
+      base::StringPrintf("%08x", base::PersistentHash(token_src));
+
+  std::optional<Binary> screenshot;
+  if (request->include_screenshot && request->screenshot_bytes) {
+    screenshot = Binary::fromVector(std::move(*request->screenshot_bytes));
+  }
+
+  request->callback->sendSuccess(request->url, request->title,
+                                 std::move(viewport), std::move(elements),
+                                 std::move(screenshot), snapshot_token);
+}
