From 7d1186f19326ae48753cd4d28f45f5028d16f893 Mon Sep 17 00:00:00 2001
From: The browser Authors <noreply@browser.invalid>
Date: Sat, 19 Sep 2026 23:45:05 -0400
Subject: [PATCH 06/41] webgl-spoof

WebGL parameter/renderer spoof.
---
 .../webgl/webgl2_rendering_context_base.cc    | 40 +++++++++++++++--
 .../webgl/webgl_rendering_context_base.cc     | 43 ++++++++++++++++---
 2 files changed, 72 insertions(+), 11 deletions(-)

diff --git a/third_party/blink/renderer/modules/webgl/webgl2_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl2_rendering_context_base.cc
index 1e2b512f07..1acd6555f6 100644
--- a/third_party/blink/renderer/modules/webgl/webgl2_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl2_rendering_context_base.cc
@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/modules/webgl/webgl2_rendering_context_base.h"
 
+#include <atomic>
 #include <memory>
 
 #include "base/compiler_specific.h"
@@ -11,6 +12,7 @@
 #include "base/feature_list.h"
 #include "base/numerics/checked_math.h"
 #include "base/numerics/safe_conversions.h"
+#include "components/browser/browser_runtime.h"
 #include "gpu/command_buffer/client/gles2_interface.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/blink/public/platform/web_graphics_context_3d_provider.h"
@@ -4874,8 +4876,30 @@ ScriptValue WebGL2RenderingContextBase::getParameter(ScriptState* script_state,
       return GetInt64Parameter(script_state, pname);
     case GL_MAX_COMBINED_UNIFORM_BLOCKS:
       return GetIntParameter(script_state, pname);
-    case GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS:
-      return GetInt64Parameter(script_state, pname);
+    case GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS: {
+      // browser: stock does a single GetInteger64v IPC here. We mirror it
+      // so per-call timing matches even when spoofing; the extra IPC needed to
+      // recover MAX_VERTEX_UNIFORM_COMPONENTS for the delta math runs only on
+      // the first spoofed call and is cached for the lifetime of the process
+      // (GPU/ANGLE caps are constant after init). std::atomic guards the
+      // cache against worker-thread OffscreenCanvas WebGL2 contexts racing.
+      GLint64 combined = 0;
+      if (!isContextLost()) {
+        ContextGL()->GetInteger64v(GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS,
+                                   &combined);
+      }
+      const int spoofed_vectors = browser::SpoofedMaxVertexUniformVectors();
+      if (spoofed_vectors != 0) {
+        static std::atomic<GLint> cached_real_components{0};
+        GLint real = cached_real_components.load(std::memory_order_relaxed);
+        if (real == 0 && !isContextLost()) {
+          ContextGL()->GetIntegerv(GL_MAX_VERTEX_UNIFORM_COMPONENTS, &real);
+          cached_real_components.store(real, std::memory_order_relaxed);
+        }
+        combined += spoofed_vectors * 4 - real;
+      }
+      return WebGLAny(script_state, combined);
+    }
     case GL_MAX_DRAW_BUFFERS:
       return GetIntParameter(script_state, pname);
     case GL_MAX_ELEMENT_INDEX:
@@ -4914,8 +4938,16 @@ ScriptValue WebGL2RenderingContextBase::getParameter(ScriptState* script_state,
       return GetIntParameter(script_state, pname);
     case GL_MAX_VERTEX_UNIFORM_BLOCKS:
       return GetIntParameter(script_state, pname);
-    case GL_MAX_VERTEX_UNIFORM_COMPONENTS:
-      return GetIntParameter(script_state, pname);
+    case GL_MAX_VERTEX_UNIFORM_COMPONENTS: {
+      // browser: issue the underlying GetIntegerv IPC even when spoofing so
+      // per-call timing matches stock chromium.
+      ScriptValue real = GetIntParameter(script_state, pname);
+      const int spoofed_vectors = browser::SpoofedMaxVertexUniformVectors();
+      if (spoofed_vectors != 0) {
+        return WebGLAny(script_state, spoofed_vectors * 4);
+      }
+      return real;
+    }
     case GL_MIN_PROGRAM_TEXEL_OFFSET:
       return GetIntParameter(script_state, pname);
     case GL_PACK_ROW_LENGTH:
diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
