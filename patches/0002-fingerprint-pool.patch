+++ b/components/browser/webgpu_identity.h
@@ -0,0 +1,47 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Derives a WebGPU (vendor, architecture) pair from an ANGLE WebGL renderer
+// string, so that a renderer such as
+// "ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 (0x00002504) ...)" yields the
+// adapter.info tokens ("nvidia", "ampere") and the WebGPU spoof stays
+// consistent with the WebGL spoof under cross-API checks.
+//
+//   1. The ANGLE string is parsed by hand for the vendor name and the
+//      optional "(0x<DEVICE_ID>)" token.
+//   2. The ANGLE vendor maps to the public WebGPU vendor token (nvidia,
+//      intel, amd, apple, arm, qualcomm); "ati" aliases to "amd".
+//   3. Dawn's gpu_info database (embedded from data/dawn-gpu-info.json)
+//      maps (vendor, masked device ID) to a Dawn architecture name, whose
+//      public token is the lowercased, hyphenated form; NVIDIA's Lovelace
+//      is surfaced as "ada", as the WebGPU spec does.
+//   4. Without a device ID, or when the ID is unknown, a current-generation
+//      architecture for the vendor is used instead.
+
+#ifndef COMPONENTS_BROWSER_WEBGPU_IDENTITY_H_
+#define COMPONENTS_BROWSER_WEBGPU_IDENTITY_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+struct WebgpuIdentity {
+  std::string vendor;        // e.g. "nvidia", "intel", "amd"
+  std::string architecture;  // e.g. "ampere", "ada", "xe-lpg"
+};
+
+// Returns nullopt when `renderer` is not an ANGLE string or names a vendor
+// outside the known set (Mesa, llvmpipe, ...). Otherwise the architecture
+// is always filled in, from the Dawn database or the vendor's fallback.
+COMPONENT_EXPORT(BROWSER)
+std::optional<WebgpuIdentity> DeriveWebgpuFromRenderer(
+    std::string_view renderer);
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_WEBGPU_IDENTITY_H_
