@@ -85,6 +90,54 @@ BASE_FEATURE(kDeviceChangeRequiresPermission, base::FEATURE_ENABLED_BY_DEFAULT);
 
 namespace {
 
+// browser: device counts from --fingerprint-media ("mics,webcams,speakers",
+// "auto" or "seed:<N>"); nullopt when not spoofed.
+struct MediaDeviceSpoof {
+  uint32_t mics = 1;
+  uint32_t webcams = 1;
+  uint32_t speakers = 1;
+};
+
+const std::optional<MediaDeviceSpoof>& CachedMediaDeviceSpoof() {
+  static const std::optional<MediaDeviceSpoof> spoof =
+      browser::ResolveSwitch<std::optional<MediaDeviceSpoof>>(
+          switches::kFingerprintMedia,
+          [](const std::string& value)
+              -> std::optional<std::optional<MediaDeviceSpoof>> {
+            if (value.empty()) {
+              return std::nullopt;
+            }
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+            MediaDeviceSpoof result;
+            if (parts.size() >= 1) {
+              base::StringToUint(parts[0], &result.mics);
+            }
+            if (parts.size() >= 2) {
+              base::StringToUint(parts[1], &result.webcams);
+            }
+            if (parts.size() >= 3) {
+              base::StringToUint(parts[2], &result.speakers);
+            }
+            return result;
+          },
+          [](int32_t seed) -> std::optional<MediaDeviceSpoof> {
+            // Mics 1-3, webcams 0-2, speakers 1-3, with independent salts so
+            // the three do not move in lockstep.
+            return MediaDeviceSpoof{
+                1u + browser::DeterministicBucket(seed, browser::kSaltMediaMics,
+                                                  3),
+                browser::DeterministicBucket(seed, browser::kSaltMediaWebcams,
+                                             3),
+                1u + browser::DeterministicBucket(
+                         seed, browser::kSaltMediaSpeakers, 3)};
+          },
+          std::nullopt,
+          /*inherit_from_master_seed=*/false)
+          .value;
+  return spoof;
+}
+
 constexpr base::TimeDelta kEnumerateDevicesTimeout = base::Seconds(4);
 
 void SendLogMessage(const std::string& message) {
@@ -1487,6 +1540,31 @@ void MediaDevices::DevicesEnumerated(
   }
 
   ReportCompletedEnumerateDevices(result_contains_nonempty_input_device_ids);
+
+  // browser: with spoofed device counts, the list matches Chrome's
+  // pre-permission shape: at most one entry per kind with empty deviceId,
+  // label and groupId, in MediaDeviceType order (audioinput, videoinput,
+  // audiooutput). Counts act as booleans, because
+  // TranslateMediaDeviceInfoArray stops after the first entry per kind
+  // without permission.
+  if (const std::optional<MediaDeviceSpoof>& spoof = CachedMediaDeviceSpoof()) {
+    media_devices.clear();
+    if (spoof->mics > 0) {
+      media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+          String(""), String(""), String(""),
+          mojom::blink::MediaDeviceType::kMediaAudioInput));
+    }
+    if (spoof->webcams > 0) {
+      media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+          String(""), String(""), String(""),
+          mojom::blink::MediaDeviceType::kMediaVideoInput));
+    }
+    if (spoof->speakers > 0) {
+      media_devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+          String(""), String(""), String(""),
+          mojom::blink::MediaDeviceType::kMediaAudioOutput));
+    }
+  }
   result_tracker->Resolve(media_devices);
   tracer->End();
 }
