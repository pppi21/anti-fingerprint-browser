diff --git a/components/browser/embed_text.py b/components/browser/embed_text.py
new file mode 100644
index 0000000000..770186f883
--- /dev/null
+++ b/components/browser/embed_text.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+# Copyright 2026 The browser Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Generates a .cc that embeds a UTF-8 text file as a std::string_view.
+
+Called from a GN action() at build time. The generated .cc defines an extern
+matching a declaration in components/browser/embedded_data.h, so the
+embedding contract stays in a single header that consumers include.
+
+Usage:
+  embed_text.py --input <path> --output <path> --var <CamelCaseName>
+
+The generated symbol is `browser::k<CamelCaseName>` (std::string_view).
+"""
+
+import argparse
+import pathlib
+import sys
+
+
+# Delimiter of the C++ raw string literal R"<delim>(...)<delim>". The
+# content must not contain the sequence `)<delim>"`; this is checked below.
+DELIM = "BROWSER"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--input", required=True, help="Source text file")
+    ap.add_argument("--output", required=True, help="Generated .cc path")
+    ap.add_argument("--var", required=True,
+                    help="C++ symbol suffix (e.g. 'FingerprintsJsonl')")
+    args = ap.parse_args()
+
+    src = pathlib.Path(args.input)
+    data = src.read_text(encoding="utf-8")
+
+    sentinel = f"){DELIM}\""
+    if sentinel in data:
+        print(f"error: raw-string delimiter {DELIM!r} appears in {src} as "
+              f"{sentinel!r}; pick a different DELIM in embed_text.py",
+              file=sys.stderr)
+        return 1
+
+    out = pathlib.Path(args.output)
+    out.parent.mkdir(parents=True, exist_ok=True)
+
+    var = args.var
+    with out.open("w", encoding="utf-8", newline="\n") as f:
+        f.write("// Generated by components/browser/embed_text.py "
+                "- do not edit.\n")
+        f.write(f"// Source: {src.name}\n\n")
+        f.write('#include "components/browser/embedded_data.h"\n\n')
+        f.write("namespace browser {\n\n")
+        f.write("namespace {\n")
+        f.write(f"constexpr char k{var}Raw[] = R\"{DELIM}(\n")
+        f.write(data)
+        if not data.endswith("\n"):
+            f.write("\n")
+        f.write(f"){DELIM}\";\n")
+        f.write("}  // namespace\n\n")
+        # -1 to drop the trailing NUL that the char[] carries.
+        f.write(f"const std::string_view k{var}"
+                f"(k{var}Raw, sizeof(k{var}Raw) - 1);\n\n")
+        f.write("}  // namespace browser\n")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/components/browser/embedded_data.h b/components/browser/embedded_data.h
new file mode 100644
index 0000000000..6995943cd0
--- /dev/null
+++ b/components/browser/embedded_data.h
@@ -0,0 +1,33 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Build-time embedded copies of the data files under components/browser/data.
+// The consumers (fingerprint_pool.cc, webgpu_identity.cc) run in the
+// renderer, where the sandbox blocks file reads, so the data is compiled
+// into the binary instead of shipped next to it. The GN actions
+// embed_fingerprints_jsonl and embed_dawn_gpu_info_json run embed_text.py
+// to generate the definitions.
+
+#ifndef COMPONENTS_BROWSER_EMBEDDED_DATA_H_
+#define COMPONENTS_BROWSER_EMBEDDED_DATA_H_
+
+#include <string_view>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// Contents of data/fingerprints.jsonl: one JSON object per line, the first
+// being the {"_schemaVersion":1} marker.
+COMPONENT_EXPORT(BROWSER) extern const std::string_view kFingerprintsJsonl;
+
+// Contents of data/dawn-gpu-info.json, Dawn's gpu_info database keyed on
+// vendor, then device-ID group, then architecture name. webgpu_identity
+// uses it to map an ANGLE renderer string's device ID to a WebGPU
+// architecture token.
+COMPONENT_EXPORT(BROWSER) extern const std::string_view kDawnGpuInfoJson;
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_EMBEDDED_DATA_H_
diff --git a/components/browser/fingerprint_pool.cc b/components/browser/fingerprint_pool.cc
new file mode 100644
index 0000000000..a2f120ac3b
--- /dev/null
+++ b/components/browser/fingerprint_pool.cc
@@ -0,0 +1,120 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/fingerprint_pool.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/values.h"
+#include "components/browser/embedded_data.h"
+#include "components/browser/switch_resolver.h"
+
+namespace browser {
+
+namespace {
+
+// Each helper assigns only when the field is present with the right type,
+// leaving the profile's default otherwise.
+void AssignInt(const base::DictValue& dict, std::string_view key, int* out) {
+  if (std::optional<int> value = dict.FindInt(key)) {
+    *out = *value;
+  }
+}
+
+void AssignDouble(const base::DictValue& dict,
+                  std::string_view key,
+                  double* out) {
+  if (std::optional<double> value = dict.FindDouble(key)) {
+    *out = *value;
+  }
+}
+
+void AssignString(const base::DictValue& dict,
+                  std::string_view key,
+                  std::string* out) {
+  if (const std::string* value = dict.FindString(key)) {
+    *out = *value;
+  }
+}
+
+// Returns false for lines that are not profiles, such as the leading
+// {"_schemaVersion":1} marker; every profile carries a gpuVendor.
+bool ParseProfile(const base::DictValue& dict, FingerprintProfile* out) {
+  const std::string* vendor = dict.FindString("gpuVendor");
+  if (!vendor) {
+    return false;
+  }
+  out->gpu_vendor = *vendor;
+  AssignString(dict, "gpuRenderer", &out->gpu_renderer);
+  AssignInt(dict, "hardwareConcurrency", &out->hardware_concurrency);
+  AssignInt(dict, "deviceMemory", &out->device_memory);
+  AssignInt(dict, "screenWidth", &out->screen_width);
+  AssignInt(dict, "screenHeight", &out->screen_height);
+  AssignInt(dict, "availWidth", &out->avail_width);
+  AssignInt(dict, "availHeight", &out->avail_height);
+  AssignInt(dict, "availTop", &out->avail_top);
+  AssignInt(dict, "colorDepth", &out->color_depth);
+  out->device_pixel_ratio = dict.FindDouble("devicePixelRatio");
+  AssignInt(dict, "audioSampleRate", &out->audio_sample_rate);
+  AssignDouble(dict, "audioBaseLatency", &out->audio_base_latency);
+  AssignDouble(dict, "audioOutputLatency", &out->audio_output_latency);
+  AssignInt(dict, "audioMaxChannelCount", &out->audio_max_channel_count);
+  AssignString(dict, "deviceType", &out->device_type);
+  AssignString(dict, "prefersColorScheme", &out->prefers_color_scheme);
+  AssignString(dict, "colorGamut", &out->color_gamut);
+  return true;
+}
+
+std::vector<FingerprintProfile> LoadProfiles() {
+  std::vector<FingerprintProfile> profiles;
+  for (std::string_view line :
+       base::SplitStringPiece(kFingerprintsJsonl, "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::optional<base::DictValue> dict =
+        base::JSONReader::ReadDict(line, base::JSON_PARSE_RFC);
+    if (!dict) {
+      continue;
+    }
+    FingerprintProfile profile;
+    if (ParseProfile(*dict, &profile)) {
+      profiles.push_back(std::move(profile));
+    }
+  }
+  VLOG(1) << "browser: loaded " << profiles.size()
+          << " fingerprint profiles from embedded data";
+  return profiles;
+}
+
+const std::vector<FingerprintProfile>& Profiles() {
+  static const base::NoDestructor<std::vector<FingerprintProfile>> profiles(
+      LoadProfiles());
+  return *profiles;
+}
+
+}  // namespace
+
+const FingerprintProfile* ProfileForSeed(int32_t seed) {
+  const std::vector<FingerprintProfile>& pool = Profiles();
+  if (pool.empty()) {
+    return nullptr;
+  }
+  const uint32_t index = DeterministicBucket(
+      seed, kSaltProfilePick, static_cast<uint32_t>(pool.size()));
+  return &pool[index];
+}
+
+const FingerprintProfile* ActiveProfile() {
+  static const FingerprintProfile* const picked = ProfileForSeed(MasterSeed());
+  return picked;
+}
+
+}  // namespace browser
diff --git a/components/browser/fingerprint_pool.h b/components/browser/fingerprint_pool.h
new file mode 100644
index 0000000000..92444baa1b
--- /dev/null
+++ b/components/browser/fingerprint_pool.h
@@ -0,0 +1,76 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Coherent per-profile fingerprint data from
+// components/browser/data/fingerprints.jsonl, embedded in the binary at
+// build time (see embedded_data.h) because the renderer sandbox blocks file
+// I/O.
+//
+// Switches that derive their value from the seed read coupled fields off
+// one profile, so the spoofed identity stays internally consistent: a GPU
+// renderer string naming an RTX 4070 Ti is paired with a plausible screen,
+// RAM, core count and so on, instead of independently sampled values.
+//
+// The pool is parsed once on first use and cached for the process lifetime.
+
+#ifndef COMPONENTS_BROWSER_FINGERPRINT_POOL_H_
+#define COMPONENTS_BROWSER_FINGERPRINT_POOL_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// The subset of the JSONL schema that consumers read. Other fields (media
+// device counts, the generator's seed) are ignored.
+struct FingerprintProfile {
+  // WebGL UNMASKED_VENDOR_WEBGL / UNMASKED_RENDERER_WEBGL.
+  std::string gpu_vendor;
+  std::string gpu_renderer;
+
+  // navigator.hardwareConcurrency and navigator.deviceMemory (GB).
+  int hardware_concurrency = 0;
+  int device_memory = 0;
+
+  // Screen geometry. The pixel ratio is applied through the forced
+  // device-scale-factor pipeline, so it is optional.
+  int screen_width = 0;
+  int screen_height = 0;
+  int avail_width = 0;
+  int avail_height = 0;
+  int avail_top = 0;
+  int color_depth = 0;
+  std::optional<double> device_pixel_ratio;
+
+  // AudioContext properties.
+  int audio_sample_rate = 0;
+  double audio_base_latency = 0.0;
+  double audio_output_latency = 0.0;
+  int audio_max_channel_count = 0;
+
+  // "desktop" or "laptop". Battery derivation branches on it: desktops are
+  // always plugged in and full, laptops sample a charge state.
+  std::string device_type;
+
+  // CSS media-feature defaults.
+  std::string prefers_color_scheme;  // "light" / "dark" / "no-preference"
+  std::string color_gamut;           // "srgb" / "p3" / "rec2020"
+};
+
+// Returns the profile picked deterministically from `seed`, or nullptr if
+// the pool is empty. Derive callbacks call this with the seed they are
+// given, so a per-switch "seed:<N>" picks the matching profile even when N
+// differs from the master seed. The pick is one hash and an index.
+COMPONENT_EXPORT(BROWSER)
+const FingerprintProfile* ProfileForSeed(int32_t seed);
+
+// ProfileForSeed(MasterSeed()), cached after the first call.
+COMPONENT_EXPORT(BROWSER) const FingerprintProfile* ActiveProfile();
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_FINGERPRINT_POOL_H_
diff --git a/components/browser/webgpu_identity.cc b/components/browser/webgpu_identity.cc
new file mode 100644
index 0000000000..3d6e3b631c
--- /dev/null
+++ b/components/browser/webgpu_identity.cc
@@ -0,0 +1,277 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/webgpu_identity.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/browser/embedded_data.h"
+
+namespace browser {
+
+namespace {
+
+// ANGLE vendor name (lowercase) to public WebGPU vendor token.
+struct VendorToken {
+  std::string_view angle_vendor;
+  std::string_view token;
+};
+constexpr VendorToken kVendorTokens[] = {
+    {"nvidia", "nvidia"},     {"intel", "intel"}, {"amd", "amd"},
+    {"ati", "amd"},           {"apple", "apple"}, {"arm", "arm"},
+    {"qualcomm", "qualcomm"},
+};
+
+// Architecture reported when the device ID is absent or unknown.
+struct FallbackArchitecture {
+  std::string_view token;
+  std::string_view architecture;
+};
+constexpr FallbackArchitecture kFallbackArchitectures[] = {
+    {"nvidia", "ampere"},  {"intel", "xe-lpg"}, {"amd", "rdna-3"},
+    {"apple", "common-3"}, {"arm", "valhall"},  {"qualcomm", "adreno-7xx"},
+};
+
+struct AngleRenderer {
+  std::string vendor;  // as written by ANGLE, e.g. "NVIDIA", "Intel"
+  std::optional<uint64_t> device_id;
+};
+
+// Parses "ANGLE (<vendor>, <description> (0x<hex>) ...)". Returns nullopt
+// unless the string starts with "ANGLE (" and has a non-empty vendor. The
+// vendor runs up to the first comma; the device ID is the first "(0x<hex>)"
+// token after it, if any.
+std::optional<AngleRenderer> ParseAngleRenderer(std::string_view renderer) {
+  std::string_view rest =
+      base::TrimWhitespaceASCII(renderer, base::TRIM_LEADING);
+  if (!base::StartsWith(rest, "ANGLE")) {
+    return std::nullopt;
+  }
+  rest = base::TrimWhitespaceASCII(rest.substr(5), base::TRIM_LEADING);
+  if (!base::StartsWith(rest, "(")) {
+    return std::nullopt;
+  }
+  rest = rest.substr(1);
+
+  std::string_view vendor;
+  std::string_view after_comma;
+  const size_t comma = rest.find(',');
+  if (comma == std::string_view::npos) {
+    vendor = rest;
+    if (base::EndsWith(vendor, ")")) {
+      vendor.remove_suffix(1);
+    }
+  } else {
+    vendor = rest.substr(0, comma);
+    after_comma = rest.substr(comma + 1);
+  }
+  vendor = base::TrimWhitespaceASCII(vendor, base::TRIM_ALL);
+  if (vendor.empty()) {
+    return std::nullopt;
+  }
+
+  std::optional<uint64_t> device_id;
+  const size_t open = after_comma.find("(0x");
+  if (open != std::string_view::npos) {
+    const size_t hex_start = open + 3;
+    size_t hex_end = hex_start;
+    while (hex_end < after_comma.size() &&
+           base::IsHexDigit(after_comma[hex_end])) {
+      ++hex_end;
+    }
+    uint64_t parsed = 0;
+    if (hex_end > hex_start && hex_end < after_comma.size() &&
+        after_comma[hex_end] == ')' &&
+        base::HexStringToUInt64(
+            after_comma.substr(hex_start, hex_end - hex_start), &parsed)) {
+      device_id = parsed;
+    }
+  }
+  return AngleRenderer{std::string(vendor), device_id};
+}
+
+std::string_view VendorTokenFor(std::string_view angle_vendor) {
+  const std::string lower = base::ToLowerASCII(angle_vendor);
+  for (const VendorToken& entry : kVendorTokens) {
+    if (lower == entry.angle_vendor) {
+      return entry.token;
+    }
+  }
+  return {};
+}
+
+std::string_view FallbackArchitectureFor(std::string_view token) {
+  for (const FallbackArchitecture& entry : kFallbackArchitectures) {
+    if (token == entry.token) {
+      return entry.architecture;
+    }
+  }
+  return {};
+}
+
+// Dawn names architectures in title case with spaces ("Ampere", "Gen 12 LP",
+// "Xe LPG"); adapter.info.architecture uses lowercase with hyphens. Lovelace
+// is the documented exception and is surfaced as "ada".
+std::string PublicArchitectureToken(std::string_view dawn_name) {
+  if (base::EqualsCaseInsensitiveASCII(dawn_name, "Lovelace")) {
+    return "ada";
+  }
+  std::string token = base::ToLowerASCII(dawn_name);
+  std::replace(token.begin(), token.end(), ' ', '-');
+  return token;
+}
+
+struct ArchitectureEntry {
+  std::string token;  // public form
+  std::vector<uint64_t> device_ids;
+};
+struct DeviceGroup {
+  uint64_t mask = 0;
+  std::vector<ArchitectureEntry> architectures;
+};
+struct VendorEntry {
+  std::string name;  // JSON key, lowercased
+  std::vector<DeviceGroup> groups;
+};
+struct DawnDatabase {
+  std::vector<VendorEntry> vendors;
+};
+
+// Dawn prefixes comment keys with an underscore.
+bool IsCommentKey(std::string_view key) {
+  return key.empty() || key.front() == '_';
+}
+
+// Parses one entry of a vendor's "devices" list: a mask plus an
+// "architecture" map from Dawn name to device-ID list. Returns nullopt when
+// the entry has no usable mask or no parseable IDs.
+std::optional<DeviceGroup> ParseDeviceGroup(const base::DictValue& dict) {
+  const std::string* mask = dict.FindString("mask");
+  const base::DictValue* architectures = dict.FindDict("architecture");
+  DeviceGroup group;
+  if (!mask || !architectures || !base::HexStringToUInt64(*mask, &group.mask)) {
+    return std::nullopt;
+  }
+  for (auto [arch_name, ids_value] : *architectures) {
+    const base::ListValue* ids = ids_value.GetIfList();
+    if (IsCommentKey(arch_name) || !ids) {
+      continue;
+    }
+    ArchitectureEntry architecture;
+    architecture.token = PublicArchitectureToken(arch_name);
+    for (const base::Value& id_value : *ids) {
+      const std::string* id = id_value.GetIfString();
+      uint64_t parsed = 0;
+      if (id && base::HexStringToUInt64(*id, &parsed)) {
+        architecture.device_ids.push_back(parsed);
+      }
+    }
+    if (!architecture.device_ids.empty()) {
+      group.architectures.push_back(std::move(architecture));
+    }
+  }
+  if (group.architectures.empty()) {
+    return std::nullopt;
+  }
+  return group;
+}
+
+DawnDatabase LoadDawnDatabase() {
+  DawnDatabase db;
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(kDawnGpuInfoJson, base::JSON_PARSE_RFC);
+  if (!root) {
+    LOG(ERROR) << "browser: embedded dawn-gpu-info.json parse failed";
+    return db;
+  }
+  const base::DictValue* vendors = root->FindDict("vendors");
+  if (!vendors) {
+    return db;
+  }
+
+  for (auto [vendor_name, vendor_value] : *vendors) {
+    const base::DictValue* vendor_dict = vendor_value.GetIfDict();
+    if (IsCommentKey(vendor_name) || !vendor_dict) {
+      continue;
+    }
+    VendorEntry vendor;
+    vendor.name = base::ToLowerASCII(vendor_name);
+
+    // Apple has no "devices" list because Metal exposes no device ID; the
+    // vendor then always resolves to its fallback architecture.
+    if (const base::ListValue* devices = vendor_dict->FindList("devices")) {
+      for (const base::Value& group_value : *devices) {
+        const base::DictValue* group_dict = group_value.GetIfDict();
+        std::optional<DeviceGroup> group =
+            group_dict ? ParseDeviceGroup(*group_dict) : std::nullopt;
+        if (group) {
+          vendor.groups.push_back(std::move(*group));
+        }
+      }
+    }
+    db.vendors.push_back(std::move(vendor));
+  }
+  return db;
+}
+
+const DawnDatabase& GetDawnDatabase() {
+  static const base::NoDestructor<DawnDatabase> db(LoadDawnDatabase());
+  return *db;
+}
+
+// Returns the public architecture token, or empty when nothing matches.
+std::string ArchitectureForDevice(std::string_view token, uint64_t device_id) {
+  for (const VendorEntry& vendor : GetDawnDatabase().vendors) {
+    if (vendor.name != token) {
+      continue;
+    }
+    for (const DeviceGroup& group : vendor.groups) {
+      const uint64_t masked = device_id & group.mask;
+      for (const ArchitectureEntry& architecture : group.architectures) {
+        if (std::ranges::find(architecture.device_ids, masked) !=
+            architecture.device_ids.end()) {
+          return architecture.token;
+        }
+      }
+    }
+    break;
+  }
+  return {};
+}
+
+}  // namespace
+
+std::optional<WebgpuIdentity> DeriveWebgpuFromRenderer(
+    std::string_view renderer) {
+  const std::optional<AngleRenderer> parsed = ParseAngleRenderer(renderer);
+  if (!parsed) {
+    return std::nullopt;
+  }
+  const std::string_view token = VendorTokenFor(parsed->vendor);
+  if (token.empty()) {
+    return std::nullopt;
+  }
+  std::string architecture;
+  if (parsed->device_id) {
+    architecture = ArchitectureForDevice(token, *parsed->device_id);
+  }
+  if (architecture.empty()) {
+    architecture = std::string(FallbackArchitectureFor(token));
+  }
+  return WebgpuIdentity{std::string(token), std::move(architecture)};
+}
+
+}  // namespace browser
