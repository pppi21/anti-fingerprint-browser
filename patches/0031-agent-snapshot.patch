+// browser: Page.resolveAgentNode.
+void PageHandler::ResolveAgentNode(
+    int agent_node_id,
+    std::unique_ptr<ResolveAgentNodeCallback> callback) {
+  auto it = agent_node_registry_.find(agent_node_id);
+  if (it == agent_node_registry_.end()) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+  const AgentNodeEntry entry = it->second;
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(entry.local_root);
+  service_manager::InterfaceProvider* remotes =
+      rfh && rfh->IsRenderFrameLive() ? rfh->GetRemoteInterfaces() : nullptr;
+  if (!remotes) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  // The proxy pointer is read before the Remote moves into the reply
+  // callback, which keeps the pipe alive until the reply. A dropped pipe
+  // still answers found=false instead of hanging.
+  blink::mojom::AgentSnapshotCollector* raw = collector.get();
+  raw->ResolveNode(
+      entry.dom_node_id,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&PageHandler::OnAgentNodeResolved,
+                         weak_factory_.GetWeakPtr(), std::move(callback),
+                         entry.local_root, std::move(collector)),
+          /*found=*/false, /*box=*/nullptr));
+}
+
+void PageHandler::OnAgentNodeResolved(
+    std::unique_ptr<ResolveAgentNodeCallback> callback,
+    GlobalRenderFrameHostId local_root_rfh_id,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    bool found,
+    blink::mojom::AgentElementBoxPtr box) {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(local_root_rfh_id);
+  if (!found || !box || !rfh || !rfh->IsRenderFrameLive() || !rfh->GetView()) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+
+  // Same composition as the capture path: the top-left goes through the
+  // frame's widget view (identity for the main frame, the true root
+  // transform for an OOPIF's child-frame view); width and height are kept.
+  auto* view = static_cast<RenderWidgetHostViewBase*>(rfh->GetView());
+  gfx::PointF top_left =
+      view->TransformPointToRootCoordSpaceF(gfx::PointF(box->x, box->y));
+  callback->sendSuccess(/*found=*/true, top_left.x(), top_left.y(), box->width,
+                        box->height);
+}
