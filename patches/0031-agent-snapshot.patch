+// browser: the overlay lives on the InputHandler of the same agent host.
+CdpCursorOverlay* PageHandler::GetCdpCursorOverlay() {
+  if (!host_) {
+    return nullptr;
+  }
+  auto* contents = WebContentsImpl::FromRenderFrameHostImpl(host_);
+  if (!contents) {
+    return nullptr;
+  }
+  auto agent_host = DevToolsAgentHost::GetOrCreateFor(contents);
+  if (!agent_host) {
+    return nullptr;
+  }
+  auto input_handlers = InputHandler::ForAgentHost(
+      static_cast<DevToolsAgentHostImpl*>(agent_host.get()));
+  if (input_handlers.empty()) {
+    return nullptr;
+  }
+  return input_handlers[0]->cursor_overlay();
+}
