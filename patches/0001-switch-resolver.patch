new file mode 100644
index 0000000000..a73550aa08
--- /dev/null
+++ b/components/browser/BUILD.gn
@@ -0,0 +1,73 @@
+# Copyright 2026 The browser Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Embeds data/fingerprints.jsonl as browser::kFingerprintsJsonl. The
+# renderer sandbox blocks file reads, so the pool has to live in the binary.
+# See embedded_data.h for the contract.
+action("embed_fingerprints_jsonl") {
+  script = "embed_text.py"
+  sources = [ "data/fingerprints.jsonl" ]
+  outputs = [ "$target_gen_dir/embedded_fingerprints_jsonl.cc" ]
+  args = [
+    "--input",
+    rebase_path(sources[0], root_build_dir),
+    "--output",
+    rebase_path(outputs[0], root_build_dir),
+    "--var",
+    "FingerprintsJsonl",
+  ]
+}
+
+# Same for data/dawn-gpu-info.json, which webgpu_identity reads in the
+# renderer when deriving adapter.info.{vendor,architecture}.
+action("embed_dawn_gpu_info_json") {
+  script = "embed_text.py"
+  sources = [ "data/dawn-gpu-info.json" ]
+  outputs = [ "$target_gen_dir/embedded_dawn_gpu_info_json.cc" ]
+  args = [
+    "--input",
+    rebase_path(sources[0], root_build_dir),
+    "--output",
+    rebase_path(outputs[0], root_build_dir),
+    "--var",
+    "DawnGpuInfoJson",
+  ]
+}
+
+component("browser_switches") {
+  sources = [
+    "audio_override.cc",
+    "audio_override.h",
+    "browser_runtime.cc",
+    "browser_runtime.h",
+    "browser_switches.cc",
+    "browser_switches.h",
+    "connection_override.cc",
+    "connection_override.h",
+    "default_voices.cc",
+    "default_voices.h",
+    "embedded_data.h",
+    "fingerprint_pool.cc",
+    "fingerprint_pool.h",
+    "font_bundles.cc",
+    "font_bundles.h",
+    "pref_names.h",
+    "switch_resolver.cc",
+    "switch_resolver.h",
+    "webgpu_identity.cc",
+    "webgpu_identity.h",
+    "webrtc_ip_spoofer.cc",
+    "webrtc_ip_spoofer.h",
+  ]
+  sources += get_target_outputs(":embed_fingerprints_jsonl")
+  sources += get_target_outputs(":embed_dawn_gpu_info_json")
+
+  defines = [ "IS_BROWSER_IMPL" ]
+
+  deps = [
+    ":embed_dawn_gpu_info_json",
+    ":embed_fingerprints_jsonl",
+    "//base",
+  ]
+}
diff --git a/components/browser/browser_switches.cc b/components/browser/browser_switches.cc
new file mode 100644
index 0000000000..b9b2f90a67
--- /dev/null
+++ b/components/browser/browser_switches.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/browser_switches.h"
+
+namespace switches {
+
+// Master seed driving every per-switch "auto" / absent-value derivation.
+// Accepts "auto" (a per-process random seed, pinned to an integer in the
+// browser process so children inherit it) or a 32-bit signed integer. When
+// absent, per-switch resolvers keep their stock behaviour. See
+// switch_resolver.h for the resolution rules.
+const char kFingerprintSeed[] = "fingerprint-seed";
+
+// Presence-only opt-out. The browser-defaults preset (telemetry off,
+// privacy-positive features; see browser::MaybeExpandBrowserDefaults) is
+// applied on every launch; this switch skips it so the browser behaves like
+// stock Chromium.
+const char kUseChromiumDefaults[] = "use-chromium-defaults";
+
+// Browser brand (e.g. "Chrome").
+const char kFingerprintBrand[] = "fingerprint-brand";
+
+// Browser major version (e.g. "145").
+const char kFingerprintBrandVersion[] = "fingerprint-brand-version";
+
+// Full browser version (e.g. "145.0.7309.92").
+const char kFingerprintBrandVersionLong[] = "fingerprint-brand-version-long";
+
+// WebGL UNMASKED_VENDOR_WEBGL string. Also selects the per-vendor parameter
+// quirks (e.g. MAX_VERTEX_UNIFORM_VECTORS).
+const char kFingerprintGpuVendor[] = "fingerprint-gpu-vendor";
+
+// WebGL UNMASKED_RENDERER_WEBGL string, normally an ANGLE renderer string.
+const char kFingerprintGpuRenderer[] = "fingerprint-gpu-renderer";
+
+// WebGPU adapter.info.vendor, using Dawn's public token vocabulary
+// ("nvidia", "intel", "amd", "apple", "arm", "qualcomm").
+const char kFingerprintWebgpuVendor[] = "fingerprint-webgpu-vendor";
+
+// WebGPU adapter.info.architecture ("ampere", "ada", "rdna-3", "xe-lpg", ...).
+const char kFingerprintWebgpuArchitecture[] = "fingerprint-webgpu-architecture";
+
+// navigator.deviceMemory in GB. The value is snapped to the set of values
+// stock Chromium can report.
+const char kFingerprintDeviceMemory[] = "fingerprint-device-memory";
+
+// navigator.hardwareConcurrency.
+const char kFingerprintHardwareConcurrency[] =
+    "fingerprint-hardware-concurrency";
+
+// Screen geometry:
+// "width,height,availWidth,availHeight,availTop,colorDepth[,devicePixelRatio]".
+const char kFingerprintScreen[] = "fingerprint-screen";
+
+// Window position on the screen: "x,y".
+const char kFingerprintScreenPosition[] = "fingerprint-screen-position";
+
+// Media device counts: "mics,webcams,speakers" (e.g. "1,1,3").
+const char kFingerprintMedia[] = "fingerprint-media";
+
+// Battery status: "charging,level,chargingTime,dischargingTime".
+const char kFingerprintBattery[] = "fingerprint-battery";
+
+// Network Information API: "effectiveType,downlink,rtt,saveData,type".
+const char kFingerprintConnection[] = "fingerprint-connection";
+
+// CSS media features:
+// "colorScheme,reducedMotion,contrast,forcedColors,colorGamut".
+const char kFingerprintMediaFeatures[] = "fingerprint-media-features";
+
+// IANA timezone (e.g. "America/New_York").
+const char kFingerprintTimezone[] = "fingerprint-timezone";
+
+// Geolocation: "latitude,longitude,accuracy".
+const char kFingerprintGeolocation[] = "fingerprint-geolocation";
+
+// history.length.
+const char kFingerprintHistoryLength[] = "fingerprint-history-length";
+
+// Forces the HTTP Accept-Language header to a fixed value (e.g. "en")
+// regardless of the language pref and of any ReduceAcceptLanguage
+// negotiation. Chrome stable sends a single-token header to most sites, so
+// without this the verbose "en-US,en;q=0.9" form stands out on the wire.
+// Only the header changes; navigator.languages stays pref-driven. Has no
+// effect while a font bundle is active, because the bundle owns the header.
+const char kFingerprintAcceptLanguage[] = "fingerprint-accept-language";
+
+// Seed selecting a font bundle and its derived Accept-Language /
+// navigator.languages. Any string; it is hashed to seed a PRNG. When set,
+// the browser loads .ttf/.ttc files exclusively from
+// <chrome.exe dir>/browser_fonts/<bundle>/ instead of the system collection.
+const char kBrowserFontBundle[] = "browser-font-bundle";
+
+// AudioContext properties:
+// "sampleRate,baseLatency,outputLatency,maxChannelCount".
+const char kFingerprintAudioContext[] = "fingerprint-audio-context";
+
+// Skia text rasterization override applied through RendererPreferences:
+// "gamma:<float>,contrast:<float>" (either or both). Windows only.
+const char kFingerprintTextRendering[] = "fingerprint-text-rendering";
+
+// Sub-pixel perturbation amplitude (float, e.g. "0.005") for Canvas 2D
+// curve-verb control points (bezierCurveTo, quadraticCurveTo, arc, arcTo,
+// ellipse). Line verbs, text, rects and other axis-aligned geometry are
+// untouched, so CPU-canvas output stays canonical while curves pick up the
+// per-profile variance seen across real GPUs.
+const char kCanvasCurveNoise[] = "canvas-curve-noise";
+
+// Multiplicative perturbation amplitude (float, e.g. "0.01") for Gaussian
+// blur sigmas (shadowBlur and ctx.filter = 'blur(...)'). Only applied on
+// GPU-accelerated canvases so willReadFrequently contexts stay canonical.
+// The value is the maximum fractional offset: 0.01 scales sigma by a
+// factor in [0.99, 1.01].
+const char kCanvasBlurNoise[] = "canvas-blur-noise";
+
+// Additive perturbation amplitude (float, e.g. "0.005") for Canvas 2D
+// gradient color-stop offsets. GPU-only, like the blur noise. Each stop
+// moves by up to +/- the value within the [0, 1] stop range.
+const char kCanvasGradientNoise[] = "canvas-gradient-noise";
+
+// Per-profile sub-LSB perturbation amplitude (float, e.g. "5e-6") for WebGL
+// fragment shaders. The GLSL source is rewritten at shaderSource() time so
+// transcendental functions, texture sampling coordinates, gl_FragCoord and
+// the final color pick up the noise before the shader reaches ANGLE.
+// Shaders made only of constants, uniform reads and flat-color writes pass
+// through unchanged. Because the rewrite happens in the shader itself,
+// readPixels output is consistent with what the shader computes.
+const char kWebglShaderNoise[] = "webgl-shader-noise";
+
+// Per-surface multiplier overrides for the shader-noise rewriter, as
+// comma-separated name=value pairs (e.g. "klg=0,kt=0.01"). Names are the
+// nd_k* suffixes: kt kt2 kp ke klg kl kn kr kx kss km kf kc. Unset names
+// keep their calibrated default; unknown names and malformed values are
+// ignored. A tuning aid, not derived from the fingerprint seed.
+const char kWebglShaderNoiseK[] = "webgl-shader-noise-k";
+
+// IPv4 address reported in WebRTC ICE candidates and SDP.
+const char kWebrtcIP4[] = "webrtc-ip4";
+
+// IPv6 address reported in WebRTC ICE candidates and SDP.
+const char kWebrtcIP6[] = "webrtc-ip6";
+
+// Comma-separated hosts (subdomains included) that may use the software
+// secure PlayReady CDM in addition to primevideo.com and amazon.com; "*"
+// allows every origin. Other origins see the EME answers of stock Chrome.
+const char kSoftwarePlayreadySites[] = "software-playready-sites";
+
+// Presence-only. Draws a cursor overlay while a DevTools client is attached.
+const char kShowCdpCursor[] = "show-cdp-cursor";
+
+// Presence-only. navigator.credentials.create() and .get() with a publicKey
+// option short-circuit in the browser process before any platform
+// authenticator UI (Windows Hello, Touch ID) appears. After a random 1-5 s
+// delay, mimicking a user dismissing the prompt, the request rejects with
+// NotAllowedError, the same DOMException a site sees after a real cancel.
+// isUserVerifyingPlatformAuthenticatorAvailable() and
+// isConditionalMediationAvailable() keep their truthful answers so the site
+// sees no inconsistency between "authenticator available" and "declined".
+const char kAutoDeclineWebauthn[] = "auto-decline-webauthn";
+
+}  // namespace switches
