 void LocationProviderManager::StartProvider(bool enable_high_accuracy) {
+  // browser: --fingerprint-geolocation ("latitude,longitude[,accuracy]")
+  // replaces the real providers with a single fixed position. The parser is
+  // spelled out here because services/device cannot depend on
+  // components/browser.
+  struct SpoofedPosition {
+    double latitude = 0;
+    double longitude = 0;
+    double accuracy = 100.0;
+  };
+  static const std::optional<SpoofedPosition> spoofed_position =
+      []() -> std::optional<SpoofedPosition> {
+    const std::string value =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "fingerprint-geolocation");
+    if (value.empty()) {
+      return std::nullopt;
+    }
+    std::vector<std::string> parts = base::SplitString(
+        value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    SpoofedPosition result;
+    if (parts.size() < 2 || !base::StringToDouble(parts[0], &result.latitude) ||
+        !base::StringToDouble(parts[1], &result.longitude)) {
+      return std::nullopt;
+    }
+    if (parts.size() >= 3) {
+      base::StringToDouble(parts[2], &result.accuracy);
+    }
+    return result;
+  }();
+  if (spoofed_position) {
+    is_running_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](LocationProviderManager* self, SpoofedPosition spoofed) {
+              auto position = mojom::Geoposition::New();
+              position->latitude = spoofed.latitude;
+              position->longitude = spoofed.longitude;
+              position->accuracy = spoofed.accuracy;
+              position->timestamp = base::Time::Now();
+              self->location_update_callback_.Run(
+                  self,
+                  mojom::GeopositionResult::NewPosition(std::move(position)));
+            },
+            base::Unretained(this), *spoofed_position));
+    return;
+  }
+
   // Ensure a provider is created successfully before starting.
   if (!InitializeProvider()) {
     // If no location providers are available, report a "Position Unavailable"
diff --git a/third_party/blink/renderer/core/geolocation/geolocation_coordinates.cc b/third_party/blink/renderer/core/geolocation/geolocation_coordinates.cc
index 4c5336c6a6..091307e761 100644
--- a/third_party/blink/renderer/core/geolocation/geolocation_coordinates.cc
+++ b/third_party/blink/renderer/core/geolocation/geolocation_coordinates.cc
@@ -25,15 +25,75 @@
 
 #include "third_party/blink/renderer/core/geolocation/geolocation_coordinates.h"
 
+#include <optional>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "components/browser/browser_switches.h"
 #include "third_party/blink/renderer/bindings/core/v8/v8_object_builder.h"
 
 namespace blink {
 
+namespace {
+
+// browser: --fingerprint-geolocation ("latitude,longitude[,accuracy]"),
+// parsed once per process. The position itself comes from the spoofed
+// provider in services/device; these getters make the values consistent
+// for any Coordinates object, whatever produced it. An accuracy of 0 or an
+// absent accuracy keeps the real value.
+struct GeoOverride {
+  double latitude = 0;
+  double longitude = 0;
+  double accuracy = 0;
+};
+
+const std::optional<GeoOverride>& GetGeoOverride() {
+  static const std::optional<GeoOverride> spoof =
+      []() -> std::optional<GeoOverride> {
+    const std::string value =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            switches::kFingerprintGeolocation);
+    if (value.empty()) {
+      return std::nullopt;
+    }
+    std::vector<std::string> parts = base::SplitString(
+        value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    GeoOverride result;
+    if (parts.size() < 2 || !base::StringToDouble(parts[0], &result.latitude) ||
+        !base::StringToDouble(parts[1], &result.longitude)) {
+      return std::nullopt;
+    }
+    if (parts.size() >= 3) {
+      base::StringToDouble(parts[2], &result.accuracy);
+    }
+    return result;
+  }();
+  return spoof;
+}
+
+}  // namespace
+
+double GeolocationCoordinates::latitude() const {
+  const std::optional<GeoOverride>& spoof = GetGeoOverride();
+  return spoof ? spoof->latitude : latitude_;
+}
+
+double GeolocationCoordinates::longitude() const {
+  const std::optional<GeoOverride>& spoof = GetGeoOverride();
+  return spoof ? spoof->longitude : longitude_;
+}
+
+double GeolocationCoordinates::accuracy() const {
+  const std::optional<GeoOverride>& spoof = GetGeoOverride();
+  return spoof && spoof->accuracy > 0 ? spoof->accuracy : accuracy_;
+}
+
 ScriptObject GeolocationCoordinates::toJSON(ScriptState* script_state) const {
   V8ObjectBuilder builder(script_state);
-  builder.AddNumber("accuracy", accuracy_);
-  builder.AddNumber("latitude", latitude_);
-  builder.AddNumber("longitude", longitude_);
+  builder.AddNumber("accuracy", accuracy());
+  builder.AddNumber("latitude", latitude());
+  builder.AddNumber("longitude", longitude());
   builder.AddNumberOrNull("altitude", altitude_);
   builder.AddNumberOrNull("altitudeAccuracy", altitude_accuracy_);
   builder.AddNumberOrNull("heading", heading_);
