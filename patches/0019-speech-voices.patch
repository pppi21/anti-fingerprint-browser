diff --git a/components/browser/default_voices.h b/components/browser/default_voices.h
new file mode 100644
index 0000000000..5a19686e67
--- /dev/null
+++ b/components/browser/default_voices.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BROWSER_DEFAULT_VOICES_H_
+#define COMPONENTS_BROWSER_DEFAULT_VOICES_H_
+
+#include "base/component_export.h"
+#include "base/containers/span.h"
+
+namespace browser {
+
+// One speechSynthesis.getVoices() entry. Chrome reports voiceURI equal to
+// the name, so one field serves both.
+struct DefaultVoiceEntry {
+  const char* name;
+  const char* lang;  // BCP 47 tag, e.g. "en-US"
+  bool is_local;     // false for Google network voices
+  bool is_default;
+};
+
+// The local voices reported in place of the real OS voice list.
+COMPONENT_EXPORT(BROWSER)
+base::span<const DefaultVoiceEntry> DefaultLocalVoices();
+
+// The Google network voices, appended while the brand spoof is active so a
+// Chrome-branded build lists them the way Chrome does.
+COMPONENT_EXPORT(BROWSER)
+base::span<const DefaultVoiceEntry> GoogleRemoteVoices();
+
+// Speaking rate of the simulated synthesizer, in characters per second, for
+// timing the synthetic end event.
+inline constexpr float kFakeSpeechCharsPerSecond = 12.5f;
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_DEFAULT_VOICES_H_
