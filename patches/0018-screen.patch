 namespace blink {
 
+namespace {
+
+// browser: the screen geometry reported to pages, resolved once per process
+// from --fingerprint-screen
+// ("width,height,availWidth,availHeight,availTop,colorDepth[,dpr]", "auto"
+// or "seed:<N>"). The seventh field, devicePixelRatio, is applied through
+// the forced device-scale-factor pipeline in ui/display/display.cc so
+// layout picks it up too; nullopt when not spoofed.
+struct ScreenOverride {
+  int width = 0;
+  int height = 0;
+  int avail_width = 0;
+  int avail_height = 0;
+  int avail_top = 0;
+  int color_depth = 0;
+};
+
+const std::optional<ScreenOverride>& GetScreenOverride() {
+  static const std::optional<ScreenOverride> spoof =
+      browser::ResolveSwitch<std::optional<ScreenOverride>>(
+          ::switches::kFingerprintScreen,
+          [](const std::string& value)
+              -> std::optional<std::optional<ScreenOverride>> {
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+            if (parts.size() < 6 || parts.size() > 7) {
+              return std::nullopt;
+            }
+            ScreenOverride result;
+            if (!base::StringToInt(parts[0], &result.width) ||
+                !base::StringToInt(parts[1], &result.height) ||
+                !base::StringToInt(parts[2], &result.avail_width) ||
+                !base::StringToInt(parts[3], &result.avail_height) ||
+                !base::StringToInt(parts[4], &result.avail_top) ||
+                !base::StringToInt(parts[5], &result.color_depth)) {
+              return std::nullopt;
+            }
+            return result;
+          },
+          [](int32_t seed) -> std::optional<ScreenOverride> {
+            const browser::FingerprintProfile* profile =
+                browser::ProfileForSeed(seed);
+            if (!profile) {
+              return std::nullopt;
+            }
+            return ScreenOverride{profile->screen_width, profile->screen_height,
+                                  profile->avail_width,  profile->avail_height,
+                                  profile->avail_top,    profile->color_depth};
+          },
+          std::nullopt,
+          /*inherit_from_master_seed=*/false)
+          .value;
+  return spoof;
+}
+
+}  // namespace
+
