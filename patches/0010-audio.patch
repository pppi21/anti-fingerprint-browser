   std::optional<uint32_t> render_quantum_frames = 128;
   if (RuntimeEnabledFeatures::WebAudioConfigurableRenderQuantumEnabled(
@@ -1242,17 +1248,24 @@ double AudioContext::baseLatency() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(main_thread_sequence_checker_);
   DCHECK(destinationNode());
 
-  return base_latency_;
+  // browser: the spoofed latency replaces the real one.
+  const browser::AudioOverride& spoof = browser::GetAudioOverride();
+  return spoof.active ? spoof.base_latency : base_latency_;
 }
 
 double AudioContext::outputLatency() const {
+  // browser: the stock path runs in full even when spoofing, because the
+  // lock acquisition dominates this getter's timing.
   DCHECK_CALLED_ON_VALID_SEQUENCE(main_thread_sequence_checker_);
   DCHECK(destinationNode());
 
   DeferredTaskHandler::GraphAutoLocker locker(GetDeferredTaskHandler());
 
   double factor = GetOutputLatencyQuantizingFactor();
-  return std::round(output_position_.hardware_output_latency / factor) * factor;
+  const double real =
+      std::round(output_position_.hardware_output_latency / factor) * factor;
+  const browser::AudioOverride& spoof = browser::GetAudioOverride();
+  return spoof.active ? spoof.output_latency : real;
 }
 
 AudioPlaybackStats* AudioContext::playbackStats() {
