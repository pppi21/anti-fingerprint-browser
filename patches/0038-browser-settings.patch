+ public:
+  explicit BrowserSettingsUI(content::WebUI* web_ui);
+  BrowserSettingsUI(const BrowserSettingsUI&) = delete;
+  BrowserSettingsUI& operator=(const BrowserSettingsUI&) = delete;
+  ~BrowserSettingsUI() override;
+};
