--- /dev/null
+++ b/components/browser/audio_override.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/audio_override.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/fingerprint_pool.h"
+#include "components/browser/switch_resolver.h"
+
+namespace browser {
+
+namespace {
+
+constexpr AudioOverride kInactive;
+
+// "sampleRate,baseLatency,outputLatency,maxChannelCount".
+std::optional<AudioOverride> ParseExplicit(const std::string& value) {
+  std::vector<std::string> parts = base::SplitString(
+      value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() != 4) {
+    return std::nullopt;
+  }
+  double sample_rate = 0.0;
+  double base_latency = 0.0;
+  double output_latency = 0.0;
+  unsigned max_channel_count = 0;
+  if (!base::StringToDouble(parts[0], &sample_rate) ||
+      !base::StringToDouble(parts[1], &base_latency) ||
+      !base::StringToDouble(parts[2], &output_latency) ||
+      !base::StringToUint(parts[3], &max_channel_count)) {
+    return std::nullopt;
+  }
+  return AudioOverride{true, static_cast<float>(sample_rate), base_latency,
+                       output_latency, max_channel_count};
+}
+
+AudioOverride DeriveFromSeed(int32_t seed) {
+  const FingerprintProfile* profile = ProfileForSeed(seed);
+  if (!profile) {
+    return kInactive;
+  }
+  return AudioOverride{true, static_cast<float>(profile->audio_sample_rate),
+                       profile->audio_base_latency,
+                       profile->audio_output_latency,
+                       static_cast<uint32_t>(profile->audio_max_channel_count)};
+}
+
+}  // namespace
+
+const AudioOverride& GetAudioOverride() {
+  static const AudioOverride resolved =
+      ResolveSwitch<AudioOverride>(switches::kFingerprintAudioContext,
+                                   ParseExplicit, DeriveFromSeed, kInactive)
+          .value;
+  return resolved;
+}
+
+}  // namespace browser
diff --git a/components/browser/audio_override.h b/components/browser/audio_override.h
new file mode 100644
index 0000000000..8749f8a618
--- /dev/null
+++ b/components/browser/audio_override.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BROWSER_AUDIO_OVERRIDE_H_
+#define COMPONENTS_BROWSER_AUDIO_OVERRIDE_H_
+
+#include <cstdint>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// The AudioContext properties reported to pages: sampleRate, baseLatency,
+// outputLatency and destination.maxChannelCount. Resolved once per process
+// from --fingerprint-audio-context (explicit, "auto", "seed:<N>" or inherited
+// from --fingerprint-seed; see switch_resolver.h); `active` is false when
+// nothing is spoofed.
+struct AudioOverride {
+  bool active = false;
+  float sample_rate = 0.0f;
+  double base_latency = 0.0;
+  double output_latency = 0.0;
+  uint32_t max_channel_count = 0;
+};
+
+COMPONENT_EXPORT(BROWSER) const AudioOverride& GetAudioOverride();
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_AUDIO_OVERRIDE_H_
