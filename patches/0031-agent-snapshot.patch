+// browser: state of one Page.captureAgentSnapshot call. Ref-counted so it
+// survives the per-frame Mojo replies, the occlusion hit-tests and the
+// screenshot capture, which complete through separate BarrierClosures.
+struct PageHandler::AgentSnapshotRequest
+    : public base::RefCounted<PageHandler::AgentSnapshotRequest> {
+  // One entry per live RenderFrameHost in the page (main frame + every OOPIF).
+  struct FrameEntry {
+    base::WeakPtr<RenderFrameHostImpl> rfh;
+    std::string frame_id;
+    // The frame's widget view. For OOPIFs this is a
+    // RenderWidgetHostViewChildFrame that knows how to transform its local
+    // coordinates to the root; for same-process subframes it is the root view.
+    raw_ptr<RenderWidgetHostViewBase> view = nullptr;
+    blink::mojom::AgentFrameSnapshotPtr snapshot;
+  };
+
+  // An element composed into root-viewport CSS px, kept in this form until
+  // the async hit-test has set `obscured` and the token has been hashed.
+  struct ComposedElement {
+    int backend_node_id = 0;
+    // The local-root RenderFrameHost this element was collected from; with
+    // backend_node_id (the renderer's DOMNodeId) it is what resolveAgentNode
+    // needs to find the element again.
+    GlobalRenderFrameHostId local_root_rfh_id;
+    std::string frame_id;
+    std::string role;
+    std::optional<std::string> name;
+    std::optional<std::string> value;
+    std::optional<std::string> description;
+    std::string tag;
+    bool interactive = false;
+    std::optional<std::string> interactive_reason;
+    std::vector<std::string> states;
+    double x = 0;
+    double y = 0;
+    double width = 0;
+    double height = 0;
+    bool in_viewport = false;
+    bool obscured = false;
+    std::optional<int> shadow_host_backend_node_id;
+    // Resolved absolute URL the element points at, when it has one.
+    std::optional<std::string> href;
+    std::optional<std::string> src;
+    // The widget view that owns this element; compared against the hit-test
+    // result to decide cross-context occlusion.
+    raw_ptr<RenderWidgetHostViewBase> element_view = nullptr;
+    // Action point (root DIP == root CSS px at scale 1) used for the hit-test.
+    gfx::PointF action_point_root;
+  };
+
+  AgentSnapshotRequest() = default;
+
+  std::unique_ptr<CaptureAgentSnapshotCallback> callback;
+  PageHandler::BitmapEncoder encoder;
+  bool include_screenshot = true;
+  blink::mojom::AgentOffscreenMode offscreen_mode =
+      blink::mojom::AgentOffscreenMode::kSummary;
+
+  std::vector<FrameEntry> frames;
+  // Keeps the per-frame Mojo remotes alive until every reply (or disconnect)
+  // has been observed.
+  std::vector<mojo::Remote<blink::mojom::AgentSnapshotCollector>> collectors;
+
+  std::vector<ComposedElement> composed;
+
+  // Captured viewport metrics (root-frame CSS px).
+  std::string url;
+  std::string title;
+  double vp_width = 0;
+  double vp_height = 0;
+  double device_scale_factor = 1;
+  double scroll_x = 0;
+  double scroll_y = 0;
+  double scroll_width = 0;
+  double scroll_height = 0;
+
+  // Fans occlusion and screenshot completion into FinishAgentSnapshot.
+  base::RepeatingClosure finish_barrier;
+  // The screenshot stays unencoded until FinishAgentSnapshot, which draws the
+  // marks once occlusion has decided which elements get one.
+  base::ScopedClosureRunner capturer_handle;
+  SkBitmap screenshot_bitmap;
+  std::optional<std::vector<uint8_t>> screenshot_bytes;
+
+ private:
+  friend class base::RefCounted<PageHandler::AgentSnapshotRequest>;
+  ~AgentSnapshotRequest() = default;
+};
