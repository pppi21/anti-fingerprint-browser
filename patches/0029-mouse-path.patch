diff --git a/content/common/input/synthetic_mouse_path_gesture.cc b/content/common/input/synthetic_mouse_path_gesture.cc
new file mode 100644
index 0000000000..eb17c82add
--- /dev/null
+++ b/content/common/input/synthetic_mouse_path_gesture.cc
@@ -0,0 +1,97 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/common/input/synthetic_mouse_path_gesture.h"
+
+#include <algorithm>
+
+#include "base/check_op.h"
+#include "content/common/input/input_injector.mojom-shared.h"
+
+namespace content {
+
+SyntheticMousePathGesture::SyntheticMousePathGesture(
+    const SyntheticMousePathGestureParams& gesture_params)
+    : SyntheticGestureBase(gesture_params) {
+  CHECK_EQ(SyntheticGestureParams::MOUSE_PATH_GESTURE,
+           gesture_params.GetGestureType());
+  CHECK(!gesture_params.positions.empty());
+}
+
+SyntheticMousePathGesture::~SyntheticMousePathGesture() = default;
+
+SyntheticGesture::Result SyntheticMousePathGesture::ForwardInputEvents(
+    const base::TimeTicks& timestamp,
+    SyntheticGestureTarget* target) {
+  CHECK(dispatching_controller_);
+  const base::WeakPtr<SyntheticGestureController> weak_controller =
+      dispatching_controller_;
+
+  if (!pointer_driver_) {
+    pointer_driver_ = SyntheticPointerDriver::Create(
+        content::mojom::GestureSourceType::kMouseInput,
+        params().from_devtools_debugger);
+  }
+
+  const auto& positions = params().positions;
+  const base::TimeDelta interval = params().polling_interval;
+
+  if (!started_) {
+    // The first position goes out immediately.
+    started_ = true;
+    gesture_start_time_ = timestamp;
+    DispatchMove(0, target);
+    if (!weak_controller) {
+      return SyntheticGesture::GESTURE_ABORT;
+    }
+    current_index_ = 1;
+    return positions.size() == 1 ? SyntheticGesture::GESTURE_FINISHED
+                                 : SyntheticGesture::GESTURE_RUNNING;
+  }
+
+  // Every position whose time has come is dispatched now, each stamped with
+  // its own nominal time on the polling grid.
+  const base::TimeDelta elapsed = timestamp - gesture_start_time_;
+  const size_t due =
+      std::min(positions.size(), static_cast<size_t>(elapsed / interval) + 1);
+  while (current_index_ < due) {
+    DispatchMove(current_index_, target);
+    if (!weak_controller) {
+      return SyntheticGesture::GESTURE_ABORT;
+    }
+    current_index_++;
+  }
+  return current_index_ >= positions.size() ? SyntheticGesture::GESTURE_FINISHED
+                                            : SyntheticGesture::GESTURE_RUNNING;
+}
+
+void SyntheticMousePathGesture::DispatchMove(size_t index,
+                                             SyntheticGestureTarget* target) {
+  // A held button rides on every move: SyntheticMouseDriverBase::Move turns
+  // it into the event's button modifiers, which the renderer reports as
+  // `buttons`.
+  const SyntheticMousePathGestureParams::Position& position =
+      params().positions[index];
+  pointer_driver_->Move(position.x, position.y, /*index=*/0,
+                        /*key_modifiers=*/0, /*width=*/1.f, /*height=*/1.f,
+                        /*rotation_angle=*/0.f, /*force=*/1.f,
+                        /*tangential_pressure=*/0.f, /*tilt_x=*/0, /*tilt_y=*/0,
+                        params().button);
+  pointer_driver_->DispatchEvent(
+      target, gesture_start_time_ + params().polling_interval * index);
+}
+
+void SyntheticMousePathGesture::WaitForTargetAck(
+    base::OnceClosure callback,
+    SyntheticGestureTarget* target) const {
+  target->WaitForTargetAck(params().GetGestureType(),
+                           content::mojom::GestureSourceType::kMouseInput,
+                           std::move(callback));
+}
+
+bool SyntheticMousePathGesture::AllowHighFrequencyDispatch() const {
+  return true;
+}
+
+}  // namespace content
