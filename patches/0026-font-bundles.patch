+// a FilteredDWriteFactory whose system-font queries serve a collection built
+// from those paths.
+FilteredFontPathsProvider& GetFilteredFontPathsProvider() {
+  static base::NoDestructor<FilteredFontPathsProvider> provider;
+  return *provider;
+}
+
+// Builds a collection containing only the fonts at |paths|, without the
+// system fonts merged in. Returns null on failure.
+Microsoft::WRL::ComPtr<IDWriteFontCollection1> BuildFilteredFontCollection(
+    IDWriteFactory3* factory,
+    const std::vector<base::FilePath>& paths) {
+  Microsoft::WRL::ComPtr<IDWriteFontSetBuilder> set_builder;
+  HRESULT hr = factory->CreateFontSetBuilder(&set_builder);
+  if (FAILED(hr)) {
+    return nullptr;
+  }
+  for (const base::FilePath& path : paths) {
+    Microsoft::WRL::ComPtr<IDWriteFontFile> file;
+    if (FAILED(factory->CreateFontFileReference(path.value().c_str(), nullptr,
+                                                &file))) {
+      continue;
+    }
+    BOOL supported = FALSE;
+    DWRITE_FONT_FILE_TYPE file_type;
+    UINT32 n_fonts = 0;
+    if (FAILED(file->Analyze(&supported, &file_type, nullptr, &n_fonts)) ||
+        !supported) {
+      continue;
+    }
+    for (UINT32 i = 0; i < n_fonts; ++i) {
+      Microsoft::WRL::ComPtr<IDWriteFontFaceReference> face;
+      if (FAILED(factory->CreateFontFaceReference(
+              file.Get(), i, DWRITE_FONT_SIMULATIONS_NONE, &face))) {
+        continue;
+      }
+      set_builder->AddFontFaceReference(face.Get());
+    }
+  }
+  Microsoft::WRL::ComPtr<IDWriteFontSet> set;
+  if (FAILED(set_builder->CreateFontSet(&set))) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IDWriteFontCollection1> collection;
+  if (FAILED(
+          factory->CreateFontCollectionFromFontSet(set.Get(), &collection))) {
+    return nullptr;
+  }
+  return collection;
+}
+
+// Builds a fallback that only maps to families present in |collection|: a
+// single mapping over all of Unicode lists every family name, and DirectWrite
+// picks the first one supporting the character.
+Microsoft::WRL::ComPtr<IDWriteFontFallback> BuildFilteredFontFallback(
+    IDWriteFactory2* factory2,
+    IDWriteFontCollection* collection) {
+  if (!factory2 || !collection) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IDWriteFontFallbackBuilder> builder;
+  if (FAILED(factory2->CreateFontFallbackBuilder(&builder))) {
+    return nullptr;
+  }
+  UINT32 family_count = collection->GetFontFamilyCount();
+  std::vector<std::wstring> family_name_storage;
+  std::vector<const WCHAR*> family_name_ptrs;
+  family_name_storage.reserve(family_count);
+  family_name_ptrs.reserve(family_count);
+  for (UINT32 i = 0; i < family_count; ++i) {
+    Microsoft::WRL::ComPtr<IDWriteFontFamily> family;
+    if (FAILED(collection->GetFontFamily(i, &family))) {
+      continue;
+    }
+    Microsoft::WRL::ComPtr<IDWriteLocalizedStrings> names;
+    if (FAILED(family->GetFamilyNames(&names))) {
+      continue;
+    }
+    UINT32 len = 0;
+    if (FAILED(names->GetStringLength(0, &len))) {
+      continue;
+    }
+    std::wstring name(len + 1, L'\0');
+    if (FAILED(names->GetString(0, name.data(), len + 1))) {
+      continue;
+    }
+    name.resize(len);
+    family_name_storage.push_back(std::move(name));
+    family_name_ptrs.push_back(family_name_storage.back().c_str());
+  }
+  DWRITE_UNICODE_RANGE range{0x0000, 0x10FFFF};
+  HRESULT hr = builder->AddMapping(
+      &range, 1, family_name_ptrs.data(),
+      static_cast<UINT32>(family_name_ptrs.size()), collection,
+      /*localeName=*/nullptr, /*baseFamilyName=*/nullptr, /*scale=*/1.0f);
+  if (FAILED(hr)) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IDWriteFontFallback> fallback;
+  if (FAILED(builder->CreateFontFallback(&fallback))) {
+    return nullptr;
+  }
+  return fallback;
+}
