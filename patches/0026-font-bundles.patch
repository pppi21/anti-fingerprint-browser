diff --git a/components/browser/font_bundles.cc b/components/browser/font_bundles.cc
new file mode 100644
index 0000000000..00f6e4c855
--- /dev/null
+++ b/components/browser/font_bundles.cc
@@ -0,0 +1,399 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// See font_bundles.h for the public contract. Bundle directories under
+// <chrome.exe dir>/browser_fonts/ take one of two shapes:
+//
+//   1. Flat bundle: every .ttf / .ttc / .otf directly in the directory is
+//      loaded. Used for base_win11, emoji_*, lang_* and personal_common.
+//
+//   2. Tiered bundle: the directory contains the subdirectories "1", "2"
+//      and "3".
+//        1/  Everything in it is loaded whenever the bundle is picked.
+//        2/  Themed sub-bundles, one per immediate subdirectory. A
+//            Poisson-drawn number of them are sampled and every font inside
+//            the picked subdirectories is loaded.
+//        3/  Flat pool of fonts; a Poisson-drawn number are sampled
+//            individually.
+//      A bundle is tiered iff a "1" subdirectory exists. Used for
+//      app_office_365 and app_adobe_cc.
+//
+// After all bundles have contributed, filenames are deduplicated
+// case-insensitively with the first occurrence winning, so base_win11 beats
+// the application bundles, which beat personal_common.
+
+#include "components/browser/font_bundles.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <iterator>
+#include <optional>
+#include <random>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "base/base_paths.h"
+#include "base/containers/span.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/switch_resolver.h"
+
+namespace browser {
+namespace {
+
+struct BundleSpec {
+  std::string_view dir_name;
+  base::span<const std::string_view> implied_langs;
+  // Selection probability in [0, 1]. Emoji bundles are weighted against
+  // each other; independent bundles are rolled on their own.
+  double probability;
+};
+
+constexpr BundleSpec kBaseBundle = {"base_win11", {}, 1.0};
+
+constexpr BundleSpec kEmojiBundles[] = {
+    {"emoji_v145", {}, 0.40},
+    {"emoji_v151", {}, 0.45},
+    {"emoji_emoji16", {}, 0.15},
+};
+
+constexpr std::string_view kLangJapanese[] = {"ja-JP", "ja"};
+constexpr std::string_view kLangHebrew[] = {"he-IL", "he"};
+constexpr std::string_view kLangArabic[] = {"ar-SA", "ar"};
+constexpr std::string_view kLangThai[] = {"th-TH", "th"};
+constexpr std::string_view kLangDevanagari[] = {"hi-IN", "hi"};
+constexpr std::string_view kLangCjkSimplified[] = {"zh-CN", "zh"};
+constexpr std::string_view kLangKorean[] = {"ko-KR", "ko"};
+
+constexpr BundleSpec kIndependentBundles[] = {
+    {"lang_pan_european", {}, 0.15},
+    {"lang_japanese", kLangJapanese, 0.04},
+    {"lang_hebrew", kLangHebrew, 0.02},
+    {"lang_arabic", kLangArabic, 0.03},
+    {"lang_thai", kLangThai, 0.02},
+    {"lang_devanagari", kLangDevanagari, 0.03},
+    {"lang_cjk_simplified", kLangCjkSimplified, 0.04},
+    {"lang_korean_extras", kLangKorean, 0.02},
+    {"app_office_365", {}, 0.60},
+    {"app_adobe_cc", {}, 0.25},
+};
+
+constexpr std::string_view kPersonalCommonDir = "personal_common";
+
+// Tier 2: expected number of themed sub-bundles picked, and the cap.
+constexpr double kTier2Mean = 2.0;
+constexpr int kTier2Cap = 4;
+
+// Tier 3: expected number of fonts pulled from the flat pool, and the cap.
+constexpr double kTier3Mean = 10.0;
+constexpr int kTier3Cap = 30;
+
+// personal_common: expected number of third-party fonts, and the cap.
+constexpr double kPersonalMean = 2.0;
+constexpr int kPersonalCap = 5;
+
+// Languages every profile reports before any bundle-implied ones.
+constexpr std::string_view kDefaultLanguages[] = {"en-US", "en"};
+
+// FNV-1a; the seed string is arbitrary text and only needs to spread.
+uint64_t HashSeed(std::string_view seed) {
+  uint64_t hash = 0xcbf29ce484222325ULL;
+  for (char c : seed) {
+    hash ^= static_cast<uint64_t>(static_cast<unsigned char>(c));
+    hash *= 0x100000001b3ULL;
+  }
+  return hash;
+}
+
+std::optional<std::string> ParseExplicitSeed(const std::string& value) {
+  // Every non-empty string is a valid HashSeed input.
+  if (value.empty()) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+// Derived seeds are stringified so that explicit and derived values take the
+// same path through HashSeed.
+std::string DeriveSeed(int32_t seed) {
+  return base::NumberToString(DeterministicBucket(
+      seed, kSaltFontBundle, static_cast<uint32_t>(INT32_MAX)));
+}
+
+base::FilePath ResolveBundleRoot() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return {};
+  }
+  return exe_dir.Append(FILE_PATH_LITERAL("browser_fonts"));
+}
+
+bool IsFontFile(const base::FilePath& path) {
+  return path.MatchesExtension(FILE_PATH_LITERAL(".ttf")) ||
+         path.MatchesExtension(FILE_PATH_LITERAL(".ttc")) ||
+         path.MatchesExtension(FILE_PATH_LITERAL(".otf"));
+}
+
+// Sorted font files (FILES) or immediate subdirectories (DIRECTORIES) of
+// |dir|. Sorting makes the later sampling independent of enumeration order.
+std::vector<base::FilePath> EnumerateSorted(
+    const base::FilePath& dir,
+    base::FileEnumerator::FileType type) {
+  std::vector<base::FilePath> out;
+  base::FileEnumerator enumerator(dir, /*recursive=*/false, type);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    if (type == base::FileEnumerator::DIRECTORIES || IsFontFile(path)) {
+      out.push_back(std::move(path));
+    }
+  }
+  std::sort(out.begin(), out.end());
+  return out;
+}
+
+std::vector<base::FilePath> EnumerateFontFiles(const base::FilePath& dir) {
+  return EnumerateSorted(dir, base::FileEnumerator::FILES);
+}
+
+std::vector<base::FilePath> EnumerateSubdirs(const base::FilePath& dir) {
+  return EnumerateSorted(dir, base::FileEnumerator::DIRECTORIES);
+}
+
+void MoveAppend(std::vector<base::FilePath> from,
+                std::vector<base::FilePath>* to) {
+  to->insert(to->end(), std::make_move_iterator(from.begin()),
+             std::make_move_iterator(from.end()));
+}
+
+// Shuffles |pool| and keeps a Poisson(|mean|)-distributed number of entries,
+// at most |cap|. An empty pool consumes no randomness.
+void SamplePoisson(std::vector<base::FilePath>* pool,
+                   std::mt19937_64& rng,
+                   double mean,
+                   int cap) {
+  if (pool->empty()) {
+    return;
+  }
+  std::shuffle(pool->begin(), pool->end(), rng);
+  std::poisson_distribution<int> poisson(mean);
+  const size_t count = std::clamp(poisson(rng), 0, cap);
+  if (count < pool->size()) {
+    pool->resize(count);
+  }
+}
+
+// Appends the files a bundle contributes; tiered when a "1" subdirectory
+// exists, flat otherwise. Returns false when nothing was found.
+bool CollectBundleFiles(const base::FilePath& root,
+                        const BundleSpec& bundle,
+                        std::mt19937_64& rng,
+                        std::vector<base::FilePath>* out) {
+  const base::FilePath dir = root.AppendASCII(bundle.dir_name);
+  const base::FilePath tier1_dir = dir.AppendASCII("1");
+  const size_t start = out->size();
+
+  if (base::DirectoryExists(tier1_dir)) {
+    MoveAppend(EnumerateFontFiles(tier1_dir), out);
+
+    const base::FilePath tier2_dir = dir.AppendASCII("2");
+    if (base::DirectoryExists(tier2_dir)) {
+      std::vector<base::FilePath> subdirs = EnumerateSubdirs(tier2_dir);
+      SamplePoisson(&subdirs, rng, kTier2Mean, kTier2Cap);
+      for (const base::FilePath& subdir : subdirs) {
+        MoveAppend(EnumerateFontFiles(subdir), out);
+      }
+    }
+
+    const base::FilePath tier3_dir = dir.AppendASCII("3");
+    if (base::DirectoryExists(tier3_dir)) {
+      std::vector<base::FilePath> pool = EnumerateFontFiles(tier3_dir);
+      SamplePoisson(&pool, rng, kTier3Mean, kTier3Cap);
+      MoveAppend(std::move(pool), out);
+    }
+  } else {
+    MoveAppend(EnumerateFontFiles(dir), out);
+  }
+
+  if (out->size() == start) {
+    VLOG(1) << "browser: font bundle \"" << bundle.dir_name
+            << "\" contributed no files";
+    return false;
+  }
+  return true;
+}
+
+// Appends the bundle's implied languages that |languages| lacks.
+void AppendBundleLanguages(const BundleSpec& bundle,
+                           std::vector<std::string>* languages) {
+  for (std::string_view lang : bundle.implied_langs) {
+    if (!std::ranges::contains(*languages, lang)) {
+      languages->emplace_back(lang);
+    }
+  }
+}
+
+// Drops every file whose lowercased filename was seen earlier in the list,
+// preserving first-seen order.
+void DedupByFilename(std::vector<base::FilePath>* files) {
+  std::unordered_set<std::string> seen;
+  seen.reserve(files->size());
+  std::vector<base::FilePath> kept;
+  kept.reserve(files->size());
+  for (base::FilePath& file : *files) {
+    if (seen.insert(base::ToLowerASCII(file.BaseName().AsUTF8Unsafe()))
+            .second) {
+      kept.push_back(std::move(file));
+    }
+  }
+  *files = std::move(kept);
+}
+
+// "en-US,en;q=0.9,ja;q=0.8,...": the primary tag carries no q, later tags
+// step down by 0.1 and stay at 0.1 for the long tail.
+std::string BuildAcceptLanguageHeader(
+    const std::vector<std::string>& languages) {
+  if (languages.empty()) {
+    return {};
+  }
+  std::string header = languages[0];
+  double q = 0.9;
+  for (size_t i = 1; i < languages.size(); ++i) {
+    base::StringAppendF(&header, ",%s;q=%.1f", languages[i].c_str(), q);
+    if (q > 0.1) {
+      q -= 0.1;
+    }
+  }
+  return header;
+}
+
+struct Selection {
+  bool active = false;
+  std::vector<base::FilePath> files;
+  std::string accept_language;
+  std::vector<std::string> languages;
+};
+
+Selection BuildSelection() {
+  Selection selection;
+
+  // Explicit values feed HashSeed unchanged; "auto", "seed:N" and an
+  // inherited --fingerprint-seed produce a derived seed string.
+  const ResolvedSwitch<std::string> resolved = ResolveSwitch<std::string>(
+      switches::kBrowserFontBundle, &ParseExplicitSeed, &DeriveSeed,
+      std::string());
+  if (resolved.source == SwitchSource::kAbsent) {
+    return selection;
+  }
+  const std::string& seed = resolved.value;
+
+  const base::FilePath root = ResolveBundleRoot();
+  if (root.empty()) {
+    LOG(ERROR) << "browser: font bundle root unresolvable (DIR_EXE failed); "
+               << "falling back to system fonts";
+    return selection;
+  }
+
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+
+  std::mt19937_64 rng(HashSeed(seed));
+
+  // The Windows 11 inbox fonts are always present; without them the bundle
+  // root is unusable and the system collection stays in place.
+  if (!CollectBundleFiles(root, kBaseBundle, rng, &selection.files)) {
+    LOG(ERROR) << "browser: font bundle root \"" << root.value()
+               << "\" has no base_win11 fonts; falling back to system fonts";
+    selection.files.clear();
+    return selection;
+  }
+  selection.languages.assign(std::begin(kDefaultLanguages),
+                             std::end(kDefaultLanguages));
+  AppendBundleLanguages(kBaseBundle, &selection.languages);
+
+  // Exactly one emoji font, weighted.
+  {
+    double total = 0;
+    for (const BundleSpec& bundle : kEmojiBundles) {
+      total += bundle.probability;
+    }
+    const double roll = std::uniform_real_distribution<double>(0, total)(rng);
+    double cumulative = 0;
+    for (const BundleSpec& bundle : kEmojiBundles) {
+      cumulative += bundle.probability;
+      if (roll < cumulative) {
+        CollectBundleFiles(root, bundle, rng, &selection.files);
+        AppendBundleLanguages(bundle, &selection.languages);
+        break;
+      }
+    }
+  }
+
+  // Each independent bundle is rolled against its own probability.
+  std::uniform_real_distribution<double> unit(0, 1);
+  for (const BundleSpec& bundle : kIndependentBundles) {
+    if (unit(rng) < bundle.probability) {
+      CollectBundleFiles(root, bundle, rng, &selection.files);
+      AppendBundleLanguages(bundle, &selection.languages);
+    }
+  }
+
+  // A few third-party fonts a typical user has installed.
+  {
+    std::vector<base::FilePath> pool =
+        EnumerateFontFiles(root.AppendASCII(kPersonalCommonDir));
+    SamplePoisson(&pool, rng, kPersonalMean, kPersonalCap);
+    MoveAppend(std::move(pool), &selection.files);
+  }
+
+  // Bundles overlap (base_win11 and app_office_365 tier 3 both ship
+  // Consolas, for example). Traversal order sets precedence: base, emoji,
+  // independent, personal.
+  const size_t before_dedup = selection.files.size();
+  DedupByFilename(&selection.files);
+
+  selection.accept_language = BuildAcceptLanguageHeader(selection.languages);
+  selection.active = true;
+
+  VLOG(1) << "browser: font bundle active, seed=\"" << seed
+          << "\", files=" << selection.files.size() << " (of " << before_dedup
+          << " before dedup), languages=" << selection.accept_language;
+  return selection;
+}
+
+const Selection& GetSelection() {
+  static const base::NoDestructor<Selection> selection(BuildSelection());
+  return *selection;
+}
+
+}  // namespace
+
+bool IsFontBundleActive() {
+  return GetSelection().active;
+}
+
+const std::vector<base::FilePath>& GetSelectedFontFilePaths() {
+  return GetSelection().files;
+}
+
+const std::string& GetBundleAcceptLanguage() {
+  return GetSelection().accept_language;
+}
+
+const std::vector<std::string>& GetBundleLanguagesList() {
+  return GetSelection().languages;
+}
+
+}  // namespace browser
diff --git a/components/browser/font_bundles.h b/components/browser/font_bundles.h
new file mode 100644
index 0000000000..eb422d021d
--- /dev/null
+++ b/components/browser/font_bundles.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Resolves a per-profile font set and its implied languages from the
+// --browser-font-bundle switch. Everything is computed once, on first access,
+// and cached for the process lifetime.
+//
+// Bundles are constexpr tables in font_bundles.cc naming subdirectories of
+// <chrome.exe dir>/browser_fonts/. The seed deterministically picks:
+//   - always: the Windows 11 inbox baseline
+//   - one Segoe UI Emoji version (weighted)
+//   - zero or more optional language packs, each rolled independently
+//     against its own probability
+//   - zero or more common application bundles (Office, Adobe)
+//   - a handful of commonly installed third-party fonts
+//
+// A bundle may declare implied BCP-47 language tags; selecting it adds those
+// tags to navigator.languages and Accept-Language.
+
+#ifndef COMPONENTS_BROWSER_FONT_BUNDLES_H_
+#define COMPONENTS_BROWSER_FONT_BUNDLES_H_
+
+#include <string>
+#include <vector>
+
+#include "base/component_export.h"
+#include "base/files/file_path.h"
+
+namespace browser {
+
+// True when --browser-font-bundle was set, the bundle root resolved and at
+// least one base font file was found. When false, callers leave Chromium's
+// default font and locale behavior alone.
+COMPONENT_EXPORT(BROWSER) bool IsFontBundleActive();
+
+// Absolute paths of the font files selected for this profile. Bundle files
+// that are declared but missing on disk are silently omitted.
+COMPONENT_EXPORT(BROWSER)
+const std::vector<base::FilePath>& GetSelectedFontFilePaths();
+
+// HTTP Accept-Language header value, e.g. "en-US,en;q=0.9,ja;q=0.8".
+// Empty when the bundle is not active.
+COMPONENT_EXPORT(BROWSER)
+const std::string& GetBundleAcceptLanguage();
+
+// navigator.languages in preference order, e.g. {"en-US", "en", "ja"}.
+// Empty when the bundle is not active.
+COMPONENT_EXPORT(BROWSER)
+const std::vector<std::string>& GetBundleLanguagesList();
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_FONT_BUNDLES_H_
