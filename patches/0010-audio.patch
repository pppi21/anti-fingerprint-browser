   if (context_options->hasSampleRate()) {
     sample_rate = context_options->sampleRate();
   }
+  // browser: the spoofed sample rate wins over the page's option.
+  if (const browser::AudioOverride& spoof = browser::GetAudioOverride();
+      spoof.active) {
+    sample_rate = spoof.sample_rate;
