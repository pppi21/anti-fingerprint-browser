     media::EncryptionScheme encryption_scheme) const {
-  if (hw_secure_encryption_schemes_.count(encryption_scheme)) {
+  // browser: same shape as WidevineKeySystemInfo.
+  const bool is_supported = encryption_schemes_.contains(encryption_scheme);
+  const bool is_hw_secure_supported =
+      hw_secure_encryption_schemes_.contains(encryption_scheme);
+  if (is_supported && is_hw_secure_supported) {
+    return EmeConfig::SupportedRule();
+  }
+  if (is_supported) {
+    return EmeConfig{.hw_secure_codecs = EmeConfigRuleState::kNotAllowed};
