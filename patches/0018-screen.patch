+// browser: the optional seventh field of --fingerprint-screen, the device
+// pixel ratio. It goes through the same forced-scale-factor path as
+// --force-device-scale-factor so layout, DOMRect and the compositor all see
+// it; "auto" and "seed:<N>" take it from the profile, so a spoofed
+// screen.width never pairs with the real window.devicePixelRatio.
+std::optional<double> ParseFingerprintScreenDpr() {
+  static const double cached_dpr =
+      browser::ResolveSwitch<double>(
+          switches::kFingerprintScreen,
+          [](const std::string& value) -> std::optional<double> {
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+            double dpr = 0.0;
+            if (parts.size() != 7 || !base::StringToDouble(parts[6], &dpr) ||
+                dpr <= 0.0) {
+              return std::nullopt;
+            }
+            return dpr;
+          },
+          [](int32_t seed) -> double {
+            const browser::FingerprintProfile* profile =
+                browser::ProfileForSeed(seed);
+            if (!profile || !profile->device_pixel_ratio ||
+                *profile->device_pixel_ratio <= 0.0) {
+              return -1.0;
+            }
+            return *profile->device_pixel_ratio;
+          },
+          /*fallback_when_absent=*/-1.0,
+          /*inherit_from_master_seed=*/false)
+          .value;
+  if (cached_dpr > 0.0) {
+    return cached_dpr;
+  }
+  return std::nullopt;
+}
+
 bool HasForceDeviceScaleFactorImpl() {
-  return base::CommandLine::ForCurrentProcess()->HasSwitch(
-      switches::kForceDeviceScaleFactor);
+  // browser: a spoofed pixel ratio counts as a forced scale factor.
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  return cl->HasSwitch(switches::kForceDeviceScaleFactor) ||
+         ParseFingerprintScreenDpr().has_value();
 }
 
 float GetForcedDeviceScaleFactorImpl() {
-  double scale_in_double = 1.0;
-  if (HasForceDeviceScaleFactorImpl()) {
+  // browser: --force-device-scale-factor wins over the spoofed ratio.
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch(switches::kForceDeviceScaleFactor)) {
+    double scale_in_double = 1.0;
     std::string value =
-        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
-            switches::kForceDeviceScaleFactor);
+        cl->GetSwitchValueASCII(switches::kForceDeviceScaleFactor);
     if (!base::StringToDouble(value, &scale_in_double)) {
       LOG(ERROR) << "Failed to parse the default device scale factor:" << value;
       scale_in_double = 1.0;
     }
+    return static_cast<float>(scale_in_double);
+  }
+  if (std::optional<double> dpr = ParseFingerprintScreenDpr()) {
+    return static_cast<float>(*dpr);
   }
-  return static_cast<float>(scale_in_double);
+  return 1.0f;
 }
 
