+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BROWSER_BROWSER_RUNTIME_H_
+#define COMPONENTS_BROWSER_BROWSER_RUNTIME_H_
+
+#include <string>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// Cached accessors for the string-valued spoof switches. The first call
+// resolves the switch (see switch_resolver.h) and caches the result for the
+// process lifetime; later calls are a pointer dereference. Each returns an
+// empty string when the switch is absent, so call sites branch on
+// `!value.empty()`.
+
+// WebGL vendor / renderer strings. The lowercase vendor is precomputed for
+// the vendor-match call sites.
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedGpuRenderer();
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedGpuVendor();
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedGpuVendorLower();
+
+// MAX_VERTEX_UNIFORM_VECTORS to report through WebGL while a GPU vendor
+// spoof is active: 4095 for NVIDIA (its drivers reserve one vector) and
+// 4096 for every other vendor; 0 when no vendor is spoofed. The
+// *_UNIFORM_COMPONENTS variants are this value times four.
+COMPONENT_EXPORT(BROWSER) int SpoofedMaxVertexUniformVectors();
+
+// WebGPU adapter.info tokens. Derived values come from the active profile's
+// ANGLE renderer string (see webgpu_identity.h).
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedWebgpuVendor();
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedWebgpuArchitecture();
+
+// Brand and version. An explicit switch value is returned verbatim; the
+// derived forms are "Chrome", the major component of PRODUCT_VERSION and
+// the full PRODUCT_VERSION respectively.
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedBrand();
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedBrandVersion();
+COMPONENT_EXPORT(BROWSER) const std::string& SpoofedBrandVersionLong();
+
+// True when any of the three brand accessors is non-empty. Cached so hot
+// paths (e.g. mediaCapabilities.decodingInfo) pay a single bool load.
+COMPONENT_EXPORT(BROWSER) bool BrandSpoofActive();
+
+// Browser process only. Unless --use-chromium-defaults is present, appends
+// the preset of telemetry-off switches and privacy-positive feature flags
+// to the current command line. User-supplied switches are never
+// overwritten, and --disable-features is merged with any existing value.
+// Must run before FeatureList initialization; the hook site is
+// ChromeMainDelegate::BasicStartupComplete.
+COMPONENT_EXPORT(BROWSER) void MaybeExpandBrowserDefaults();
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_BROWSER_RUNTIME_H_
