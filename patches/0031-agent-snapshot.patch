+// browser: mark rendering for Page.captureAgentSnapshot. The browser draws
+// the labelled overlay onto the composited screenshot itself, so the client
+// never re-decodes or re-draws. Each marked element gets a colored outline
+// and a badge in the same color; neighboring marks get colors that are as
+// far apart in CIELAB as the palette allows, so a label can be tied to its
+// box by color even in a dense grid of marks.
+
+struct AgentMarkColor {
+  SkColor rgb;
+  const char* name;  // returned to the caller alongside the label
+};
+
+// Eight nameable, well-separated hues (Trubetskoy's distinct-color set).
+constexpr AgentMarkColor kAgentMarkPalette[] = {
+    {SkColorSetRGB(0xE6, 0x19, 0x4B), "red"},
+    {SkColorSetRGB(0x43, 0x63, 0xD8), "blue"},
+    {SkColorSetRGB(0x3C, 0xB4, 0x4B), "green"},
+    {SkColorSetRGB(0xF5, 0x82, 0x31), "orange"},
+    {SkColorSetRGB(0x91, 0x1E, 0xB4), "purple"},
+    {SkColorSetRGB(0x42, 0xD4, 0xF4), "cyan"},
+    {SkColorSetRGB(0xF0, 0x32, 0xE6), "magenta"},
+    {SkColorSetRGB(0xFF, 0xE1, 0x19), "yellow"},
+};
+constexpr size_t kAgentMarkPaletteSize = std::size(kAgentMarkPalette);
+
+struct LabColor {
+  double l;
+  double a;
+  double b;
+};
+
+double SrgbToLinear(double channel) {
+  const double c = channel / 255.0;
+  return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+}
+
+LabColor RgbToLab(SkColor color) {
+  const double r = SrgbToLinear(SkColorGetR(color));
+  const double g = SrgbToLinear(SkColorGetG(color));
+  const double b = SrgbToLinear(SkColorGetB(color));
+  const double x = (r * 0.4124 + g * 0.3576 + b * 0.1805) / 0.95047;
+  const double y = r * 0.2126 + g * 0.7152 + b * 0.0722;
+  const double z = (r * 0.0193 + g * 0.1192 + b * 0.9505) / 1.08883;
+  auto f = [](double t) {
+    return t > 0.008856 ? std::cbrt(t) : (7.787 * t + 16.0 / 116.0);
+  };
+  const double fx = f(x);
+  const double fy = f(y);
+  const double fz = f(z);
+  return {116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz)};
+}
+
+double LabDistance(const LabColor& a, const LabColor& b) {
+  const double dl = a.l - b.l;
+  const double da = a.a - b.a;
+  const double db = a.b - b.b;
+  return std::sqrt(dl * dl + da * da + db * db);
+}
+
+// Greedy graph coloring. Two marks are adjacent when their device-pixel
+// boxes, expanded for proximity, intersect; each mark then gets the palette
+// color with the largest minimum CIELAB distance to its already-colored
+// neighbors, ties going to the least-used color. Returns a palette index per
+// box.
+std::vector<int> AssignAgentMarkColors(const std::vector<gfx::RectF>& boxes,
+                                       double dsf) {
+  const size_t n = boxes.size();
+  std::vector<gfx::RectF> expanded;
+  expanded.reserve(n);
+  for (const gfx::RectF& box : boxes) {
+    const double margin =
+        std::max(8.0 * dsf, 0.15 * std::min(box.width(), box.height()));
+    expanded.emplace_back(box.x() - margin, box.y() - margin,
+                          box.width() + 2 * margin, box.height() + 2 * margin);
+  }
+  std::vector<std::vector<size_t>> adjacent(n);
+  for (size_t i = 0; i < n; ++i) {
+    for (size_t j = i + 1; j < n; ++j) {
+      if (expanded[i].Intersects(expanded[j])) {
+        adjacent[i].push_back(j);
+        adjacent[j].push_back(i);
+      }
+    }
+  }
+
+  std::array<LabColor, kAgentMarkPaletteSize> lab;
+  for (size_t k = 0; k < kAgentMarkPaletteSize; ++k) {
+    lab[k] = RgbToLab(kAgentMarkPalette[k].rgb);
+  }
+
+  // Most constrained first.
+  std::vector<size_t> order(n);
+  std::iota(order.begin(), order.end(), 0u);
+  std::ranges::sort(order, [&](size_t a, size_t b) {
+    return adjacent[a].size() > adjacent[b].size();
+  });
+
+  std::vector<int> color(n, -1);
+  std::array<int, kAgentMarkPaletteSize> usage{};
+  for (size_t index : order) {
+    double best_score = -std::numeric_limits<double>::max();
+    int best_k = 0;
+    for (size_t k = 0; k < kAgentMarkPaletteSize; ++k) {
+      double min_distance = std::numeric_limits<double>::max();
+      for (size_t neighbor : adjacent[index]) {
+        if (color[neighbor] >= 0) {
+          min_distance =
+              std::min(min_distance, LabDistance(lab[k], lab[color[neighbor]]));
+        }
+      }
+      const double base = min_distance == std::numeric_limits<double>::max()
+                              ? 1e9
+                              : min_distance;
+      const double score = base - usage[k] * 0.001;
+      if (score > best_score) {
+        best_score = score;
+        best_k = static_cast<int>(k);
+      }
+    }
+    color[index] = best_k;
+    usage[best_k]++;
+  }
+  return color;
+}
+
+// Draws every mark (outline plus labelled badge) onto `bitmap` in place.
+// `boxes` are device-pixel border-boxes and `colors` palette indices from
+// AssignAgentMarkColors. The badge always sits just outside its box, so it
+// never covers the element's own content, at whichever perimeter position
+// best avoids other badges, other boxes and the image edge.
+void DrawAgentMarks(SkBitmap& bitmap,
+                    const std::vector<gfx::RectF>& boxes,
+                    const std::vector<std::string>& labels,
+                    const std::vector<int>& colors,
+                    double dsf) {
+  cc::SkiaPaintCanvas paint_canvas(bitmap);
+  gfx::Canvas canvas(&paint_canvas, 1.0f);
+  const int img_w = bitmap.width();
+  const int img_h = bitmap.height();
+
+  const int font_px = std::max(11, static_cast<int>(std::lround(11.0 * dsf)));
+  gfx::FontList font(base::StringPrintf("Arial, Bold %dpx", font_px));
+  const int text_h = font.GetHeight();
+  const int pad_x = std::max(2, static_cast<int>(std::lround(3.0 * dsf)));
+  const int pad_y = std::max(1, static_cast<int>(std::lround(1.0 * dsf)));
+  const float core = std::max(2.0f, static_cast<float>(2.0 * dsf));
+  const int gap = std::max(2, static_cast<int>(std::lround(2.0 * dsf)));
+
+  // Outlines first, so no badge is painted under a later element's stroke.
+  for (size_t i = 0; i < boxes.size(); ++i) {
+    const gfx::RectF& b = boxes[i];
+    const SkColor col = kAgentMarkPalette[colors[i]].rgb;
+
+    // A dark halo keeps the color visible on any background.
+    cc::PaintFlags halo;
+    halo.setStyle(cc::PaintFlags::kStroke_Style);
+    halo.setStrokeWidth(core + 2.0f * static_cast<float>(dsf));
+    halo.setColor(SkColorSetARGB(0xB0, 0, 0, 0));
+    halo.setAntiAlias(true);
+    canvas.DrawRect(b, halo);
+
+    cc::PaintFlags outline;
+    outline.setStyle(cc::PaintFlags::kStroke_Style);
+    outline.setStrokeWidth(core);
+    outline.setColor(col);
+    outline.setAntiAlias(true);
+    canvas.DrawRect(b, outline);
+  }
+
+  // Integer element boxes, for overlap scoring.
+  std::vector<gfx::Rect> box_rects;
+  box_rects.reserve(boxes.size());
+  for (const gfx::RectF& b : boxes) {
+    box_rects.push_back(gfx::ToRoundedRect(b));
+  }
+
+  // Badges. When overlap is unavoidable the least-bad spot wins.
+  std::vector<gfx::Rect> placed;
+  placed.reserve(boxes.size());
+  for (size_t i = 0; i < boxes.size(); ++i) {
+    const SkColor col = kAgentMarkPalette[colors[i]].rgb;
+    const std::u16string text = base::UTF8ToUTF16(labels[i]);
+    const int bw = gfx::GetStringWidth(text, font) + 2 * pad_x;
+    const int bh = text_h + 2 * pad_y;
+
+    const int left = box_rects[i].x();
+    const int top = box_rects[i].y();
+    const int right = box_rects[i].right();
+    const int bottom = box_rects[i].bottom();
+
+    // Candidate badge origins, all fully outside the box, in priority order;
+    // above and left-aligned is the stable default.
+    const gfx::Point candidates[] = {
+        {left, top - bh - gap},          // above, left-aligned
+        {left, bottom + gap},            // below, left-aligned
+        {right - bw, top - bh - gap},    // above, right-aligned
+        {right - bw, bottom + gap},      // below, right-aligned
+        {left - bw - gap, top},          // left of box, top-aligned
+        {right + gap, top},              // right of box, top-aligned
+        {left - bw - gap, bottom - bh},  // left of box, bottom-aligned
+        {right + gap, bottom - bh},      // right of box, bottom-aligned
+    };
+
+    double best_score = std::numeric_limits<double>::max();
+    gfx::Rect best(candidates[0], gfx::Size(bw, bh));
+    for (size_t c = 0; c < std::size(candidates); ++c) {
+      const gfx::Rect r(candidates[c], gfx::Size(bw, bh));
+      double score = static_cast<double>(c) * 0.01;  // earlier is better
+      if (r.x() < 0 || r.y() < 0 || r.right() > img_w || r.bottom() > img_h) {
+        score += 1000.0;  // spills past the screenshot edge
+      }
+      for (const gfx::Rect& p : placed) {
+        if (r.Intersects(p)) {
+          score += 100.0;  // overlaps another badge
+        }
+      }
+      for (size_t j = 0; j < box_rects.size(); ++j) {
+        if (j != i && r.Intersects(box_rects[j])) {
+          score += 3.0;  // covers another element's content
+        }
+      }
+      if (score < best_score) {
+        best_score = score;
+        best = r;
+      }
+    }
+    // On screen even if every candidate spilled over an edge.
+    best.set_x(std::clamp(best.x(), 0, std::max(0, img_w - bw)));
+    best.set_y(std::clamp(best.y(), 0, std::max(0, img_h - bh)));
+    placed.push_back(best);
+
+    canvas.FillRect(best, col);
+    cc::PaintFlags badge_edge;
+    badge_edge.setStyle(cc::PaintFlags::kStroke_Style);
+    badge_edge.setStrokeWidth(1.0f);
+    badge_edge.setColor(SkColorSetARGB(0x80, 0, 0, 0));
+    canvas.DrawRect(gfx::RectF(best), badge_edge);
+
+    const SkColor text_color = color_utils::GetColorWithMaxContrast(col);
+    canvas.DrawStringRectWithFlags(text, font, text_color, best,
+                                   gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+}
