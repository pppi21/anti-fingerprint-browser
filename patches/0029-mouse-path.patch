diff --git a/components/input/render_widget_host_input_event_router.cc b/components/input/render_widget_host_input_event_router.cc
index d029a262f7..f8215f9ad3 100644
--- a/components/input/render_widget_host_input_event_router.cc
+++ b/components/input/render_widget_host_input_event_router.cc
@@ -637,9 +637,23 @@ void RenderWidgetHostInputEventRouter::RouteMouseEvent(
     RenderWidgetHostViewInput* root_view,
     const blink::WebMouseEvent* event,
     const ui::LatencyInfo& latency) {
+  // browser: observers see the event in root-view coordinates.
+  for (MouseEventRouteObserver* observer : mouse_event_route_observers_) {
+    observer->OnMouseEventRouted(*event);
+  }
   event_targeter_->FindTargetAndDispatch(root_view, *event, latency);
 }
 
+void RenderWidgetHostInputEventRouter::AddMouseEventRouteObserver(
+    MouseEventRouteObserver* observer) {
+  mouse_event_route_observers_.push_back(observer);
+}
+
+void RenderWidgetHostInputEventRouter::RemoveMouseEventRouteObserver(
+    MouseEventRouteObserver* observer) {
+  std::erase(mouse_event_route_observers_, observer);
+}
+
 void RenderWidgetHostInputEventRouter::DispatchMouseEvent(
     RenderWidgetHostViewInput* root_view,
     RenderWidgetHostViewInput* target,
