+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/latency/latency_info.h"
+
+namespace content {
+
+namespace {
+
+// CDP modifier bits, as in Input.dispatchKeyEvent.modifiers, and the
+// WebInputEvent modifier each one maps to.
+struct ModifierBit {
+  int cdp_bit;
+  int blink_modifier;
+};
+constexpr ModifierBit kModifierBits[] = {
+    {1, blink::WebInputEvent::kAltKey},
+    {2, blink::WebInputEvent::kControlKey},
+    {4, blink::WebInputEvent::kMetaKey},
+    {8, blink::WebInputEvent::kShiftKey},
+};
+constexpr int kModShift = 8;
+
+// Events whose scheduled time has arrived within this slack are dispatched
+// in the same task instead of arming a zero-delay timer for each, which
+// keeps the sequence tight when the per-key gap is below timer resolution.
+constexpr base::TimeDelta kBatchDispatchSlack = base::Microseconds(500);
+
+// Typo corrections fire backspaces faster than normal keystrokes and bracket
+// the burst with realization / recovery pauses, so the rhythm changes the way
+// it does for a real typist.
+constexpr int kBackspaceMinMs = 50;
+constexpr int kBackspaceMaxMs = 100;
+constexpr int kRealizePauseMinMs = 200;
+constexpr int kRealizePauseMaxMs = 400;
+constexpr int kPostCorrectionMinMs = 150;
+constexpr int kPostCorrectionMaxMs = 300;
+
+// Common English bigrams are typed faster than baseline.
+constexpr std::string_view kCommonBigrams[] = {
+    "th", "he", "in", "er", "an", "re", "on", "at", "en", "nd",
+    "ti", "es", "or", "te", "of", "ed", "is", "it", "al", "ar",
+    "st", "to", "nt", "ng", "se", "ha", "as", "ou", "io", "le"};
+
+bool IsCommonBigram(char32_t prev, char32_t curr) {
+  if (prev > 0x7F || curr > 0x7F) {
+    return false;
+  }
+  const char a = base::ToLowerASCII(static_cast<char>(prev));
+  const char b = base::ToLowerASCII(static_cast<char>(curr));
+  for (std::string_view bigram : kCommonBigrams) {
+    if (bigram[0] == a && bigram[1] == b) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsAsciiPunctuation(char32_t c) {
+  return c == U'.' || c == U',' || c == U'!' || c == U'?' || c == U';' ||
+         c == U':' || c == U'\'' || c == U'"' || c == U'-' || c == U'(' ||
+         c == U')';
+}
+
+// QWERTY neighbours of the alphanumeric block. Keys outside it never get
+// adjacent-key typos, though they can still get doubled / omission typos.
+struct AdjacencyEntry {
+  char32_t key;
+  std::string_view adjacent;
+};
+constexpr AdjacencyEntry kAdjacency[] = {
+    {U'q', "wa"},     {U'w', "qeasd"},  {U'e', "wrsdf"},  {U'r', "etdfg"},
+    {U't', "ryfgh"},  {U'y', "tughj"},  {U'u', "yihjk"},  {U'i', "uojkl"},
+    {U'o', "ipkl"},   {U'p', "ol"},     {U'a', "qwsz"},   {U's', "awedzx"},
+    {U'd', "serfxc"}, {U'f', "drtgcv"}, {U'g', "ftyhvb"}, {U'h', "gyujbn"},
+    {U'j', "huiknm"}, {U'k', "jiolm"},  {U'l', "kop"},    {U'z', "asx"},
+    {U'x', "zsdc"},   {U'c', "xdfv"},   {U'v', "cfgb"},   {U'b', "vghn"},
+    {U'n', "bhjm"},   {U'm', "njk"},    {U'1', "2q"},     {U'2', "13qw"},
+    {U'3', "24we"},   {U'4', "35er"},   {U'5', "46rt"},   {U'6', "57ty"},
+    {U'7', "68yu"},   {U'8', "79ui"},   {U'9', "80io"},   {U'0', "9op"},
+};
+
+std::string_view LookupAdjacent(char32_t c) {
+  for (const AdjacencyEntry& entry : kAdjacency) {
+    if (entry.key == c) {
+      return entry.adjacent;
+    }
+  }
+  return {};
+}
+
+// The shifted symbols on the digit row, indexed by digit.
+constexpr std::string_view kShiftedDigits = ")!@#$%^&*(";
+
+// Returns the digit under a shifted digit-row symbol, or 0.
+char UnshiftDigitSymbol(char32_t c) {
+  const size_t index = c <= 0x7F ? kShiftedDigits.find(static_cast<char>(c))
+                                 : std::string_view::npos;
+  return index == std::string_view::npos ? 0 : static_cast<char>('0' + index);
+}
+
+struct KeyMapping {
+  std::string key;
+  std::string code;
+  int windows_vkey = 0;
+  bool needs_shift = false;
+  std::u16string text;  // the event's 'text' field
+};
+
+// Punctuation keys as (unshifted, shifted, code, virtual key).
+struct PunctuationKey {
+  char32_t plain;
+  char32_t shifted;
+  std::string_view code;
+  int windows_vkey;
+};
+constexpr PunctuationKey kPunctuationKeys[] = {
+    {U'-', U'_', "Minus", 189},       {U'=', U'+', "Equal", 187},
+    {U'[', U'{', "BracketLeft", 219}, {U']', U'}', "BracketRight", 221},
+    {U'\\', U'|', "Backslash", 220},  {U';', U':', "Semicolon", 186},
+    {U'\'', U'"', "Quote", 222},      {U',', U'<', "Comma", 188},
+    {U'.', U'>', "Period", 190},      {U'/', U'?', "Slash", 191},
+    {U'`', U'~', "Backquote", 192},
+};
+
+// Maps a single ASCII char to its key event fields. Returns false for chars
+// without a known mapping.
+bool BuildKeyMapping(char32_t c, KeyMapping* out) {
+  if (c == U'\n' || c == U'\r') {
+    *out = {"Enter", "Enter", 13, false, u"\r"};
+    return true;
+  }
+  if (c == U'\t') {
+    *out = {"Tab", "Tab", 9, false, u"\t"};
+    return true;
+  }
+  if (c == U' ') {
+    *out = {" ", "Space", 32, false, u" "};
+    return true;
+  }
+  const std::string key(1, static_cast<char>(c));
+  const std::u16string text(1, static_cast<char16_t>(c));
+  if (c >= U'a' && c <= U'z') {
+    const char upper = static_cast<char>('A' + (c - U'a'));
+    *out = {key, std::string("Key") + upper, upper, false, text};
+    return true;
+  }
+  if (c >= U'A' && c <= U'Z') {
+    *out = {key, std::string("Key") + static_cast<char>(c), static_cast<int>(c),
+            true, text};
+    return true;
+  }
+  if (c >= U'0' && c <= U'9') {
+    *out = {key, std::string("Digit") + static_cast<char>(c),
+            static_cast<int>(c), false, text};
+    return true;
+  }
+  if (const char digit = UnshiftDigitSymbol(c)) {
+    *out = {key, std::string("Digit") + digit, digit, true, text};
+    return true;
+  }
+  for (const PunctuationKey& punct : kPunctuationKeys) {
+    if (c == punct.plain || c == punct.shifted) {
+      *out = {key, std::string(punct.code), punct.windows_vkey,
+              c == punct.shifted, text};
+      return true;
+    }
+  }
+  return false;
+}
+
+// Decodes UTF-8 into UTF-32 codepoints. Invalid sequences become U+FFFD, so
+// the schedule generator never sees them.
+std::vector<char32_t> DecodeUtf8(const std::string& text) {
+  const std::u16string u16 = base::UTF8ToUTF16(text);
+  std::vector<char32_t> out;
+  out.reserve(u16.size());
+  for (size_t i = 0; i < u16.size(); ++i) {
+    const char16_t c = u16[i];
+    if (c >= 0xD800 && c <= 0xDBFF && i + 1 < u16.size()) {
+      const char16_t lo = u16[i + 1];
+      if (lo >= 0xDC00 && lo <= 0xDFFF) {
+        out.push_back(0x10000 + ((c - 0xD800) << 10) + (lo - 0xDC00));
+        ++i;
+        continue;
+      }
+    }
+    out.push_back(c);
+  }
+  return out;
+}
+
+// Newlines, control chars and non-ASCII never get typos.
+bool IsTypoEligible(char32_t c) {
+  return c >= 0x20 && c < 0x7F;
+}
+
+}  // namespace
+
+KeyboardTypingSession::KeyboardTypingSession(
+    base::WeakPtr<RenderWidgetHostImpl> widget_host,
+    Params params,
+    CompletionCallback callback)
+    : widget_host_(std::move(widget_host)),
+      params_(std::move(params)),
+      callback_(std::move(callback)),
+      rng_(params_.seed) {
+  // The caller clamps the multiplier, but a non-positive value would collapse
+  // every interval, so it is checked again here.
+  if (params_.speed_multiplier <= 0.0) {
+    params_.speed_multiplier = 1.0;
+  }
+  const double inverse = 1.0 / params_.speed_multiplier;
+  auto scale = [inverse](int ms) {
+    return std::max(1, static_cast<int>(std::round(ms * inverse)));
+  };
+  scaled_keystroke_min_ms_ = scale(params_.keystroke_delay_min_ms);
+  scaled_keystroke_max_ms_ =
+      std::max(scaled_keystroke_min_ms_, scale(params_.keystroke_delay_max_ms));
+  scaled_hold_min_ms_ = scale(params_.key_hold_min_ms);
+  scaled_hold_max_ms_ =
+      std::max(scaled_hold_min_ms_, scale(params_.key_hold_max_ms));
+  scaled_thinking_min_ms_ = scale(params_.thinking_pause_min_ms);
+  scaled_thinking_max_ms_ =
+      std::max(scaled_thinking_min_ms_, scale(params_.thinking_pause_max_ms));
+}
+
+KeyboardTypingSession::~KeyboardTypingSession() {
+  if (callback_) {
+    std::move(callback_).Run(false);
+  }
+}
+
+void KeyboardTypingSession::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  codepoints_ = DecodeUtf8(params_.text);
+  schedule_.reserve(codepoints_.size() * 3);
+  BuildSchedule();
+
+  if (schedule_.empty()) {
+    Finish(true);
+    return;
+  }
+  dispatch_start_ = base::TimeTicks::Now();
+  DispatchPending();
+}
+
+void KeyboardTypingSession::BuildSchedule() {
+  intended_index_ = 0;
+  cursor_time_ = base::TimeDelta();
+  last_typed_char_ = 0;
+
+  while (intended_index_ < codepoints_.size()) {
+    const char32_t c = codepoints_[intended_index_];
+
+    // A thinking pause may fire before any key, including the first.
+    if (Bernoulli(params_.thinking_pause_probability)) {
+      AdvanceMs(RandInt(scaled_thinking_min_ms_, scaled_thinking_max_ms_));
+    }
+
+    // No inter-key delay before the first key or right after a backspace
+    // burst, where the post-correction pause covers the gap.
+    if (last_typed_char_ != 0) {
+      AdvanceInterKeyDelay(c);
+    }
+
+    // An injected typo consumes intended_index_ itself.
+    if (Bernoulli(params_.typo_probability) && MaybeInjectTypo(c)) {
+      continue;
+    }
+
+    EmitChar(c);
+    intended_index_++;
+  }
+}
+
+void KeyboardTypingSession::EmitChar(char32_t c) {
+  KeyMapping mapping;
+  if (BuildKeyMapping(c, &mapping)) {
+    AppendKeyEvents(mapping.key, mapping.code, mapping.windows_vkey,
+                    mapping.needs_shift ? kModShift : 0, mapping.text);
+    last_typed_char_ = c;
+    return;
+  }
+  // A char outside the static map is dispatched as a keyDown carrying only
+  // the 'text' field, which the DOM routes through the input method path.
+  std::u16string text16;
+  if (c < 0x10000) {
+    text16.push_back(static_cast<char16_t>(c));
+  } else {
+    const char32_t v = c - 0x10000;
+    text16.push_back(static_cast<char16_t>(0xD800 + (v >> 10)));
+    text16.push_back(static_cast<char16_t>(0xDC00 + (v & 0x3FF)));
+  }
+  AppendKeyEvents(/*key=*/std::string(text16.begin(), text16.end()),
+                  /*code=*/"", /*windows_vkey=*/0, /*modifiers=*/0, text16);
+  last_typed_char_ = c;
+}
+
+void KeyboardTypingSession::EmitBackspace() {
+  AppendKeyEvents("Backspace", "Backspace", 8, 0, std::u16string());
+  // A backspace must not anchor a bigram with the next intended char.
+  last_typed_char_ = 0;
+}
+
+size_t KeyboardTypingSession::TypeChunk(size_t start, int max_chars) {
+  size_t position = start;
+  for (int typed = 0; typed < max_chars && position < codepoints_.size();
+       ++typed, ++position) {
+    AdvanceInterKeyDelay(codepoints_[position]);
+    EmitChar(codepoints_[position]);
+  }
+  return position;
+}
+
+void KeyboardTypingSession::EmitBackspaceBurst(int count) {
+  for (int k = 0; k < count; k++) {
+    if (k > 0) {
+      AdvanceMs(RandInt(kBackspaceMinMs, kBackspaceMaxMs));
+    }
+    EmitBackspace();
+  }
+}
+
+void KeyboardTypingSession::RetypeRange(size_t from, size_t to) {
+  for (size_t k = from; k < to; k++) {
+    if (k > from) {
+      AdvanceInterKeyDelay(codepoints_[k]);
+    }
+    EmitChar(codepoints_[k]);
+  }
+}
+
+void KeyboardTypingSession::AppendKeyEvents(const std::string& key,
+                                            const std::string& code,
+                                            int windows_vkey,
+                                            int modifiers,
+                                            const std::u16string& text) {
+  schedule_.push_back({cursor_time_, /*is_key_up=*/false, key, code,
+                       windows_vkey, modifiers, text});
+  cursor_time_ +=
+      base::Milliseconds(RandInt(scaled_hold_min_ms_, scaled_hold_max_ms_));
+  // The keyUp carries no text; the keyDown inserted it.
+  schedule_.push_back({cursor_time_, /*is_key_up=*/true, key, code,
+                       windows_vkey, modifiers, std::u16string()});
+}
+
+void KeyboardTypingSession::AdvanceInterKeyDelay(char32_t next_char) {
+  int min_ms = scaled_keystroke_min_ms_;
+  int max_ms = scaled_keystroke_max_ms_;
+  if (params_.context_aware && last_typed_char_ != 0) {
+    double multiplier = 1.0;
+    if (IsCommonBigram(last_typed_char_, next_char)) {
+      multiplier = 0.7;
+    } else if (last_typed_char_ == next_char) {
+      multiplier = 0.8;
+    } else if (last_typed_char_ == U' ' ||
+               IsAsciiPunctuation(last_typed_char_)) {
+      multiplier = 1.2;
+    }
+    min_ms = std::max(1, static_cast<int>(min_ms * multiplier));
+    max_ms = std::max(min_ms, static_cast<int>(max_ms * multiplier));
+  }
+  AdvanceMs(RandInt(min_ms, max_ms));
+}
+
+void KeyboardTypingSession::AdvanceMs(int ms) {
+  if (ms <= 0) {
+    return;
+  }
+  cursor_time_ += base::Milliseconds(ms);
+}
+
+bool KeyboardTypingSession::MaybeInjectTypo(char32_t intended_char) {
+  if (!IsTypoEligible(intended_char)) {
+    return false;
+  }
+  // Every correction pattern detects the mistake a few chars later, so the
+  // last char of the input never gets a typo.
+  if (intended_index_ + 1 >= codepoints_.size()) {
+    return false;
+  }
+
+  const double roll = RandDouble();
+  if (roll < 0.70) {
+    // Adjacent typo, falling through to the other kinds when the char has no
+    // neighbour in the QWERTY map.
+    if (const char32_t wrong = PickAdjacent(intended_char)) {
+      InjectAdjacentTypo(wrong);
+      return true;
+    }
+  }
+  if (roll < 0.90) {
+    InjectDoubledTypo(intended_char);
+    return true;
+  }
+  InjectOmissionTypo(intended_char);
+  return true;
+}
+
+char32_t KeyboardTypingSession::PickAdjacent(char32_t c) {
+  // The neighbour keeps the source char's shift state: 'A' typos to 'S' or
+  // 'Q', not 's', and '@' to '!' or '#'. Adjacency is looked up on the
+  // unshifted form and the shift re-applied afterwards.
+  char32_t lookup = c;
+  bool to_upper = false;
+  bool was_shifted_digit = false;
+  if (c >= U'A' && c <= U'Z') {
+    lookup = U'a' + (c - U'A');
+    to_upper = true;
+  } else if (const char digit = UnshiftDigitSymbol(c)) {
+    lookup = digit;
+    was_shifted_digit = true;
+  }
+  const std::string_view adjacent = LookupAdjacent(lookup);
+  if (adjacent.empty()) {
+    return 0;
+  }
+  std::uniform_int_distribution<size_t> dist(0, adjacent.size() - 1);
+  const char picked = adjacent[dist(rng_)];
+
+  if (to_upper && picked >= 'a' && picked <= 'z') {
+    return picked - 'a' + 'A';
+  }
+  // A digit neighbour of a shifted symbol maps back to its shifted form; a
+  // letter neighbour stays lowercase, which is a valid typo of its own.
+  if (was_shifted_digit && picked >= '0' && picked <= '9') {
+    return kShiftedDigits[picked - '0'];
+  }
+  return picked;
+}
+
+void KeyboardTypingSession::InjectAdjacentTypo(char32_t wrong_char) {
+  // BuildSchedule already added the inter-key delay for this slot, computed
+  // for the intended char; the wrong key is adjacent, so it is close enough.
+  EmitChar(wrong_char);
+
+  // Keep typing 1..4 intended chars before noticing, as a typist would.
+  size_t position = intended_index_ + 1;
+  const size_t end = TypeChunk(position, RandInt(1, 4));
+  const int typed_after = static_cast<int>(end - position);
+
+  AdvanceMs(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Delete the chars typed after the typo, then the typo itself.
+  EmitBackspaceBurst(typed_after + 1);
+
+  // Recover and re-type [intended_index_, end). The recovery pause covers
+  // the first gap, and the corrected pass never gets a second typo.
+  AdvanceMs(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(intended_index_, end);
+  intended_index_ = end;
+}
+
+void KeyboardTypingSession::InjectDoubledTypo(char32_t intended_char) {
+  // The char is typed correctly, then again by accident.
+  EmitChar(intended_char);
+  AdvanceInterKeyDelay(intended_char);  // a (c, c) bigram, so fast
+  EmitChar(intended_char);
+
+  const size_t position = intended_index_ + 1;
+  const size_t end = TypeChunk(position, RandInt(1, 4));
+  const int typed_after = static_cast<int>(end - position);
+
+  AdvanceMs(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Delete the duplicate and everything typed after it.
+  EmitBackspaceBurst(typed_after + 1);
+
+  // The correct char is still in the field; re-type only what followed.
+  AdvanceMs(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(position, end);
+  intended_index_ = end;
+}
+
+void KeyboardTypingSession::InjectOmissionTypo(char32_t intended_char) {
+  // BuildSchedule already added the inter-key delay for intended_char's
+  // slot; the first char after the omission takes that slot, so it gets no
+  // delay of its own.
+  size_t position = intended_index_ + 1;
+  if (position >= codepoints_.size()) {
+    EmitChar(intended_char);
+    intended_index_++;
+    return;
+  }
+  EmitChar(codepoints_[position]);
+  position++;
+  int typed_after = 1;
+  const int detect_target = RandInt(1, 4);
+  while (typed_after < detect_target && position < codepoints_.size()) {
+    AdvanceInterKeyDelay(codepoints_[position]);
+    EmitChar(codepoints_[position]);
+    position++;
+    typed_after++;
+  }
+
+  AdvanceMs(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Only the chars typed after the omission are deleted; the omitted char
+  // was never typed.
+  EmitBackspaceBurst(typed_after);
+
+  // Re-type the omitted char and everything just deleted.
+  AdvanceMs(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(intended_index_, position);
+  intended_index_ = position;
+}
+
+void KeyboardTypingSession::DispatchPending() {
+  if (!widget_host_) {
+    Finish(false);
+    return;
+  }
+  if (next_index_ >= schedule_.size()) {
+    Finish(true);
+    return;
+  }
+
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - dispatch_start_;
+
+  // Focus the widget, as dispatchKeyEvent does on every call. Cheap when
+  // already focused.
+  widget_host_->Focus();
+
+  while (next_index_ < schedule_.size()) {
+    const ScheduledEvent& ev = schedule_[next_index_];
+    if (ev.time_offset > elapsed + kBatchDispatchSlack) {
+      break;
+    }
+
+    // kKeyDown is what the dispatchKeyEvent path uses for "keyDown": the
+    // renderer generates both the raw key event and the char event from it.
+    const blink::WebInputEvent::Type type =
+        ev.is_key_up ? blink::WebInputEvent::Type::kKeyUp
+                     : blink::WebInputEvent::Type::kKeyDown;
+    int blink_modifiers = blink::WebInputEvent::kFromDebugger;
+    for (const ModifierBit& bit : kModifierBits) {
+      if (ev.modifiers & bit.cdp_bit) {
+        blink_modifiers |= bit.blink_modifier;
+      }
+    }
+
+    input::NativeWebKeyboardEvent event(type, blink_modifiers,
+                                        dispatch_start_ + ev.time_offset);
+    event.windows_key_code = ev.windows_vkey;
+    event.native_key_code = ev.windows_vkey;
+    event.skip_if_unhandled = true;
+    if (!ev.code.empty()) {
+      event.dom_code =
+          static_cast<int>(ui::KeycodeConverter::CodeStringToDomCode(ev.code));
+    }
+    if (!ev.key.empty()) {
+      event.dom_key =
+          static_cast<int>(ui::KeycodeConverter::KeyStringToDomKey(ev.key));
+    }
+    if (!ev.text.empty() &&
+        ev.text.size() < blink::WebKeyboardEvent::kTextLengthCap) {
+      // unmodified_text mirrors text, as for any non-modifier key.
+      std::ranges::copy(ev.text, event.text.begin());
+      std::ranges::copy(ev.text, event.unmodified_text.begin());
+    }
+
+    // The InputInjector path is bypassed: no per-event ack is needed, since
+    // the CDP callback fires once at the end of the session.
+    const base::WeakPtr<KeyboardTypingSession> weak_this =
+        weak_factory_.GetWeakPtr();
+    widget_host_->ForwardKeyboardEventWithCommands(
+        event, ui::LatencyInfo(), std::vector<blink::mojom::EditCommandPtr>());
+    // Dispatch may destroy the session (e.g. Ctrl+W).
+    if (!weak_this) {
+      return;
+    }
+    next_index_++;
+  }
+
+  if (next_index_ >= schedule_.size()) {
+    Finish(true);
+    return;
+  }
+  const base::TimeDelta wait =
+      std::max(schedule_[next_index_].time_offset - elapsed, base::TimeDelta());
+  timer_.Start(FROM_HERE, wait,
+               base::BindOnce(&KeyboardTypingSession::DispatchPending,
+                              weak_factory_.GetWeakPtr()));
+}
+
+void KeyboardTypingSession::Finish(bool success) {
+  timer_.Stop();
+  if (callback_) {
+    std::move(callback_).Run(success);
+  }
+}
+
+int KeyboardTypingSession::RandInt(int min_inclusive, int max_inclusive) {
+  if (max_inclusive <= min_inclusive) {
+    return min_inclusive;
+  }
+  std::uniform_int_distribution<int> dist(min_inclusive, max_inclusive);
+  return dist(rng_);
+}
+
+double KeyboardTypingSession::RandDouble() {
+  std::uniform_real_distribution<double> dist(0.0, 1.0);
+  return dist(rng_);
+}
+
+bool KeyboardTypingSession::Bernoulli(double p) {
+  if (p <= 0.0) {
+    return false;
+  }
+  if (p >= 1.0) {
+    return true;
+  }
+  return RandDouble() < p;
+}
+
+}  // namespace content
