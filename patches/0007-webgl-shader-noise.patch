+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_SHADER_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_SHADER_NOISE_H_
+
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+// WebGL fragment shader source rewriting (--webgl-shader-noise).
+//
+// Applied at WebGLRenderingContextBase::shaderSource() before the GLSL source
+// is handed to ANGLE. The rewrite injects per-profile sub-LSB perturbations
+// on natural-variance constructs in the fragment shader: transcendental
+// function calls (sin/cos/pow/length/etc.), texture sampling UV inputs and
+// gl_FragCoord reads, plus a per-fragment color offset for shaders that read
+// varyings without sampling textures. Constants, uniform reads, and
+// flat-color writes pass through unchanged.
+//
+// Why source rewriting and not a readPixels-boundary hook:
+//   Most free tampering-detection sites compare readPixels output against
+//   re-derived canonical pixels (rerunning the same draw on a worker, on a
+//   2D canvas via different methods, etc.). A blanket readPixels perturbation
+//   diverges from those re-derivations and gets flagged. Source rewriting
+//   perturbs the natural-variance functions themselves, so the divergence
+//   matches what the spoofed GPU would actually produce: the same divergence
+//   from every readback path.
+//
+// Canary preservation strategy:
+//   1. Coarse: if the shader source contains no natural-variance keywords,
+//      return it unchanged. Pure flat-color and pure uniform-read shaders
+//      pass through.
+//   2. Fine: for shaders that DO call natural-variance functions, perturb
+//      only the function inputs (not the outputs). NEAREST texture sampling
+//      rounds the UV perturbation away. The tiny amplitude (~1e-5) sits
+//      inside the natural cross-GPU variance band so the perturbed output
+//      looks like another plausible GPU rasterizer rather than a tampered
+//      one.
+//
+// The implementation works on std::string rather than WTF::String: the
+// rewrite is a byte-level pass over ASCII GLSL that has already been
+// converted for ANGLE, and it converts back at the boundary.
+
+namespace blink {
+
+// Rewrites a fragment shader source for per-profile WebGL variance spoofing.
+// Returns the input unchanged when:
+//   - --webgl-shader-noise is not set, or set to 0
+//   - The source contains no natural-variance constructs (canary shader)
+// The original source remains available via WebGLShader::Source() for
+// gl.getShaderSource(); only the version sent to ANGLE/the GPU is rewritten.
+MODULES_EXPORT String RewriteFragmentShaderForNoise(const String& src);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_SHADER_NOISE_H_
