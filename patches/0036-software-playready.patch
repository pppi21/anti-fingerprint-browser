From 7b1f900abc2e8656bf56d9b4adaa47a9fcbfbc7d Mon Sep 17 00:00:00 2001
From: The browser Authors <noreply@browser.invalid>
Date: Sat, 19 Sep 2026 23:46:15 -0400
Subject: [PATCH 36/41] software-playready

Software-secure PlayReady (SL2000) through the OS Media Foundation CDM for
allow-listed origins (primevideo.com and amazon.com by default;
--software-playready-sites=a,b extends the list, * allows every origin).
Every other origin keeps stock Chromium's NotSupported answer, so the EME
surface is unchanged elsewhere.
---
 chrome/common/media/cdm_registration.cc       | 13 +++++
 .../cdm/renderer/key_system_support_update.cc | 55 +++++++++++++------
 .../cdm/renderer/playready_key_system_info.cc | 53 +++++++++++++-----
 .../cdm/renderer/playready_key_system_info.h  |  6 ++
 content/browser/media/cdm_registry_impl.cc    | 47 ++++++++++++++++
 content/browser/media/cdm_registry_impl.h     | 12 ++++
 .../browser/media/key_system_support_impl.cc  | 22 ++++++++
 .../browser/media/media_interface_proxy.cc    | 20 ++++++-
 media/cdm/win/media_foundation_cdm_util.cc    | 13 +++--
 .../mojo/services/media_foundation_service.cc | 37 ++++++++++---
 10 files changed, 230 insertions(+), 48 deletions(-)

diff --git a/chrome/common/media/cdm_registration.cc b/chrome/common/media/cdm_registration.cc
index 60a79ace42..c36f818612 100644
--- a/chrome/common/media/cdm_registration.cc
+++ b/chrome/common/media/cdm_registration.cc
@@ -375,6 +375,19 @@ void AddPlayReady(std::vector<content::CdmInfo>* cdms) {
                      kPlayReadyCdmDisplayName, kPlayReadyCdmType,
                      playready_version_info->GetFileVersion(),
                      /*path=*/base::FilePath());
+
+  // browser: also register the software secure (SL2000) OS PlayReady CDM,
+  // as Edge does. Its capability is queried lazily through the Media
+  // Foundation service like the hardware secure one, and only allow-listed
+  // origins can see it (CdmRegistryImpl::IsSoftwarePlayReadyAllowedForOrigin),
+  // so every other site sees what stock Chrome reports.
+  cdms->emplace_back(kPlayReadyKeySystemRecommendationDefault,
+                     content::CdmInfo::Robustness::kSoftwareSecure,
+                     /*capability=*/std::nullopt,
+                     /*supports_sub_key_systems=*/true,
+                     kPlayReadyCdmDisplayName, kPlayReadyCdmType,
+                     playready_version_info->GetFileVersion(),
+                     /*path=*/base::FilePath());
 }
 #endif  // BUILDFLAG(ENABLE_PLAYREADY)
 
