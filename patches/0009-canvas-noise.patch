   Draw<OverdrawOp::kNone>(
       /*draw_func=*/
       [font, text = std::move(text), direction, bidi_override, location,
-       run_start, run_end, canvas, &text_painter](MemoryManagedPaintCanvas* c,
-                                                  const cc::PaintFlags* flags) {
+       run_start, run_end, canvas, &text_painter, paint_type,
+       is_accelerated = IsAccelerated()](MemoryManagedPaintCanvas* c,
+                                         const cc::PaintFlags* flags) {
         TextRun text_run(text, direction, bidi_override);
         // Font::DrawType::kGlyphsAndClusters is required for printing to PDF,
         // otherwise the character to glyph mapping will not be reversible,
@@ -1146,9 +1149,42 @@ void BaseRenderingContext2D::DrawTextInternal(
         Font::DrawType draw_type = (canvas && canvas->IsPrinting())
                                        ? Font::DrawType::kGlyphsAndClusters
                                        : Font::DrawType::kGlyphsOnly;
+        // browser: per-profile text rendering perturbations
+        // (--canvas-curve-noise). Two independent surfaces composed on the same
+        // paint:
+        //  - strokeText lw > 1 -> stroke-width sub-pixel shift. Hits Skia's
+        //     stroke-to-fill expansion; offset-curve AA varies naturally
+        //     cross-GPU. Hairline (lw == 1) takes Skia's deterministic
+        //     single-pixel fast path - never perturbed.
+        //  - fillText / strokeText non-black -> per-channel uint8 LUT
+        //     color filter applied to the paint. Operates post-shader on
+        //     pre-multiplied pixels, so it covers monochrome non-black
+        //     text (paint.color x glyph coverage) AND color emoji bitmaps
+        //     (paint.color ignored, bitmap pixels flow through the filter).
+        //     table[0]=0 invariant keeps #000 monochrome canary on both
+        //     fill and stroke paths.
+        // Both surfaces stack on strokeText: width-perturbed + color-
+        // filtered. Backend-gated to keep willReadFrequently canvases
+        // bit-identical to canonical Chrome (paint(CPU) invariance).
+        cc::PaintFlags perturbed_flags;
+        const cc::PaintFlags* effective_flags = flags;
+        if (is_accelerated && CanvasCurveNoiseActive()) {
+          perturbed_flags = *flags;
+          if (paint_type == CanvasRenderingContext2DState::kStrokePaintType &&
+              flags->getStrokeWidth() > 1.0f) {
+            perturbed_flags.setStrokeWidth(PerturbCurveCoord(
+                flags->getStrokeWidth(), kCurveNoiseSaltTextStrokeWidth,
+                kCurveNoiseTextStrokeWidthMultiplier));
+          }
+          if (sk_sp<cc::ColorFilter> color_filter =
+                  MakeCanvasTextColorPerturbFilter()) {
+            perturbed_flags.setColorFilter(std::move(color_filter));
+          }
+          effective_flags = &perturbed_flags;
+        }
         text_painter.DrawWithBidiReorder(text_run, run_start, run_end, *font,
                                          Font::kUseFallbackIfFontNotReady, *c,
-                                         location, *flags, draw_type);
+                                         location, *effective_flags, draw_type);
       },
       NoOverdraw, bounds, paint_type, CanvasRenderingContext2DState::kNoImage,
       CanvasPerformanceMonitor::DrawType::kText);
