+// browser: the CSS media features reported to pages, resolved once per
+// process from --fingerprint-media-features
+// ("colorScheme,reducedMotion,contrast,forcedColors,colorGamut", "auto" or
+// "seed:<N>"). Cached because every style recalc evaluating these features
+// would otherwise pay the parse.
+struct FingerprintMediaFeatures {
+  bool active = false;
+  // nullopt passes color_scheme through to stock; the other fields always
+  // override while active.
+  std::optional<mojom::blink::PreferredColorScheme> color_scheme;
+  bool reduced_motion = false;
+  mojom::blink::PreferredContrast contrast =
+      mojom::blink::PreferredContrast::kNoPreference;
+  ForcedColors forced_colors = ForcedColors::kNone;
+  ColorSpaceGamut color_gamut = ColorSpaceGamut::SRGB;
+};
+
+std::optional<mojom::blink::PreferredColorScheme> ParseColorScheme(
+    const std::string& value) {
+  if (value == "dark") {
+    return mojom::blink::PreferredColorScheme::kDark;
+  }
+  if (value == "light") {
+    return mojom::blink::PreferredColorScheme::kLight;
+  }
+  return std::nullopt;
+}
+
+mojom::blink::PreferredContrast ParseContrast(const std::string& value) {
+  if (value == "more") {
+    return mojom::blink::PreferredContrast::kMore;
+  }
+  if (value == "less") {
+    return mojom::blink::PreferredContrast::kLess;
+  }
+  if (value == "custom") {
+    return mojom::blink::PreferredContrast::kCustom;
+  }
+  return mojom::blink::PreferredContrast::kNoPreference;
+}
+
+ColorSpaceGamut ParseColorGamut(const std::string& value) {
+  if (value == "rec2020") {
+    return ColorSpaceGamut::BT2020;
+  }
+  if (value == "p3") {
+    return ColorSpaceGamut::P3;
+  }
+  return ColorSpaceGamut::SRGB;
+}
+
+const FingerprintMediaFeatures& CachedFingerprintMediaFeatures() {
+  static const FingerprintMediaFeatures features =
+      browser::ResolveSwitch<FingerprintMediaFeatures>(
+          ::switches::kFingerprintMediaFeatures,
+          [](const std::string& value)
+              -> std::optional<FingerprintMediaFeatures> {
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+            if (parts.size() != 5) {
+              return std::nullopt;
+            }
+            FingerprintMediaFeatures result;
+            result.active = true;
+            result.color_scheme = ParseColorScheme(parts[0]);
+            result.reduced_motion = parts[1] == "reduce";
+            result.contrast = ParseContrast(parts[2]);
+            result.forced_colors = parts[3] == "active" ? ForcedColors::kActive
+                                                        : ForcedColors::kNone;
+            result.color_gamut = ParseColorGamut(parts[4]);
+            return result;
+          },
+          [](int32_t seed) -> FingerprintMediaFeatures {
+            // Only the color scheme and gamut come from the profile; the
+            // other fields keep their defaults.
+            const browser::FingerprintProfile* profile =
+                browser::ProfileForSeed(seed);
+            if (!profile) {
+              return {};
+            }
+            FingerprintMediaFeatures result;
+            result.active = true;
+            result.color_scheme =
+                ParseColorScheme(profile->prefers_color_scheme);
+            result.color_gamut = ParseColorGamut(profile->color_gamut);
+            return result;
+          },
+          FingerprintMediaFeatures{},
+          /*inherit_from_master_seed=*/false)
+          .value;
+  return features;
+}
+
+// browser: the screen size fields of --fingerprint-screen, for the
+// device-width and device-height media features. Each field is optional on
+// its own; a field that is absent or fails to parse stays real.
+struct DeviceSize {
+  std::optional<int> width;
+  std::optional<int> height;
+};
+
+const DeviceSize& CachedDeviceSize() {
+  static const DeviceSize size =
+      browser::ResolveSwitch<DeviceSize>(
+          ::switches::kFingerprintScreen,
+          [](const std::string& value) -> std::optional<DeviceSize> {
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+            if (parts.size() < 6) {
+              return std::nullopt;
+            }
+            DeviceSize result;
+            int width = -1;
+            int height = -1;
+            base::StringToInt(parts[0], &width);
+            base::StringToInt(parts[1], &height);
+            if (width >= 0) {
+              result.width = width;
+            }
+            if (height >= 0) {
+              result.height = height;
+            }
+            return result;
+          },
+          [](int32_t seed) -> DeviceSize {
+            const browser::FingerprintProfile* profile =
+                browser::ProfileForSeed(seed);
+            DeviceSize result;
+            if (profile && profile->screen_width >= 0) {
+              result.width = profile->screen_width;
+            }
+            if (profile && profile->screen_height >= 0) {
+              result.height = profile->screen_height;
+            }
+            return result;
+          },
+          DeviceSize(),
+          /*inherit_from_master_seed=*/false)
+          .value;
+  return size;
+}
+
