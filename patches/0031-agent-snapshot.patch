+#include "third_party/blink/renderer/core/dom/node.h"
+#include "third_party/blink/renderer/core/dom/shadow_root.h"
+#include "third_party/blink/renderer/core/event_type_names.h"
+#include "third_party/blink/renderer/core/frame/frame.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/geometry/dom_rect.h"
+#include "third_party/blink/renderer/core/html/forms/html_input_element.h"
+#include "third_party/blink/renderer/core/html/forms/html_option_element.h"
+#include "third_party/blink/renderer/core/html/forms/html_select_element.h"
+#include "third_party/blink/renderer/core/html/forms/html_text_area_element.h"
+#include "third_party/blink/renderer/core/html/forms/text_control_element.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/core/layout/layout_object.h"
+#include "third_party/blink/renderer/core/style/computed_style.h"
+#include "third_party/blink/renderer/core/style/computed_style_constants.h"
+#include "third_party/blink/renderer/modules/accessibility/ax_object.h"
+#include "third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_vector.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector_traits.h"
+#include "ui/accessibility/ax_mode.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace blink {
+
+namespace {
+
+// Reads a URL-valued attribute resolved against the document base URL.
+// Guarded by the element's own IsURLAttribute rather than by tag name: a
+// stray href on a <div> is not a URL attribute, and Element::GetURLAttribute
+// DCHECKs on exactly that. Returns a null String when there is no such
+// attribute.
+String UrlAttribute(const Element* element, const QualifiedName& name) {
+  if (!element->FastHasAttribute(name)) {
+    return String();
+  }
+  const Attribute* attribute = element->Attributes().Find(name);
+  if (!attribute || !element->IsURLAttribute(*attribute)) {
+    return String();
+  }
+  return element->GetURLAttribute(name);
+}
+
+bool RoleIn(const String& role, base::span<const char* const> roles) {
+  for (const char* candidate : roles) {
+    if (role == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Roles (as produced by AXObject::RoleName) that are actionable by
+// themselves.
+bool IsInteractiveRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "button",        "link",         "textbox",   "checkbox",
+      "radio",         "combobox",     "menuitem",  "menuitemcheckbox",
+      "menuitemradio", "tab",          "switch",    "slider",
+      "searchbox",     "spinbutton",   "option",    "listbox",
+      "menu",          "radiogroup",   "scrollbar", "treeitem",
+      "gridcell",      "columnheader", "rowheader"};
+  return RoleIn(role, kRoles);
+}
+
+// Roles with no semantics of their own; a non-interactive element with one
+// of these is dropped to keep the snapshot small.
+bool IsGenericRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "generic", "GenericContainer", "none", "presentation", "IgnoredGeneric"};
+  return role.empty() || RoleIn(role, kRoles);
+}
+
+bool HasClickListener(Node* node) {
+  return node->HasEventListeners(event_type_names::kClick) ||
+         node->HasEventListeners(event_type_names::kMousedown) ||
+         node->HasEventListeners(event_type_names::kMouseup) ||
+         node->HasEventListeners(event_type_names::kKeydown) ||
+         node->HasEventListeners(event_type_names::kPointerdown);
+}
+
+bool HasPointerCursor(Element* element) {
+  const LayoutObject* layout_object = element->GetLayoutObject();
+  return layout_object &&
+         layout_object->StyleRef().Cursor() == ECursor::kPointer;
+}
+
+// Current value for form controls; empty for everything else.
+String FormControlValue(Element* element) {
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    return input->Value();
+  }
+  if (auto* textarea = DynamicTo<HTMLTextAreaElement>(element)) {
+    return textarea->Value();
+  }
+  if (auto* select = DynamicTo<HTMLSelectElement>(element)) {
+    return select->Value();
+  }
+  return String();
+}
+
+// Why an element counts as interactive, strongest signal first. The string
+// form goes on the wire; the enum order ranks coincident nested elements.
+enum class InteractiveReason {
+  kNone,
+  kTabIndex,
+  kCursor,
+  kListener,
+  kFormControl,
+  kRole,
+};
+
+InteractiveReason ClassifyInteractive(Element* element, const String& role) {
+  if (IsInteractiveRole(role)) {
+    return InteractiveReason::kRole;
+  }
+  if (element->IsFormControlElement()) {
+    return InteractiveReason::kFormControl;
+  }
+  if (HasClickListener(element)) {
+    return InteractiveReason::kListener;
+  }
+  if (HasPointerCursor(element)) {
+    return InteractiveReason::kCursor;
+  }
+  if (element->tabIndex() >= 0) {
+    return InteractiveReason::kTabIndex;
+  }
+  return InteractiveReason::kNone;
+}
+
+String InteractiveReasonName(InteractiveReason reason) {
+  switch (reason) {
+    case InteractiveReason::kNone:
+      return "";
+    case InteractiveReason::kTabIndex:
+      return "tabindex";
+    case InteractiveReason::kCursor:
+      return "cursor";
+    case InteractiveReason::kListener:
+      return "listener";
+    case InteractiveReason::kFormControl:
+      return "form-control";
+    case InteractiveReason::kRole:
+      return "role";
+  }
+  NOTREACHED();
+}
+
+Vector<String> ElementStates(Element* element) {
+  Vector<String> states;
+  states.push_back("visible");
+
+  if (element->IsDisabledFormControl()) {
+    states.push_back("disabled");
+  } else if (element->IsFormControlElement()) {
+    states.push_back("enabled");
+  }
+  if (element->IsFocusable(Element::UpdateBehavior::kNoneForAccessibility)) {
+    states.push_back("focusable");
+  }
+  if (element->IsFocusedElementInDocument()) {
+    states.push_back("focused");
+  }
+  if (element->FastHasAttribute(html_names::kContenteditableAttr) ||
+      IsA<TextControlElement>(element)) {
+    states.push_back("editable");
+  }
+  if (auto* input = DynamicTo<HTMLInputElement>(element);
+      input && input->Checked()) {
+    states.push_back("checked");
+  }
+  if (auto* option = DynamicTo<HTMLOptionElement>(element)) {
+    if (option->Selected()) {
+      states.push_back("selected");
+    }
+  } else if (EqualIgnoringAsciiCase(
+                 element->FastGetAttribute(html_names::kAriaSelectedAttr),
+                 "true")) {
+    states.push_back("selected");
+  }
+  if (EqualIgnoringAsciiCase(
+          element->FastGetAttribute(html_names::kAriaExpandedAttr), "true")) {
+    states.push_back("expanded");
+  }
+  if (element->FastHasAttribute(html_names::kReadonlyAttr)) {
+    states.push_back("readonly");
+  }
+  if (element->FastHasAttribute(html_names::kRequiredAttr)) {
+    states.push_back("required");
+  }
+  return states;
+}
+
+// Mojo rejects a null WTF::String in a non-nullable string field
+// (RESULT_CODE_KILLED_BAD_MESSAGE), and both String() and several AX getters
+// produce null strings, so every wire value goes through here.
+String NonNull(const String& s) {
+  return s.IsNull() ? String("") : s;
+}
+
+// Next ancestor element, crossing shadow boundaries into the shadow host.
+Element* AncestorElement(Element* element) {
+  if (Element* parent = element->parentElement()) {
+    return parent;
+  }
+  return element->OwnerShadowHost();
+}
+
+// Local-root CSS-pixel border-box, captured before the AX cache is frozen.
+struct ElementBox {
+  double x = 0;
+  double y = 0;
+  double width = 0;
+  double height = 0;
+};
+
+// What the dedup pass needs to know about each emitted element.
+struct KeptElement {
+  DISALLOW_NEW();
+
+ public:
+  void Trace(Visitor* visitor) const { visitor->Trace(element); }
+
+  Member<Element> element;
+  ElementBox box;
+  InteractiveReason reason = InteractiveReason::kNone;
+};
+
+// A candidate from the geometry pass.
+struct Candidate {
+  DISALLOW_NEW();
+
+ public:
+  void Trace(Visitor* visitor) const { visitor->Trace(element); }
+
+  Member<Element> element;
+  ElementBox box;
+  bool in_frame_viewport = false;
+};
+
+struct Collected {
+  STACK_ALLOCATED();
+
+ public:
+  Vector<mojom::blink::AgentElementPtr> elements;
+  HeapVector<KeptElement> kept;
+};
+
