+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_DETERMINISTIC_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_DETERMINISTIC_NOISE_H_
+
+#include <cstdint>
+#include <cstring>
+
+namespace blink {
+
+// Deterministic sub-unit noise for the per-profile rendering perturbations
+// (canvas curve coordinates, blur sigmas, gradient stops, text color LUTs).
+//
+// Mixes `bits` with `salt` through a 32-bit integer hash and maps the result
+// onto [-0.5, 0.5). The same (bits, salt) pair always yields the same value,
+// which the per-machine calibration of every consumer depends on; distinct
+// salts keep the perturbations of different surfaces uncorrelated.
+inline float DeterministicSignedUnitNoise(uint32_t bits, uint32_t salt) {
+  uint32_t h = bits ^ salt;
+  h ^= h >> 16;
+  h *= 0x7feb352du;
+  h ^= h >> 15;
+  h *= 0x846ca68bu;
+  h ^= h >> 16;
+  return static_cast<float>(static_cast<int32_t>(h)) / 4294967296.0f;
+}
+
+// Same, keyed on the bit pattern of a float value.
+inline float DeterministicSignedUnitNoise(float value, uint32_t salt) {
+  uint32_t bits;
+  static_assert(sizeof(bits) == sizeof(value));
+  std::memcpy(&bits, &value, sizeof(bits));
+  return DeterministicSignedUnitNoise(bits, salt);
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_DETERMINISTIC_NOISE_H_
