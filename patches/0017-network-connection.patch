index 0000000000..93671c6979
--- /dev/null
+++ b/components/browser/connection_override.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/connection_override.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/switch_resolver.h"
+
+namespace browser {
+
+namespace {
+
+std::optional<ConnectionOverride> ParseExplicit(const std::string& value) {
+  std::vector<std::string> parts = base::SplitString(
+      value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() != 5) {
+    return std::nullopt;
+  }
+  ConnectionOverride result;
+  result.active = true;
+  result.effective_type = parts[0];
+  unsigned rtt_ms = 0;
+  if (!base::StringToDouble(parts[1], &result.downlink_mbps) ||
+      !base::StringToUint(parts[2], &rtt_ms)) {
+    return std::nullopt;
+  }
+  result.rtt_ms = rtt_ms;
+  result.save_data = base::EqualsCaseInsensitiveASCII(parts[3], "true");
+  result.connection_type = parts[4];
+  return result;
+}
+
+// 65% wifi, 35% ethernet, each with its own plausible downlink and RTT
+// range. effectiveType is always "4g", as modern broadband presents to the
+// API, and saveData is always false.
+ConnectionOverride DeriveFromSeed(int32_t seed) {
+  const bool is_wifi = DeterministicBucket(seed, kSaltConnectionType, 100) < 65;
+
+  // Downlink in Mbps: wifi [15, 50), ethernet [50, 100), on a 100-step grid.
+  const double downlink_base = is_wifi ? 15.0 : 50.0;
+  const double downlink_range = is_wifi ? 35.0 : 50.0;
+  const double downlink_mbps =
+      downlink_base + DeterministicBucket(seed, kSaltConnectionDownlink, 100) *
+                          (downlink_range / 100.0);
+
+  // RTT in ms: wifi [50, 150), ethernet [20, 80).
+  const uint32_t rtt_base = is_wifi ? 50u : 20u;
+  const uint32_t rtt_range = is_wifi ? 100u : 60u;
+  const uint32_t rtt_ms =
+      rtt_base + DeterministicBucket(seed, kSaltConnectionRtt, rtt_range);
+
+  return ConnectionOverride{true,   "4g",  downlink_mbps,
+                            rtt_ms, false, is_wifi ? "wifi" : "ethernet"};
+}
+
+}  // namespace
+
+const ConnectionOverride& GetConnectionOverride() {
+  static const base::NoDestructor<ConnectionOverride> resolved(
+      ResolveSwitch<ConnectionOverride>(switches::kFingerprintConnection,
+                                        ParseExplicit, DeriveFromSeed,
+                                        ConnectionOverride())
+          .value);
+  return *resolved;
+}
+
+}  // namespace browser
