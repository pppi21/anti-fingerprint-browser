+
+WTF_ALLOW_MOVE_AND_INIT_WITH_MEM_FUNCTIONS(blink::KeptElement)
+WTF_ALLOW_MOVE_AND_INIT_WITH_MEM_FUNCTIONS(blink::Candidate)
+
+namespace blink {
+
+namespace {
+
+// This local root plus every same-process descendant frame, depth first.
+// Remote (OOPIF) frames are separate local roots that the browser drives
+// with their own CollectFrameElements() call, so descending into them here
+// would count their elements twice.
+void CollectSameProcessFrames(LocalFrame* frame,
+                              HeapVector<Member<LocalFrame>>& out) {
+  out.push_back(frame);
+  for (Frame* child = frame->FirstChild(); child;
+       child = child->NextSibling()) {
+    if (auto* local_child = DynamicTo<LocalFrame>(child)) {
+      CollectSameProcessFrames(local_child, out);
+    }
+  }
+}
+
+// Collects one same-process frame's document in two passes: geometry first,
+// then accessibility under a frozen AX cache. Forcing a layout update while
+// the cache is frozen violates a Blink invariant and crashes the renderer,
+// so every layout-dependent read (viewport size, bounding boxes) happens in
+// the first pass. Boxes are returned in the local root's coordinate space
+// (LocalFrameView::ConvertToRootFrame), so the browser composes all frames
+// of a local root with one view transform.
+void CollectFrameDocumentElements(
+    LocalFrame* frame,
+    mojom::blink::AgentOffscreenMode offscreen_mode,
+    Collected& out) {
+  Document* document = frame->GetDocument();
+  if (!document || !document->documentElement() || !document->View()) {
+    return;
+  }
+  LocalFrameView* view = document->View();
+  document->UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+
+  LocalDOMWindow* window = frame->DomWindow();
+  const double viewport_width = window ? window->innerWidth() : 0;
+  const double viewport_height = window ? window->innerHeight() : 0;
+
+  // Pass 1: geometry. Depth first over this document, descending into open
+  // and closed shadow trees but not into child frames.
+  HeapVector<Candidate> candidates;
+  {
+    HeapVector<Member<ContainerNode>> stack;
+    stack.push_back(document->documentElement());
+    while (!stack.empty()) {
+      ContainerNode* node = stack.back();
+      stack.pop_back();
+      for (Node* child = node->firstChild(); child;
+           child = child->nextSibling()) {
+        if (auto* child_container = DynamicTo<ContainerNode>(child)) {
+          stack.push_back(child_container);
+        }
+        auto* element = DynamicTo<Element>(child);
+        if (!element) {
+          continue;
+        }
+        if (ShadowRoot* shadow_root = element->GetShadowRoot()) {
+          stack.push_back(shadow_root);
+        }
+        // Non-rendered elements are not reported.
+        if (!element->GetLayoutObject()) {
+          continue;
+        }
+        DOMRect* rect = element->GetBoundingClientRect();
+        // Identity for the local root's own document; for a same-process
+        // subframe this adds the subframe's in-root offset, which the
+        // browser-side transform drops because such subframes share the
+        // local root's widget view.
+        const gfx::PointF root_top_left =
+            view->ConvertToRootFrame(gfx::PointF(rect->x(), rect->y()));
+        // The viewport test stays per frame: frame-local rect against the
+        // frame's own viewport.
+        Candidate candidate;
+        candidate.element = element;
+        candidate.box = {root_top_left.x(), root_top_left.y(), rect->width(),
+                         rect->height()};
+        candidate.in_frame_viewport =
+            rect->x() < viewport_width && rect->x() + rect->width() > 0 &&
+            rect->y() < viewport_height && rect->y() + rect->height() > 0;
+        candidates.push_back(candidate);
+      }
+    }
+  }
+
+  // Pass 2: accessibility role and name, then classification. Every
+  // Document owns its own AXObjectCache, so accessibility is enabled and the
+  // cache frozen per document. ExistingAXObjectCache() rather than
+  // AXContext::GetAXObjectCache(): the latter has preconditions that are not
+  // met here and can crash the renderer (see InspectorAccessibilityAgent).
+  // Constructing the AXContext is what creates the cache.
+  AXContext ax_context(*document, ui::kAXModeComplete);
+  AXObjectCache* base_cache = document->ExistingAXObjectCache();
+  if (!base_cache) {
+    return;
+  }
+  auto& cache = To<AXObjectCacheImpl>(*base_cache);
+  cache.UpdateAXForAllDocuments();
+  ScopedFreezeAXCache freeze(cache);
+
+  for (const Candidate& candidate : candidates) {
+    Element* element = candidate.element;
+    String role;
+    String name;
+    String description;
+    if (AXObject* ax = cache.Get(element)) {
+      role = AXObject::RoleName(ax->RoleValue());
+      ax::mojom::blink::NameFrom name_from;
+      name = ax->ComputedName(&name_from);
+      ax::mojom::blink::DescriptionFrom description_from;
+      AXObject::AXObjectVector description_objects;
+      description =
+          ax->Description(name_from, description_from, &description_objects);
+    }
+    if (role.empty()) {
+      role = element->localName();
+    }
+
+    const InteractiveReason reason = ClassifyInteractive(element, role);
+    const bool interactive = reason != InteractiveReason::kNone;
+    // Non-interactive elements are kept only when they carry semantics and
+    // occupy space.
+    if (!interactive && (IsGenericRole(role) || (candidate.box.width == 0 &&
+                                                 candidate.box.height == 0))) {
+      continue;
+    }
+    if (offscreen_mode == mojom::blink::AgentOffscreenMode::kNone &&
+        !candidate.in_frame_viewport) {
+      continue;
+    }
+
+    auto agent_element = mojom::blink::AgentElement::New();
+    agent_element->backend_node_id =
+        static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+    agent_element->role = NonNull(role);
+    agent_element->name = NonNull(name);
+    agent_element->value = NonNull(FormControlValue(element));
+    agent_element->description = NonNull(description);
+    agent_element->tag = NonNull(element->localName());
+    agent_element->interactive = interactive;
+    agent_element->interactive_reason = InteractiveReasonName(reason);
+    agent_element->states = ElementStates(element);
+    agent_element->box = mojom::blink::AgentElementBox::New(
+        candidate.box.x, candidate.box.y, candidate.box.width,
+        candidate.box.height);
+    agent_element->in_frame_viewport = candidate.in_frame_viewport;
+    // Resolved against the document base, so the agent gets the URL a click
+    // would navigate to rather than a relative fragment.
+    agent_element->href = NonNull(UrlAttribute(element, html_names::kHrefAttr));
+    agent_element->src = NonNull(UrlAttribute(element, html_names::kSrcAttr));
+    Element* shadow_host = element->OwnerShadowHost();
+    agent_element->shadow_host_backend_node_id =
+        shadow_host ? static_cast<int32_t>(DOMNodeIds::IdForNode(shadow_host))
+                    : 0;
+
+    out.elements.push_back(std::move(agent_element));
+    KeptElement kept;
+    kept.element = element;
+    kept.box = candidate.box;
+    kept.reason = reason;
+    out.kept.push_back(kept);
+  }
+}
+
+// Drops the weaker of two coincident nested interactive elements: when an
+// interactive element nearly fills its nearest interactive ancestor, they are
+// the same click target. The stronger interactivity signal wins and a tie
+// keeps the outer element. Nested controls with dissimilar bounds are left
+// alone. Returns one flag per element.
+Vector<bool> CoincidentNestedElements(const HeapVector<KeptElement>& kept) {
+  HeapHashMap<Member<Element>, wtf_size_t> interactive_index;
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (kept[i].reason != InteractiveReason::kNone) {
+      interactive_index.insert(kept[i].element, i);
+    }
+  }
+  Vector<bool> removed(kept.size());
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (kept[i].reason == InteractiveReason::kNone) {
+      continue;
+    }
+    for (Element* ancestor = AncestorElement(kept[i].element); ancestor;
+         ancestor = AncestorElement(ancestor)) {
+      auto it = interactive_index.find(ancestor);
+      if (it == interactive_index.end()) {
+        continue;
+      }
+      const wtf_size_t j = it->value;
+      const double area_i = kept[i].box.width * kept[i].box.height;
+      const double area_j = kept[j].box.width * kept[j].box.height;
+      if (area_j > 0 && area_i >= 0.75 * area_j) {
+        if (kept[i].reason > kept[j].reason) {
+          removed[j] = true;
+        } else {
+          removed[i] = true;
+        }
+      }
+      break;  // Only the nearest interactive ancestor counts.
+    }
+  }
+  return removed;
+}
+
+}  // namespace
+
+// static
+const char AgentSnapshotCollectorImpl::kSupplementName[] =
+    "AgentSnapshotCollectorImpl";
+
+// static
+AgentSnapshotCollectorImpl* AgentSnapshotCollectorImpl::From(
+    Document& document) {
+  return Supplement<Document>::From<AgentSnapshotCollectorImpl>(document);
+}
+
+// static
+void AgentSnapshotCollectorImpl::BindReceiver(
+    LocalFrame* frame,
+    mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver) {
+  DCHECK(frame && frame->GetDocument());
+  auto& document = *frame->GetDocument();
+  auto* collector = AgentSnapshotCollectorImpl::From(document);
+  if (!collector) {
+    collector = MakeGarbageCollected<AgentSnapshotCollectorImpl>(
+        base::PassKey<AgentSnapshotCollectorImpl>(), *frame);
+    Supplement<Document>::ProvideTo(document, collector);
+  }
+  collector->Bind(std::move(receiver));
+}
+
+AgentSnapshotCollectorImpl::AgentSnapshotCollectorImpl(
+    base::PassKey<AgentSnapshotCollectorImpl>,
+    LocalFrame& frame)
+    : Supplement<Document>(*frame.GetDocument()),
+      receiver_set_(this, frame.DomWindow()) {}
+
+AgentSnapshotCollectorImpl::~AgentSnapshotCollectorImpl() = default;
+
+void AgentSnapshotCollectorImpl::Bind(
+    mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver) {
+  receiver_set_.Add(
+      std::move(receiver),
+      GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+}
+
+void AgentSnapshotCollectorImpl::Trace(Visitor* visitor) const {
+  visitor->Trace(receiver_set_);
+  Supplement<Document>::Trace(visitor);
+}
+
+void AgentSnapshotCollectorImpl::CollectFrameElements(
+    mojom::blink::AgentSnapshotOptionsPtr options,
+    CollectFrameElementsCallback callback) {
+  auto result = mojom::blink::AgentFrameSnapshot::New();
+
+  LocalFrame* root_frame = GetSupplementable()->GetFrame();
+  Document* root_document = GetSupplementable();
+  if (!root_frame || !root_document || !root_document->documentElement() ||
+      !root_document->View()) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  const mojom::blink::AgentOffscreenMode offscreen_mode =
+      options ? options->offscreen_mode
+              : mojom::blink::AgentOffscreenMode::kSummary;
+
+  // The browser calls this on local roots only; same-process descendants are
+  // walked here with their boxes expressed in this local root's space.
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(root_frame, frames);
+  Collected collected;
+  for (LocalFrame* frame : frames) {
+    CollectFrameDocumentElements(frame, offscreen_mode, collected);
+  }
+
+  const Vector<bool> removed = CoincidentNestedElements(collected.kept);
+  result->elements.ReserveInitialCapacity(collected.elements.size());
+  for (wtf_size_t i = 0; i < collected.elements.size(); ++i) {
+    if (!removed[i]) {
+      result->elements.push_back(std::move(collected.elements[i]));
+    }
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void AgentSnapshotCollectorImpl::ResolveNode(int32_t local_dom_node_id,
+                                             ResolveNodeCallback callback) {
+  // The mojo `box` field is non-nullable, so a not-found reply carries a
+  // zero box.
+  auto not_found = [&callback]() {
+    std::move(callback).Run(
+        /*found=*/false,
+        mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0));
+  };
+
+  // DOMNodeIds are process-global, so this also resolves nodes in the
+  // same-process subframes whose ids CollectFrameElements handed out.
+  auto* element = DynamicTo<Element>(DOMNodeIds::NodeForId(local_dom_node_id));
+  if (!element || !element->GetLayoutObject()) {
+    not_found();
+    return;
+  }
+  Document& document = element->GetDocument();
+  LocalFrame* frame = document.GetFrame();
+  if (!frame || !frame->View()) {
+    not_found();
+    return;
+  }
+
+  // Same layout update as the capture path; geometry only, no AX cache.
+  document.UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  // Layout can run script and detach the element.
+  if (!element->GetLayoutObject()) {
+    not_found();
+    return;
+  }
+
+  // Local-root space, exactly as CollectFrameDocumentElements reports it.
+  DOMRect* rect = element->GetBoundingClientRect();
+  const gfx::PointF root_top_left =
+      frame->View()->ConvertToRootFrame(gfx::PointF(rect->x(), rect->y()));
+  std::move(callback).Run(
+      /*found=*/true,
+      mojom::blink::AgentElementBox::New(root_top_left.x(), root_top_left.y(),
+                                         rect->width(), rect->height()));
+}
+
+}  // namespace blink
