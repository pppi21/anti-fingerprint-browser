+// static
+bool CdmRegistryImpl::IsPlayReadyKeySystem(const std::string& key_system) {
+  static constexpr char kPlayReadyKeySystemBase[] =
+      "com.microsoft.playready.recommendation";
+  return key_system == kPlayReadyKeySystemBase ||
+         media::IsSubKeySystemOf(key_system, kPlayReadyKeySystemBase);
+}
+
+// static
+bool CdmRegistryImpl::IsSoftwarePlayReadyAllowedForOrigin(
+    const url::Origin& origin) {
+  static const base::NoDestructor<std::vector<std::string>> allowed_sites([] {
+    std::vector<std::string> sites = {"primevideo.com", "amazon.com"};
+    for (const std::string& site : base::SplitString(
+             base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                 switches::kSoftwarePlayreadySites),
+             ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      sites.push_back(base::ToLowerASCII(site));
+    }
+    return sites;
+  }());
+
+  if (origin.opaque()) {
+    return false;
+  }
+  const std::string host = base::ToLowerASCII(origin.host());
+  for (const std::string& site : *allowed_sites) {
+    if (site == "*" || host == site || base::EndsWith(host, "." + site)) {
+      return true;
+    }
+  }
+  return false;
+}
+
 // TODO(xhwang): Find a way to register this as callbacks so we don't have to
 // hardcode platform-specific logic here.
 void CdmRegistryImpl::LazyInitializeCapability(
@@ -573,6 +609,17 @@ void CdmRegistryImpl::LazyInitializeCapability(
         key_system, cdm_info->type, cdm_info->path,
         /*is_hw_secure=*/true, std::move(cdm_capability_cb));
   } else {
+    // browser: the OS PlayReady CDM has no manifest, so its software secure
+    // capability is queried through the Media Foundation service exactly
+    // like the hardware secure one.
+    auto cdm_info =
+        GetCdmInfo(key_system, CdmInfo::Robustness::kSoftwareSecure);
+    if (cdm_info && !cdm_info->capability && IsPlayReadyKeySystem(key_system)) {
+      GetMediaFoundationServiceCdmCapability(
+          key_system, cdm_info->type, cdm_info->path,
+          /*is_hw_secure=*/false, std::move(cdm_capability_cb));
+      return;
+    }
     // kSoftwareSecure should have been determined from the manifest.
     std::move(cdm_capability_cb)
         .Run(base::unexpected(media::CdmCapabilityQueryStatus::kUnknown));
