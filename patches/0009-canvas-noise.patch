+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_CANVAS_CURVE_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_CANVAS_CURVE_NOISE_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+
+namespace cc {
+class ColorFilter;
+}  // namespace cc
+
+// Canvas 2D curve-verb coordinate perturbation (--canvas-curve-noise).
+//
+// Applied at draw-submit time inside Canvas2DRecorderContext::DrawPathInternal
+// and only when the canvas resource provider is GPU-accelerated. CPU-backed
+// canvases (e.g. willReadFrequently:true) see unperturbed geometry so their
+// output stays bit-identical to canonical Chrome/Skia-software - preserving
+// paint(CPU) invariance that fingerprint libraries like CreepJS rely on.
+//
+// Curve verbs (Quad / Conic / Cubic) are perturbed by deterministic sub-pixel
+// offsets derived from each coord's bit pattern and a per-axis salt. Line /
+// Move / Close verbs pass through unchanged. The result: curved output
+// diverges per profile on GPU, matching the natural cross-GPU variance
+// pattern of real hardware, while non-curve geometry stays canonical.
+
+namespace blink {
+
+// Minimum path-bounds dimension (in CSS pixels) for the walker to perturb at
+// all. Paths smaller than this on either axis are passed through unchanged.
+//
+// Rationale: CreepJS's "KnownImageData" lie-detector renders
+// `arc(0, 0, 2, 0, 1, true)` into a 2x2 canvas and compares the resulting
+// 4-pixel output against a hardcoded list of 8 canonical Blink outputs.
+// At such tiny scales our sub-pixel perturbation dominates the output and
+// no longer looks like natural GPU variance - the 4 pixels fall into
+// amplitude-dependent buckets that mostly miss the canonical list, setting
+// LowerEntropy.CANVAS=true (which in turn red-flags the canvas AND webgl
+// hashes in the CreepJS UI via a shared bold-fail class).
+//
+// Paths this small don't contribute meaningful variance to real fingerprint
+// surfaces anyway - skipping them preserves the canary invariant at zero
+// spoof cost.
+inline constexpr float kCurveNoiseMinBoundsPx = 5.0f;
+
+// Amplitude multipliers applied to verb/paint-type combinations where small
+// control-point offsets are naturally less visible in the rasterized output.
+//
+// Conic (arcTo) has tangent-self-correcting geometry: shifting a control
+// point by epsilon barely moves the tangent points where the arc meets its
+// adjacent edges, so small perturbations round to the same pixels. Amplify.
+//
+// Fills are topology-based - a pixel is either inside or outside the closed
+// path. Small boundary offsets rarely cross pixel-center sample points, so
+// interior pixels stay interior and the hash doesn't change. Amplify.
+//
+// Multipliers compose via std::max, not product, so an arcTo fill stays at
+// the conic amplitude rather than exploding to 25x.
+inline constexpr float kCurveNoiseConicMultiplier = 5.0f;
+inline constexpr float kCurveNoiseFillMultiplier = 5.0f;
+// Non-axis-aligned line verbs. Three distinct multipliers because the
+// rasterization characteristics differ sharply by geometry:
+//
+//  - kCurveNoiseLineDiagMultiplier (walker kLine_Verb, 3.4x) - covers
+//     multi-segment strokes like round line join where the join arc has
+//     granular AA buckets requiring moderate amplification.
+//  - kCurveNoiseLineDiagDashedMultiplier (IsLine fast path + dashed, 3x) -
+//     dashed segments are many small stroked rectangles; endpoint shifts
+//     propagate into dash pattern placement. Higher amplification.
+//   - kCurveNoiseLineDiagPlainMultiplier (IsLine fast path + no dash, 0.25x)
+//     - plain diagonals rasterize to a uniform AA band; large perturbations
+//     over-shift and the hash cycles through values that collide with
+//     previously-seen buckets. Small perturbation lands more cleanly in a
+//     single new bucket.
+inline constexpr float kCurveNoiseLineDiagMultiplier = 3.4f;
+inline constexpr float kCurveNoiseLineDiagDashedMultiplier = 3.0f;
+inline constexpr float kCurveNoiseLineDiagPlainMultiplier = 0.25f;
+
+// Per-axis salts used by PerturbCurveCoord to keep perturbations
+// de-correlated across different verb types.
+inline constexpr uint32_t kCurveNoiseSaltQuadCpX = 0x101u;
+inline constexpr uint32_t kCurveNoiseSaltQuadCpY = 0x102u;
+inline constexpr uint32_t kCurveNoiseSaltQuadEndX = 0x103u;
+inline constexpr uint32_t kCurveNoiseSaltQuadEndY = 0x104u;
+inline constexpr uint32_t kCurveNoiseSaltBezCp1X = 0x201u;
+inline constexpr uint32_t kCurveNoiseSaltBezCp1Y = 0x202u;
+inline constexpr uint32_t kCurveNoiseSaltBezCp2X = 0x203u;
+inline constexpr uint32_t kCurveNoiseSaltBezCp2Y = 0x204u;
+inline constexpr uint32_t kCurveNoiseSaltBezEndX = 0x205u;
+inline constexpr uint32_t kCurveNoiseSaltBezEndY = 0x206u;
+inline constexpr uint32_t kCurveNoiseSaltConicCpX = 0x301u;
+inline constexpr uint32_t kCurveNoiseSaltConicCpY = 0x302u;
+inline constexpr uint32_t kCurveNoiseSaltConicEndX = 0x303u;
+inline constexpr uint32_t kCurveNoiseSaltConicEndY = 0x304u;
+inline constexpr uint32_t kCurveNoiseSaltArcX = 0x401u;
+inline constexpr uint32_t kCurveNoiseSaltArcY = 0x402u;
+inline constexpr uint32_t kCurveNoiseSaltArcR = 0x403u;
+
+// Salts for non-axis-aligned line-verb endpoint perturbation. Covers
+// diagonal strokes, polygon diagonal edges (triangle fills), dashed
+// diagonal dash endpoints, and round-join diagonal body. Axis-aligned
+// line verbs (pure horizontal/vertical) are deterministic canary geometry
+// and are never perturbed.
+inline constexpr uint32_t kCurveNoiseSaltLineDiagX = 0x601u;
+inline constexpr uint32_t kCurveNoiseSaltLineDiagY = 0x602u;
+
+// Salts for blur-sigma perturbation (Gaussian blur scale parameter).
+// Shadow and filter:blur both feed sigmas through PerturbBlurSigma, with
+// different salts so the same sigma value in a shadow vs a filter produces
+// independent perturbations.
+inline constexpr uint32_t kBlurNoiseSaltShadow = 0x701u;
+inline constexpr uint32_t kBlurNoiseSaltFilterStdX = 0x702u;
+inline constexpr uint32_t kBlurNoiseSaltFilterStdY = 0x703u;
+
+// Salt for text-stroke-width perturbation. strokeText with lineWidth > 1
+// goes through Skia's stroke-to-fill expansion; the resulting offset
+// curves rasterize with cross-GPU AA variance on real hardware. A small
+// additive perturbation of the stroke width shifts those expansion edges
+// sub-pixel and produces per-profile variance that matches the natural
+// pattern. Hairline (lineWidth == 1) takes Skia's deterministic
+// single-pixel fast path and is never perturbed - guard at the call site
+// keeps that path canary. Scoped to DrawTextInternal so strokeRect and
+// stroke(SkPath) paths are untouched (axis-aligned strokes there are
+// deterministic on real hardware).
+inline constexpr uint32_t kCurveNoiseSaltTextStrokeWidth = 0x801u;
+
+// Amplitude multiplier for text-stroke-width perturbation. Calibrated so
+// that the derived base scalar (0.003 .. 0.015) maps into the natural cross-GPU
+// variance band for strokeText with lineWidth > 1.
+// Empirically: with multiplier=1.0, the hash flips at --canvas-curve-noise
+// = 5e-7 and steps to a new distinct hash about every 7e-7. Sitting at
+// the bare minimum (5e-7) wastes the range. Anchoring the minimum
+// at 1.5e-6 instead (multiplier = 1.5e-6 / 0.003 = 5e-4) maps the
+// minimum 0.003 -> 1.5e-6 and 0.015 (max) -> 7.5e-6, yielding distinct
+// hash buckets across the 201 seed steps while staying inside the
+// natural variance band.
+inline constexpr float kCurveNoiseTextStrokeWidthMultiplier = 5e-4f;
+
+// Amplitude multiplier for text/emoji color perturbation. Applied at
+// fillText / strokeText draw time via a per-channel uint8 LUT
+// (cc::ColorFilter TableARGB) on the paint. Backend-gated by setting
+// the filter only on GPU canvases - willReadFrequently canvases skip
+// the setColorFilter call so paint(CPU) output stays bit-identical to
+// canonical Chrome.
+//
+// Covers two surfaces in one mechanism:
+//  - Non-black monochrome text - shader output is paint.color x glyph
+//     coverage (pre-multiplied). Per-channel LUT shifts RGB by +/-N LSB
+//     where the input is non-zero; sub-pixel coverage edges flip.
+//  - Color emoji bitmaps - shader output is bitmap_pixel pre-multiplied
+//     (paint.color is ignored for color glyphs, but the paint's
+//     ColorFilter still applies). LUT shifts non-black bitmap pixels;
+//     transparent/black bitmap regions stay canonical.
+//
+// table[0] = 0 invariant on R/G/B preserves the #000 canary: pure black
+// monochrome glyph pixels (R=G=B=0 pre-mult, any alpha) pass through
+// unchanged.
+//
+// Empirically: with multiplier=1.0, the 8 basic-fill #069 rows + the 3
+// emoji rows all start flipping at --canvas-curve-noise = 0.01. So
+// multiplier = 0.01 / 0.003 ~= 3.333 maps the minimum 0.003 -> 0.01
+// (effective threshold, +/-1 LSB max shift) and 0.015 (max) -> 0.05
+// (+/-6 LSB max shift) - still within the natural cross-vendor band for
+// color emoji and non-black text.
+inline constexpr float kCurveNoiseTextColorMultiplier = 3.333f;
+
+// Returns a per-channel uint8 LUT color filter that perturbs RGB output
+// sub-LSB per --canvas-curve-noise. Returns nullptr when the switch is
+// inactive (call site can pass nullptr to setColorFilter safely).
+// Filter is built once and cached for the process lifetime - the switch
+// value is fixed at startup.
+MODULES_EXPORT sk_sp<cc::ColorFilter> MakeCanvasTextColorPerturbFilter();
+
+// True when --canvas-curve-noise is set to a non-zero scalar. Cheap - the
+// switch is parsed once and cached. Call this as a fast-path guard before
+// doing any work that would be wasted when noise is off.
+MODULES_EXPORT bool CanvasCurveNoiseActive();
+
+// Returns `coord` plus a deterministic perturbation bounded in amplitude by
+// (--canvas-curve-noise scalar) * extra_multiplier. Same (coord, axis_salt,
+// extra_multiplier) always yields the same result - per-machine calibration
+// depends on this reproducibility. When the switch is unset or 0, returns
+// `coord` unchanged. extra_multiplier defaults to 1.0 for bezier/quad strokes
+// which don't need amplification.
+MODULES_EXPORT float PerturbCurveCoord(float coord,
+                                       uint32_t axis_salt,
+                                       float extra_multiplier = 1.0f);
+
+// Returns a copy of `input` with Quad / Conic / Cubic verbs' control points
+// perturbed via PerturbCurveCoord. Move / Line / Close verbs pass through
+// unchanged. When --canvas-curve-noise is inactive, returns `input` unchanged
+// (no allocation, no walk).
+//
+// Pass is_fill=true for fill operations so cubic/quad verbs get amplified
+// perturbation (fills are interior-based and need a bigger offset to cross
+// pixel-center sample boundaries). Conic verbs always get the conic
+// multiplier (arcTo tangent self-correction) regardless of is_fill.
+MODULES_EXPORT SkPath PerturbSkPathCurves(const SkPath& input,
+                                          bool is_fill = false);
+
+// Canvas 2D Gaussian-blur sigma perturbation (--canvas-blur-noise).
+//
+// Covers shadowBlur (via ShadowBlurAsSigma) and ctx.filter = 'blur(...)'
+// (via BlurFilterOperation's stdDeviation). Applied at draw-time in the
+// CanvasRenderingContext2DState flag-build path, gated on the state's
+// backend_accelerated_ flag so CPU-backed (willReadFrequently) canvases
+// produce canonical output.
+//
+// Sigmas are scale parameters spanning orders of magnitude (0.5 for subtle
+// shadows, 50+ for heavy blurs). Perturbation is multiplicative - the sigma
+// is scaled by (1 + delta) where delta is in [-amplitude, +amplitude]. Keeps
+// the perturbation magnitude consistent relative to input at all scales.
+
+// True when --canvas-blur-noise is set to a non-zero scalar.
+MODULES_EXPORT bool CanvasBlurNoiseActive();
+
+// Returns `sigma` multiplied by a deterministic factor in
+// [1 - amplitude, 1 + amplitude] derived from (sigma, axis_salt). When the
+// switch is unset or sigma is zero, returns sigma unchanged.
+MODULES_EXPORT float PerturbBlurSigma(float sigma, uint32_t axis_salt);
+
+// Canvas 2D gradient stop-offset perturbation (--canvas-gradient-noise).
+//
+// Consumed by platform/graphics/gradient.cc via Gradient::SetStopPerturbation.
+// Canvas-side code reads the amplitude here and passes it to Gradient; the
+// platform Gradient class does the perturbation math itself (so platform
+// doesn't depend on this modules-layer header).
+
+// Returns the current --canvas-gradient-noise scalar (0 if unset).
+MODULES_EXPORT float GetCanvasGradientNoiseAmplitude();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_CANVAS_CURVE_NOISE_H_
