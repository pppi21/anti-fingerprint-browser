+#define COMPONENTS_BROWSER_PREF_NAMES_H_
+
+namespace browser::prefs {
+
+// Local State. The fingerprint seed chrome://browser-settings persists: "",
+// "auto" or a non-negative integer. ChromeMainDelegate turns it into
+// --fingerprint-seed at startup unless the switch is already present.
+inline constexpr char kFingerprintSeed[] = "browser.fingerprint_seed";
+
