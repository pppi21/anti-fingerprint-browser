diff --git a/components/browser/browser_runtime.cc b/components/browser/browser_runtime.cc
new file mode 100644
index 0000000000..50d180d6b0
--- /dev/null
+++ b/components/browser/browser_runtime.cc
@@ -0,0 +1,194 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/browser_runtime.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/function_ref.h"
+#include "base/no_destructor.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/version_info/version_info_values.h"
+#include "components/browser/browser_switches.h"
+#include "components/browser/fingerprint_pool.h"
+#include "components/browser/switch_resolver.h"
+#include "components/browser/webgpu_identity.h"
+
+namespace browser {
+
+namespace {
+
+// Explicit values of the string switches are taken verbatim.
+std::optional<std::string> Verbatim(const std::string& value) {
+  return value;
+}
+
+std::string ResolveStringSwitch(
+    const char* switch_name,
+    base::FunctionRef<std::string(int32_t seed)> derive_from_seed) {
+  return ResolveSwitch<std::string>(switch_name, Verbatim, derive_from_seed,
+                                    std::string())
+      .value;
+}
+
+// The WebGPU identity implied by the profile picked for `seed`, or nullopt
+// when the profile's renderer is not an ANGLE string with a known vendor.
+std::optional<WebgpuIdentity> WebgpuIdentityForSeed(int32_t seed) {
+  const FingerprintProfile* profile = ProfileForSeed(seed);
+  if (!profile) {
+    return std::nullopt;
+  }
+  return DeriveWebgpuFromRenderer(profile->gpu_renderer);
+}
+
+}  // namespace
+
+const std::string& SpoofedGpuRenderer() {
+  static const base::NoDestructor<std::string> value(
+      ResolveStringSwitch(switches::kFingerprintGpuRenderer, [](int32_t seed) {
+        const FingerprintProfile* profile = ProfileForSeed(seed);
+        return profile ? profile->gpu_renderer : std::string();
+      }));
+  return *value;
+}
+
+const std::string& SpoofedGpuVendor() {
+  static const base::NoDestructor<std::string> value(
+      ResolveStringSwitch(switches::kFingerprintGpuVendor, [](int32_t seed) {
+        const FingerprintProfile* profile = ProfileForSeed(seed);
+        return profile ? profile->gpu_vendor : std::string();
+      }));
+  return *value;
+}
+
+const std::string& SpoofedGpuVendorLower() {
+  static const base::NoDestructor<std::string> value(
+      base::ToLowerASCII(SpoofedGpuVendor()));
+  return *value;
+}
+
+int SpoofedMaxVertexUniformVectors() {
+  const std::string& vendor = SpoofedGpuVendorLower();
+  if (vendor.empty()) {
+    return 0;
+  }
+  return vendor.find("nvidia") != std::string::npos ? 4095 : 4096;
+}
+
+const std::string& SpoofedWebgpuVendor() {
+  static const base::NoDestructor<std::string> value(
+      ResolveStringSwitch(switches::kFingerprintWebgpuVendor, [](int32_t seed) {
+        const std::optional<WebgpuIdentity> id = WebgpuIdentityForSeed(seed);
+        return id ? id->vendor : std::string();
+      }));
+  return *value;
+}
+
+const std::string& SpoofedWebgpuArchitecture() {
+  static const base::NoDestructor<std::string> value(ResolveStringSwitch(
+      switches::kFingerprintWebgpuArchitecture, [](int32_t seed) {
+        const std::optional<WebgpuIdentity> id = WebgpuIdentityForSeed(seed);
+        return id ? id->architecture : std::string();
+      }));
+  return *value;
+}
+
+const std::string& SpoofedBrand() {
+  static const base::NoDestructor<std::string> value(
+      ResolveStringSwitch(switches::kFingerprintBrand,
+                          [](int32_t) { return std::string("Chrome"); }));
+  return *value;
+}
+
+const std::string& SpoofedBrandVersion() {
+  static const base::NoDestructor<std::string> value(
+      ResolveStringSwitch(switches::kFingerprintBrandVersion, [](int32_t) {
+        constexpr std::string_view kVersion = PRODUCT_VERSION;
+        return std::string(kVersion.substr(0, kVersion.find('.')));
+      }));
+  return *value;
+}
+
+const std::string& SpoofedBrandVersionLong() {
+  static const base::NoDestructor<std::string> value(ResolveStringSwitch(
+      switches::kFingerprintBrandVersionLong,
+      [](int32_t) { return std::string(PRODUCT_VERSION); }));
+  return *value;
+}
+
+bool BrandSpoofActive() {
+  static const bool active = !SpoofedBrand().empty() ||
+                             !SpoofedBrandVersion().empty() ||
+                             !SpoofedBrandVersionLong().empty();
+  return active;
+}
+
+void MaybeExpandBrowserDefaults() {
+  base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  // Child processes carry --type=<process type>; they receive features
+  // through FeatureList propagation rather than by re-expansion here.
+  if (cl->HasSwitch("type") || cl->HasSwitch(switches::kUseChromiumDefaults)) {
+    return;
+  }
+
+  // Presence-only switches. Only the ones the user has not set are added.
+  static constexpr const char* const kPresenceOnly[] = {
+      "no-first-run",
+      "no-default-browser-check",
+      "no-pings",
+      "disable-background-networking",
+      "disable-client-side-phishing-detection",
+      "disable-sync",
+      "disable-domain-reliability",
+      "disable-breakpad",
+      "disable-field-trial-config",
+      "metrics-recording-only",
+      "disable-default-apps",
+      "disable-prompt-on-repost",
+      "disable-search-engine-choice-screen",
+      "disable-password-generation",
+      "no-service-autorun",
+      "use-mock-keychain",
+      "hide-crash-restore-bubble",
+  };
+  for (const char* name : kPresenceOnly) {
+    if (!cl->HasSwitch(name)) {
+      cl->AppendSwitch(name);
+    }
+  }
+
+  // Value switches. An empty value disables the URL for the first two.
+  static constexpr std::pair<const char*, const char*> kKeyValue[] = {
+      {"connectivity-check-url", ""},
+      {"variations-server-url", ""},
+      {"password-store", "basic"},
+  };
+  for (const auto& [name, value] : kKeyValue) {
+    if (!cl->HasSwitch(name)) {
+      cl->AppendSwitchASCII(name, value);
+    }
+  }
+
+  // --disable-features is merged: AppendSwitchASCII replaces the value, so
+  // the existing list is read first. No --enable-features are bundled; MV2
+  // extension support comes from the ungoogled-chromium
+  // extensions-manifestv2 patch.
+  static constexpr std::string_view kBundledDisable =
+      "OptimizationHints,CertificateTransparencyComponentUpdater,"
+      "AutofillServerCommunication,SafeBrowsing,PasswordLeakDetection,"
+      "InterestFeedContentSuggestions,CrashReporting,"
+      "DestroyProfileOnBrowserClose,LensOverlay,ServiceWorkerPaymentApps";
+  const std::string existing = cl->GetSwitchValueASCII("disable-features");
+  cl->AppendSwitchASCII("disable-features",
+                        existing.empty()
+                            ? std::string(kBundledDisable)
+                            : base::StrCat({existing, ",", kBundledDisable}));
+}
+
+}  // namespace browser
