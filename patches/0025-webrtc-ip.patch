diff --git a/components/browser/webrtc_ip_spoofer.cc b/components/browser/webrtc_ip_spoofer.cc
new file mode 100644
index 0000000000..62b81f9c8a
--- /dev/null
+++ b/components/browser/webrtc_ip_spoofer.cc
@@ -0,0 +1,153 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/webrtc_ip_spoofer.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "components/browser/browser_switches.h"
+
+namespace browser {
+namespace {
+
+struct SpoofConfig {
+  std::string ipv4;
+  std::string ipv6;
+};
+
+const SpoofConfig& GetSpoofConfig() {
+  static const base::NoDestructor<SpoofConfig> config([] {
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    return SpoofConfig{command_line->GetSwitchValueASCII(switches::kWebrtcIP4),
+                       command_line->GetSwitchValueASCII(switches::kWebrtcIP6)};
+  }());
+  return *config;
+}
+
+// Reserved addresses keep their value, as does anything that is not an IP
+// literal (mDNS host candidates such as "<uuid>.local").
+bool IsExemptAddress(std::string_view ip) {
+  if (ip.empty()) {
+    return true;
+  }
+  for (char c : ip) {
+    if (!base::IsHexDigit(c) && c != '.' && c != ':') {
+      return true;
+    }
+  }
+  return ip == "0.0.0.0" || ip == "::" || ip == "127.0.0.1" || ip == "::1" ||
+         base::StartsWith(ip, "169.254.") ||
+         base::StartsWith(ip, "fe80", base::CompareCase::INSENSITIVE_ASCII);
+}
+
+// Offset of the space-separated token number |index| of |line|, if any.
+std::optional<size_t> TokenOffset(std::string_view line, size_t index) {
+  size_t offset = 0;
+  for (size_t i = 0; i < index; ++i) {
+    offset = line.find(' ', offset);
+    if (offset == std::string_view::npos) {
+      return std::nullopt;
+    }
+    ++offset;
+  }
+  if (offset >= line.size()) {
+    return std::nullopt;
+  }
+  return offset;
+}
+
+// Replaces the token starting at |offset| of |line| with its spoofed form.
+void SpoofTokenAt(std::string* line, size_t offset) {
+  size_t end = line->find(' ', offset);
+  if (end == std::string::npos) {
+    end = line->size();
+  }
+  const std::string replacement =
+      SpoofWebRtcIp(std::string_view(*line).substr(offset, end - offset));
+  line->replace(offset, end - offset, replacement);
+}
+
+// "c=IN IP4 <address>" carries the address in token 2; "o=<user> <id>
+// <version> IN IP4 <address>" in token 5.
+std::string SpoofSdpLine(std::string_view line) {
+  if (base::StartsWith(line, "a=candidate:")) {
+    return SpoofWebRtcCandidate(line);
+  }
+  std::string result(line);
+  std::optional<size_t> address;
+  if (base::StartsWith(line, "c=")) {
+    address = TokenOffset(result, 2);
+  } else if (base::StartsWith(line, "o=")) {
+    address = TokenOffset(result, 5);
+  }
+  if (address) {
+    SpoofTokenAt(&result, *address);
+  }
+  return result;
+}
+
+}  // namespace
+
+bool IsWebRtcIpSpoofActive() {
+  const SpoofConfig& config = GetSpoofConfig();
+  return !config.ipv4.empty() || !config.ipv6.empty();
+}
+
+std::string SpoofWebRtcIp(std::string_view ip) {
+  if (IsExemptAddress(ip)) {
+    return std::string(ip);
+  }
+  const bool is_ipv6 = ip.find(':') != std::string_view::npos;
+  const std::string& replacement =
+      is_ipv6 ? GetSpoofConfig().ipv6 : GetSpoofConfig().ipv4;
+  return replacement.empty() ? std::string(ip) : replacement;
+}
+
+// RFC 5245 candidate: "candidate:<foundation> <component> <transport>
+// <priority> <address> <port> typ <type> [raddr <address> rport <port>] ...".
+std::string SpoofWebRtcCandidate(std::string_view candidate) {
+  if (!IsWebRtcIpSpoofActive() || candidate.empty()) {
+    return std::string(candidate);
+  }
+  std::string result(candidate);
+  if (std::optional<size_t> address = TokenOffset(result, 4)) {
+    SpoofTokenAt(&result, *address);
+  }
+  static constexpr std::string_view kRelatedAddress = " raddr ";
+  const size_t related = result.find(kRelatedAddress);
+  if (related != std::string::npos) {
+    SpoofTokenAt(&result, related + kRelatedAddress.size());
+  }
+  return result;
+}
+
+std::string SpoofWebRtcSdp(std::string_view sdp) {
+  if (!IsWebRtcIpSpoofActive() || sdp.empty()) {
+    return std::string(sdp);
+  }
+  std::string result;
+  result.reserve(sdp.size());
+  size_t pos = 0;
+  while (pos < sdp.size()) {
+    const size_t newline = sdp.find('\n', pos);
+    const size_t next =
+        newline == std::string_view::npos ? sdp.size() : newline + 1;
+    size_t content_end = newline == std::string_view::npos ? sdp.size() : newline;
+    if (content_end > pos && sdp[content_end - 1] == '\r') {
+      --content_end;
+    }
+    result += SpoofSdpLine(sdp.substr(pos, content_end - pos));
+    result += sdp.substr(content_end, next - content_end);
+    pos = next;
+  }
+  return result;
+}
+
+}  // namespace browser
diff --git a/components/browser/webrtc_ip_spoofer.h b/components/browser/webrtc_ip_spoofer.h
