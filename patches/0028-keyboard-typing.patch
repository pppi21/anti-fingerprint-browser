+// browser: Input.dispatchKeystrokes.
+void InputHandler::DispatchKeystrokes(
+    const std::string& text,
+    std::optional<double> speed_multiplier,
+    std::optional<int> keystroke_delay_min,
+    std::optional<int> keystroke_delay_max,
+    std::optional<int> key_hold_min,
+    std::optional<int> key_hold_max,
+    std::optional<bool> context_aware,
+    std::optional<double> thinking_pause_probability,
+    std::optional<int> thinking_pause_min,
+    std::optional<int> thinking_pause_max,
+    std::optional<double> typo_probability,
+    std::optional<double> seed,
+    std::unique_ptr<DispatchKeystrokesCallback> callback) {
+  if (text.empty()) {
+    callback->sendSuccess();
+    return;
+  }
+  if (!host_ || !host_->GetRenderWidgetHost()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+
+  RenderWidgetHostImpl* widget_host = host_->GetRenderWidgetHost();
+  if (!host_->GetParent() && widget_host->delegate()) {
+    RenderWidgetHostImpl* target_host =
+        widget_host->delegate()->GetFocusedRenderWidgetHost(widget_host);
+    if (target_host) {
+      widget_host = target_host;
+    }
+  }
+
+  KeyboardTypingSession::Params params;
+  params.text = text;
+  if (speed_multiplier.has_value() && speed_multiplier.value() > 0.0) {
+    params.speed_multiplier = speed_multiplier.value();
+  }
+  if (keystroke_delay_min.has_value()) {
+    params.keystroke_delay_min_ms = std::max(1, keystroke_delay_min.value());
+  }
+  if (keystroke_delay_max.has_value()) {
+    params.keystroke_delay_max_ms = std::max(1, keystroke_delay_max.value());
+  }
+  if (params.keystroke_delay_max_ms < params.keystroke_delay_min_ms) {
+    params.keystroke_delay_max_ms = params.keystroke_delay_min_ms;
+  }
+  if (key_hold_min.has_value()) {
+    params.key_hold_min_ms = std::max(0, key_hold_min.value());
+  }
+  if (key_hold_max.has_value()) {
+    params.key_hold_max_ms = std::max(0, key_hold_max.value());
+  }
+  if (params.key_hold_max_ms < params.key_hold_min_ms) {
+    params.key_hold_max_ms = params.key_hold_min_ms;
+  }
+  if (context_aware.has_value()) {
+    params.context_aware = context_aware.value();
+  }
+  if (thinking_pause_probability.has_value()) {
+    params.thinking_pause_probability =
+        std::clamp(thinking_pause_probability.value(), 0.0, 1.0);
+  }
+  if (thinking_pause_min.has_value()) {
+    params.thinking_pause_min_ms = std::max(0, thinking_pause_min.value());
+  }
+  if (thinking_pause_max.has_value()) {
+    params.thinking_pause_max_ms = std::max(0, thinking_pause_max.value());
+  }
+  if (params.thinking_pause_max_ms < params.thinking_pause_min_ms) {
+    params.thinking_pause_max_ms = params.thinking_pause_min_ms;
+  }
+  if (typo_probability.has_value()) {
+    params.typo_probability = std::clamp(typo_probability.value(), 0.0, 1.0);
+  }
+  // The protocol number is a double; its 53-bit mantissa is plenty for an
+  // mt19937_64 seed. Without a seed, the microsecond clock makes each call's
+  // schedule distinct.
+  params.seed =
+      seed.has_value()
+          ? static_cast<uint64_t>(seed.value())
+          : static_cast<uint64_t>(
+                base::TimeTicks::Now().since_origin().InMicroseconds());
+
+  // A session already running on this handler is cancelled; its destructor
+  // fails that session's CDP callback.
+  active_typing_session_.reset();
+  active_typing_session_ = std::make_unique<KeyboardTypingSession>(
+      widget_host->GetWeakPtr(), std::move(params),
+      base::BindOnce(&InputHandler::OnKeystrokeSessionFinished,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+  active_typing_session_->Start();
+}
+
+void InputHandler::OnKeystrokeSessionFinished(
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    bool success) {
+  // active_typing_session_ is left alone: when a session finishes
+  // synchronously inside Start(), a re-entrant DispatchKeystrokes may already
+  // own a newer session, and resetting here would destroy it.
+  if (success) {
+    callback->sendSuccess();
+  } else {
+    callback->sendFailure(Response::ServerError("Typing session aborted"));
+  }
+}
