+// browser: window.screenX/screenY, resolved once per process from
+// --fingerprint-screen-position ("x,y", "auto" or "seed:<N>"); nullopt when
+// not spoofed. The derived position is that of a maximized window, x and y
+// in [0, 8].
+struct ScreenPosition {
+  int x = 0;
+  int y = 0;
+};
+
+const std::optional<ScreenPosition>& GetScreenPosition() {
+  static const std::optional<ScreenPosition> spoof =
+      browser::ResolveSwitch<std::optional<ScreenPosition>>(
+          ::switches::kFingerprintScreenPosition,
+          [](const std::string& value)
+              -> std::optional<std::optional<ScreenPosition>> {
+            std::vector<std::string> parts = base::SplitString(
+                value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+            ScreenPosition result;
+            if (parts.size() != 2 || !base::StringToInt(parts[0], &result.x) ||
+                !base::StringToInt(parts[1], &result.y)) {
+              return std::nullopt;
+            }
+            return result;
+          },
+          [](int32_t seed) -> std::optional<ScreenPosition> {
+            if (!browser::ProfileForSeed(seed)) {
+              return std::nullopt;
+            }
+            return ScreenPosition{static_cast<int>(browser::DeterministicBucket(
+                                      seed, browser::kSaltScreenPosX, 9)),
+                                  static_cast<int>(browser::DeterministicBucket(
+                                      seed, browser::kSaltScreenPosY, 9))};
+          },
+          std::nullopt,
+          /*inherit_from_master_seed=*/false)
+          .value;
+  return spoof;
+}
+
 }  // namespace
 
