@@ -0,0 +1,35 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BROWSER_CONNECTION_OVERRIDE_H_
+#define COMPONENTS_BROWSER_CONNECTION_OVERRIDE_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/component_export.h"
+
+namespace browser {
+
+// The network conditions reported to pages, shared by navigator.connection
+// in the renderer and by the Downlink, RTT and ECT client hints in the
+// browser so the two agree. Resolved once per process from
+// --fingerprint-connection ("effectiveType,downlink,rtt,saveData,type",
+// e.g. "4g,10,50,false,wifi"; "auto", "seed:<N>" or inherited from
+// --fingerprint-seed; see switch_resolver.h). `active` is false when nothing
+// is spoofed and callers keep the stock NetworkQualityEstimator path.
+struct ConnectionOverride {
+  bool active = false;
+  std::string effective_type;  // "slow-2g", "2g", "3g" or "4g"
+  double downlink_mbps = 0.0;
+  uint32_t rtt_ms = 0;
+  bool save_data = false;
+  std::string connection_type;  // "wifi", "ethernet", "cellular", ...
+};
+
+COMPONENT_EXPORT(BROWSER) const ConnectionOverride& GetConnectionOverride();
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_CONNECTION_OVERRIDE_H_
