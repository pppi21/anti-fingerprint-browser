diff --git a/components/browser/switch_resolver.cc b/components/browser/switch_resolver.cc
new file mode 100644
index 0000000000..87386d0e39
--- /dev/null
+++ b/components/browser/switch_resolver.cc
@@ -0,0 +1,135 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/switch_resolver.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/browser/browser_switches.h"
+
+namespace browser {
+
+namespace {
+
+constexpr std::string_view kAutoLiteral = "auto";
+constexpr std::string_view kSeedPrefix = "seed:";
+
+// What --fingerprint-seed said on the command line. Trivially destructible,
+// so it lives in a plain function-local static rather than
+// base::NoDestructor.
+struct MasterSeedSwitch {
+  bool requested = false;
+  std::optional<int32_t> explicit_seed;
+};
+
+const MasterSeedSwitch& GetMasterSeedSwitch() {
+  static const MasterSeedSwitch state = []() {
+    MasterSeedSwitch s;
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    if (!cl->HasSwitch(switches::kFingerprintSeed)) {
+      return s;
+    }
+    s.requested = true;
+    const std::string value =
+        cl->GetSwitchValueASCII(switches::kFingerprintSeed);
+    int parsed = 0;
+    if (value != kAutoLiteral && base::StringToInt(value, &parsed)) {
+      s.explicit_seed = parsed;
+    }
+    // "auto" and unparseable values leave explicit_seed empty; MasterSeed()
+    // then allocates a random seed. The switch still counts as requested,
+    // so per-switch resolvers derive on absence.
+    return s;
+  }();
+  return state;
+}
+
+}  // namespace
+
+uint32_t DeterministicBucket(int32_t seed, int32_t salt, uint32_t range) {
+  constexpr int64_t kKnuth = 2654435761LL;
+  const int64_t masked =
+      (static_cast<int64_t>(seed) * kKnuth + static_cast<int64_t>(salt)) &
+      0x7FFFFFFFLL;
+  return static_cast<uint32_t>(masked) % range;
+}
+
+float ResolveLinearNoiseSwitch(const char* switch_name,
+                               int32_t salt,
+                               double lo,
+                               double hi) {
+  return ResolveSwitch<float>(
+             switch_name,
+             [](const std::string& value) -> std::optional<float> {
+               double parsed = 0.0;
+               if (!base::StringToDouble(value, &parsed)) {
+                 return std::nullopt;
+               }
+               return static_cast<float>(parsed);
+             },
+             [salt, lo, hi](int32_t seed) -> float {
+               const uint32_t step = DeterministicBucket(seed, salt, 201);
+               return static_cast<float>(lo + step * (hi - lo) / 200.0);
+             },
+             /*fallback_when_absent=*/0.0f)
+      .value;
+}
+
+bool MasterSeedRequested() {
+  return GetMasterSeedSwitch().requested;
+}
+
+int32_t MasterSeed() {
+  // Thread-safe local-static initialization: base::RandUint64() runs at
+  // most once per process.
+  static const int32_t seed = []() {
+    const MasterSeedSwitch& s = GetMasterSeedSwitch();
+    if (s.explicit_seed.has_value()) {
+      return *s.explicit_seed;
+    }
+    // Masked to 31 bits so a random seed sits in the same non-negative
+    // range the launcher generates. Negative explicit seeds still work,
+    // since DeterministicBucket promotes to int64.
+    return static_cast<int32_t>(base::RandUint64() & 0x7FFFFFFFu);
+  }();
+  return seed;
+}
+
+namespace internal {
+
+RawSwitch ParseRawSwitch(const char* switch_name) {
+  RawSwitch out;
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (!cl->HasSwitch(switch_name)) {
+    return out;
+  }
+  std::string raw = cl->GetSwitchValueASCII(switch_name);
+  if (raw == kAutoLiteral) {
+    out.mode = RawMode::kAuto;
+    return out;
+  }
+  int parsed = 0;
+  if (base::StartsWith(raw, kSeedPrefix) &&
+      base::StringToInt(std::string_view(raw).substr(kSeedPrefix.size()),
+                        &parsed)) {
+    out.mode = RawMode::kSeed;
+    out.seed = parsed;
+    return out;
+  }
+  // Anything else, including a "seed:" prefix with an unparseable suffix,
+  // is handed to the caller's explicit parser.
+  out.mode = RawMode::kExplicit;
+  out.explicit_value = std::move(raw);
+  return out;
+}
+
+}  // namespace internal
+
+}  // namespace browser
diff --git a/components/browser/switch_resolver.h b/components/browser/switch_resolver.h
new file mode 100644
index 0000000000..1d21233df0
--- /dev/null
+++ b/components/browser/switch_resolver.h
@@ -0,0 +1,169 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Lets every fingerprint switch accept three input forms, an explicit value,
+// "auto" or "seed:<N>", without changing the explicit-value parse path.
+//
+// ResolveSwitch<T>() walks this hierarchy:
+//
+//   1. Explicit value (anything but "auto" / "seed:<N>"): parse_explicit()
+//      runs. A value that fails to parse counts as absent rather than
+//      falling through to derivation, so a typo never silently becomes a
+//      different spoofed value.
+//   2. "auto": derive_from_seed(MasterSeed()). Allocates the random master
+//      seed if --fingerprint-seed is absent.
+//   3. "seed:<N>": derive_from_seed(N).
+//   4. Absent with --fingerprint-seed set: derive_from_seed(MasterSeed()),
+//      unless inherit_from_master_seed is false. That opt-out is for
+//      surfaces that should not activate merely because a master seed
+//      exists (history length, media counts, screen, screen position, media
+//      features); they then behave like (5).
+//   5. Absent with --fingerprint-seed absent: fallback_when_absent, with no
+//      derivation and no RNG allocation. Stock behaviour for users who set
+//      no fingerprint switch at all.
+
+#ifndef COMPONENTS_BROWSER_SWITCH_RESOLVER_H_
+#define COMPONENTS_BROWSER_SWITCH_RESOLVER_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/component_export.h"
+#include "base/functional/function_ref.h"
+#include "base/notreached.h"
+
+namespace browser {
+
+// Salts for the deterministic per-surface derivations. Values below 79 are
+// shared with the launcher, which derives some surfaces itself, so a given
+// seed produces the same result on both sides; 41 (text rendering) and 61
+// are reserved there. Values from 79 on are browser-only.
+inline constexpr int32_t kSaltCanvasCurve = 47;
+inline constexpr int32_t kSaltCanvasBlur = 59;
+inline constexpr int32_t kSaltCanvasGradient = 67;
+inline constexpr int32_t kSaltFontBundle = 71;
+inline constexpr int32_t kSaltWebglShaderNoise = 73;
+inline constexpr int32_t kSaltHistoryLength = 79;
+inline constexpr int32_t kSaltMediaMics = 83;
+inline constexpr int32_t kSaltMediaWebcams = 89;
+inline constexpr int32_t kSaltMediaSpeakers = 97;
+// Picks a coherent profile from the embedded pool (fingerprint_pool.h).
+inline constexpr int32_t kSaltProfilePick = 101;
+// Window position on the screen.
+inline constexpr int32_t kSaltScreenPosX = 103;
+inline constexpr int32_t kSaltScreenPosY = 107;
+// Battery, only used when the profile's device type is "laptop".
+inline constexpr int32_t kSaltBatteryCharging = 109;
+inline constexpr int32_t kSaltBatteryLevel = 113;
+inline constexpr int32_t kSaltBatteryTime = 127;
+// Network conditions.
+inline constexpr int32_t kSaltConnectionType = 131;
+inline constexpr int32_t kSaltConnectionDownlink = 137;
+inline constexpr int32_t kSaltConnectionRtt = 139;
+
+// Returns a deterministic bucket in [0, range) by mixing `seed` and `salt`
+// with Knuth's multiplicative hash, `(seed * 2654435761 + salt) & 0x7FFFFFFF`
+// in 64-bit arithmetic, taken modulo `range`. The launcher reproduces it
+// bit for bit. `range` must be > 0.
+COMPONENT_EXPORT(BROWSER)
+uint32_t DeterministicBucket(int32_t seed, int32_t salt, uint32_t range);
+
+// Resolves a float noise-amplitude switch. An explicit value is parsed as a
+// decimal number; "auto", "seed:<N>" and an inherited master seed derive a
+// value in [lo, hi] in 201 linear steps from (seed, salt); an absent switch
+// resolves to 0 (noise off).
+COMPONENT_EXPORT(BROWSER)
+float ResolveLinearNoiseSwitch(const char* switch_name,
+                               int32_t salt,
+                               double lo,
+                               double hi);
+
+// True iff --fingerprint-seed is on the command line at all, as "auto" or
+// as an integer. Per-switch resolvers branch on this when their own switch
+// is absent: it is the opt-in that lets them derive without changing stock
+// behaviour for users who set neither switch.
+COMPONENT_EXPORT(BROWSER) bool MasterSeedRequested();
+
+// Returns the master seed:
+//   --fingerprint-seed=<int>  -> that integer;
+//   --fingerprint-seed=auto   -> a random seed allocated on the first call
+//                                and cached for the process lifetime;
+//   absent or unparseable     -> the same lazy random allocation.
+// Gate on MasterSeedRequested() first unless a random seed is acceptable.
+COMPONENT_EXPORT(BROWSER) int32_t MasterSeed();
+
+// Where a resolved value came from.
+enum class SwitchSource {
+  // Switch absent and --fingerprint-seed absent; `value` is the fallback.
+  kAbsent,
+  // Switch had an explicit value that parsed successfully.
+  kExplicit,
+  // Switch was "auto", or absent with --fingerprint-seed set.
+  kAuto,
+  // Switch was "seed:<N>".
+  kSeedOverride,
+};
+
+template <typename T>
+struct ResolvedSwitch {
+  SwitchSource source;
+  T value;
+};
+
+namespace internal {
+
+// Classification of a single switch's raw command-line value.
+enum class RawMode {
+  kAbsent,
+  kAuto,
+  kSeed,      // "seed:<N>" with N parseable as int32
+  kExplicit,  // anything else
+};
+
+struct RawSwitch {
+  RawMode mode = RawMode::kAbsent;
+  std::string explicit_value;  // populated for kExplicit
+  int32_t seed = 0;            // populated for kSeed
+};
+
+COMPONENT_EXPORT(BROWSER) RawSwitch ParseRawSwitch(const char* switch_name);
+
+}  // namespace internal
+
+template <typename T>
+ResolvedSwitch<T> ResolveSwitch(
+    const char* switch_name,
+    base::FunctionRef<std::optional<T>(const std::string&)> parse_explicit,
+    base::FunctionRef<T(int32_t seed)> derive_from_seed,
+    T fallback_when_absent,
+    bool inherit_from_master_seed = true) {
+  const internal::RawSwitch raw = internal::ParseRawSwitch(switch_name);
+  switch (raw.mode) {
+    case internal::RawMode::kExplicit: {
+      std::optional<T> parsed = parse_explicit(raw.explicit_value);
+      if (parsed.has_value()) {
+        return {SwitchSource::kExplicit, std::move(*parsed)};
+      }
+      return {SwitchSource::kAbsent, std::move(fallback_when_absent)};
+    }
+    case internal::RawMode::kSeed:
+      return {SwitchSource::kSeedOverride, derive_from_seed(raw.seed)};
+    case internal::RawMode::kAuto:
+      // An explicit "auto" always derives: the user opted in for this
+      // surface specifically, whatever inherit_from_master_seed says.
+      return {SwitchSource::kAuto, derive_from_seed(MasterSeed())};
+    case internal::RawMode::kAbsent:
+      if (!inherit_from_master_seed || !MasterSeedRequested()) {
+        return {SwitchSource::kAbsent, std::move(fallback_when_absent)};
+      }
+      return {SwitchSource::kAuto, derive_from_seed(MasterSeed())};
+  }
+  NOTREACHED();
+}
+
+}  // namespace browser
+
+#endif  // COMPONENTS_BROWSER_SWITCH_RESOLVER_H_
