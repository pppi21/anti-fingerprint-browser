   DCHECK(headers);
+
+  // browser: see AddRttHeader.
+  if (const browser::ConnectionOverride& spoof =
+          browser::GetConnectionOverride();
+      spoof.active) {
+    SetHeaderToDouble(headers, WebClientHintsType::kDownlink_DEPRECATED,
+                      spoof.downlink_mbps);
+    return;
+  }
+
